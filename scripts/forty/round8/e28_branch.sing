ring r=0,(a1,a2,b1,b2,q),dp;
poly e5=-a1^8*a2^6*b1^6*b2^8 + 2*a1^7*a2^7*b1^7*b2^7 - a1^6*a2^8*b1^8*b2^6 + 4*a1^6*a2^6*q^10 - 8*a1^5*a2^4*b1*b2^2*q^8 - 8*a1^4*a2^5*b1^2*b2*q^8 + 4*a1^4*a2^2*b1^2*b2^4*q^6 + 4*a1^2*a2^4*b1^4*b2^2*q^6 - 8*a1^2*a2*b1^4*b2^5*q^4 - 8*a1*a2^2*b1^5*b2^4*q^4 + 4*b1^6*b2^6*q^2;
poly e6=a1^4*a2^6*b2^4*q^4 - 4*a1^4*a2^2*q^7 - 2*a1^3*a2^7*b1*b2^3*q^4 - 2*a1^3*a2^4*b1*b2^6*q^2 + a1^2*a2^8*b1^2*b2^2*q^4 + a1^2*a2^2*b1^2*b2^8 + 8*a1^2*a2*b1^2*b2*q^5 - 2*a1*a2^6*b1^3*b2^4*q^2 - 2*a1*a2^3*b1^3*b2^7 + a2^4*b1^4*b2^6 - 4*b1^4*b2^2*q^3;
poly e6m=a1^8*a2^2*b1^2*b2^2*q^4 - 2*a1^7*a2^3*b1^3*b2*q^4 + a1^6*a2^4*b1^4*q^4 - 2*a1^6*a2*b1^4*b2^3*q^2 - 2*a1^4*a2^3*b1^6*b2*q^2 + a1^4*b1^6*b2^4 - 2*a1^3*a2*b1^7*b2^3 + 4*a1^2*a2^4*q^7 + a1^2*a2^2*b1^8*b2^2 - 8*a1*a2^2*b1*b2^2*q^5 + 4*b1^2*b2^4*q^3;
poly e7=a1^12*a2^6*q^12 - 6*a1^10*a2^5*b1^2*b2*q^10 - 5*a1^8*a2^8*b1^4*b2^6*q^5 + 15*a1^8*a2^4*b1^4*b2^2*q^8 - a1^6*a2^11*b1^6*b2^11 + 6*a1^6*a2^7*b1^6*b2^7*q^3 - 20*a1^6*a2^3*b1^6*b2^3*q^6 - 5*a1^4*a2^6*b1^8*b2^8*q + 15*a1^4*a2^2*b1^8*b2^4*q^4 - 6*a1^2*a2*b1^10*b2^5*q^2 + b1^12*b2^6;
poly e8=a1^16*a2^8*q^16 - 8*a1^14*a2^7*b1^2*b2*q^14 - a1^12*a2^10*b1^4*b2^6*q^9 + 28*a1^12*a2^6*b1^4*b2^2*q^12 + 4*a1^10*a2^9*b1^6*b2^7*q^7 - 56*a1^10*a2^5*b1^6*b2^3*q^10 - a1^8*a2^15*b1^8*b2^9*q^4 - 2*a1^8*a2^12*b1^8*b2^12*q^2 - a1^8*a2^9*b1^8*b2^15 - 6*a1^8*a2^8*b1^8*b2^8*q^5 + 70*a1^8*a2^4*b1^8*b2^4*q^8 + 4*a1^6*a2^7*b1^10*b2^9*q^3 - 56*a1^6*a2^3*b1^10*b2^5*q^6 - a1^4*a2^6*b1^12*b2^10*q + 28*a1^4*a2^2*b1^12*b2^6*q^4 - 8*a1^2*a2*b1^14*b2^7*q^2 + b1^16*b2^8;
poly e40=a1^10*a2^6*b1^6*b2^10 - 4*a1^9*a2^7*b1^7*b2^9 + 6*a1^8*a2^8*b1^8*b2^8 - 4*a1^8*a2^6*b2^2*q^12 - 4*a1^7*a2^9*b1^9*b2^7 - 8*a1^7*a2^7*b1*b2*q^12 + 8*a1^7*a2^4*b1*b2^4*q^10 + a1^6*a2^10*b1^10*b2^6 - 4*a1^6*a2^8*b1^2*q^12 + 24*a1^6*a2^5*b1^2*b2^3*q^10 - 4*a1^6*a2^2*b1^2*b2^6*q^8 + 24*a1^5*a2^6*b1^3*b2^2*q^10 - 24*a1^5*a2^3*b1^3*b2^5*q^8 + 8*a1^4*a2^7*b1^4*b2*q^10 - 40*a1^4*a2^4*b1^4*b2^4*q^8 - 32*a1^4*a2^4*b1^4*b2^4*q^6 + 8*a1^4*a2*b1^4*b2^7*q^6 - 24*a1^3*a2^5*b1^5*b2^3*q^8 + 24*a1^3*a2^2*b1^5*b2^6*q^6 - 4*a1^2*a2^6*b1^6*b2^2*q^8 + 24*a1^2*a2^3*b1^6*b2^5*q^6 - 4*a1^2*b1^6*b2^8*q^4 + 8*a1*a2^4*b1^7*b2^4*q^6 - 8*a1*a2*b1^7*b2^7*q^4 - 4*a2^2*b1^8*b2^6*q^4;
poly e40p=a1^10*a2^6*b1^6*b2^10 - 4*a1^9*a2^7*b1^7*b2^9 + 6*a1^8*a2^8*b1^8*b2^8 - 4*a1^8*a2^6*b2^2*q^12 - 4*a1^7*a2^9*b1^9*b2^7 - 8*a1^7*a2^7*b1*b2*q^12 + 8*a1^7*a2^4*b1*b2^4*q^10 + a1^6*a2^10*b1^10*b2^6 - 4*a1^6*a2^8*b1^2*q^12 + 24*a1^6*a2^5*b1^2*b2^3*q^10 - 4*a1^6*a2^2*b1^2*b2^6*q^8 + 24*a1^5*a2^6*b1^3*b2^2*q^10 - 24*a1^5*a2^3*b1^3*b2^5*q^8 + 8*a1^4*a2^7*b1^4*b2*q^10 - 40*a1^4*a2^4*b1^4*b2^4*q^8 + 32*a1^4*a2^4*b1^4*b2^4*q^6 + 8*a1^4*a2*b1^4*b2^7*q^6 - 24*a1^3*a2^5*b1^5*b2^3*q^8 + 24*a1^3*a2^2*b1^5*b2^6*q^6 - 4*a1^2*a2^6*b1^6*b2^2*q^8 + 24*a1^2*a2^3*b1^6*b2^5*q^6 - 4*a1^2*b1^6*b2^8*q^4 + 8*a1*a2^4*b1^7*b2^4*q^6 - 8*a1*a2*b1^7*b2^7*q^4 - 4*a2^2*b1^8*b2^6*q^4;
option(redSB);
ideal I=e5,e6,e6m;
ideal Is=std(I);
"prod in I:"; reduce(e40*e40p,Is)==0;
ideal J=std(I+ideal(e40));
"e7 in I+e40:"; reduce(e7,J)==0;
"e8 in I+e40:"; reduce(e8,J)==0;
poly m=a1*a2*b1*b2*q;
"e7 m:"; reduce(e7*m^4,J)==0;
"e8 m:"; reduce(e8*m^4,J)==0;
quit;

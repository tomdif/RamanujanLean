-- negative controls: the certificate is false for a wrong sign and for non-hit primes
example : allOk 17 262140 1336000 8 4 21 5 18 44 1 [(23, 1)] = false := by decide +kernel
example : allOk 17 262140 1336000 8 4 21 5 18 44 1 [(43, 0)] = false := by decide +kernel
example : allOk 29 262131 300000 8 2 19 5 18 42 2 [(17, 1)] = false := by decide +kernel
example : allOk 31 262136 300000 8 2 19 5 18 42 2 [(43, 0)] = false := by decide +kernel
-- the same parameters with the correct sign pass (so the failures above are not prefix failures)
example : allOk 17 262140 1336000 8 4 21 5 18 44 1 [(23, -1)] = true := by decide +kernel
example : allOk 29 262131 300000 8 2 19 5 18 42 2 [(17, -1)] = true := by decide +kernel

0^4*c2^4*c4 + 55*Qv^2*c0^4*c2^3*c4^4 - 110*Qv^2*c0^3*c1^5*c7 + 88*Qv^2*c0^3*c1^4*c2^2*c7^2 - 374*Qv^2*c0^3*c1^4*c2*c4*c7 + 209*Qv^2*c0^3*c1^4*c4^2 + 231*Qv^2*c0^3*c1^3*c2^2*c4^2*c7 - 44*Qv^2*c0^3*c1^3*c2^2 + 33*Qv^2*c0^3*c1^3*c2*c4^3 - 66*Qv^2*c0^3*c1^2*c2^4*c7 - 11*Qv^2*c0^3*c1^2*c2^3*c4 - 33*Qv^2*c0^3*c1^2*c2^2*c4^4 + 143*Qv^2*c0^3*c1*c2^5*c4*c7 + 176*Qv^2*c0^3*c1*c2^4*c4^2 + 22*Qv^2*c0^3*c2^6 - 77*Qv^2*c0^3*c2^5*c4^3 - 55*Qv^2*c0^2*c1^6*c2*c7^2 + 132*Qv^2*c0^2*c1^6*c4*c7 + 33*Qv^2*c0^2*c1^5*c2*c4^2*c7 + 11*Qv^2*c0^2*c1^5*c2 - 110*Qv^2*c0^2*c1^5*c4^3 + 176*Qv^2*c0^2*c1^4*c2^3*c7 + 22*Qv^2*c0^2*c1^4*c2^2*c4 + 44*Qv^2*c0^2*c1^4*c2*c4^4 - 187*Qv^2*c0^2*c1^3*c2^4*c4*c7 - 132*Qv^2*c0^2*c1^3*c2^3*c4^2 + 77*Qv^2*c0^2*c1^2*c2^5 + 88*Qv^2*c0^2*c1^2*c2^4*c4^3 - 33*Qv^2*c0^2*c1*c2^7*c7 - 110*Qv^2*c0^2*c1*c2^6*c4 + 44*Qv^2*c0^2*c2^7*c4^2 + 11*Qv^2*c0*c1^8*c7^2 - 33*Qv^2*c0*c1^7*c4^2*c7 - 11*Qv^2*c0*c1^7 - 110*Qv^2*c0*c1^6*c2^2*c7 + 11*Qv^2*c0*c1^6*c2*c4 + 11*Qv^2*c0*c1^6*c4^4 + 143*Qv^2*c0*c1^5*c2^3*c4*c7 + 33*Qv^2*c0*c1^5*c2^2*c4^2 - 77*Qv^2*c0*c1^4*c2^4 - 22*Qv^2*c0*c1^4*c2^3*c4^3 + 44*Qv^2*c0*c1^3*c2^6*c7 + 143*Qv^2*c0*c1^3*c2^5*c4 - 55*Qv^2*c0*c1^2*c2^6*c4^2 + 22*Qv^2*c0*c1*c2^8 - 11*Qv^2*c0*c2^9*c4 + 22*Qv^2*c1^8*c2*c7 + 11*Qv^2*c1^8*c4 - 33*Qv^2*c1^7*c2^2*c4*c7 - 33*Qv^2*c1^7*c2*c4^2 + 22*Qv^2*c1^6*c2^3 + 22*Qv^2*c1^6*c2^2*c4^3 - 11*Qv^2*c1^5*c2^5*c7 - 55*Qv^2*c1^5*c2^4*c4 + 33*Qv^2*c1^4*c2^5*c4^2 - 11*Qv^2*c1^3*c2^7 + 11*Qv^2*c1^2*c2^8*c4 + Qv^2*c2^11 - 11*Qv*c0^9*c4*c7 + 11*Qv*c0^8*c1 + 11*Qv*c0^8*c2^2*c7 + 22*Qv*c0^8*c2*c4 - 33*Qv*c0^7*c1^2*c2*c7 - 33*Qv*c0^7*c1^2*c4 - 33*Qv*c0^7*c1*c2*c4^2 - 11*Qv*c0^7*c2^3 + 11*Qv*c0^6*c1^4*c7 + 22*Qv*c0^6*c1^3*c4^2 + 66*Qv*c0^6*c1^2*c2^2 + 44*Qv*c0^6*c1*c2^3*c4 - 55*Qv*c0^5*c1^4*c2 - 110*Qv*c0^5*c1^3*c2^2*c4 - 11*Qv*c0^5*c1*c2^5 + 11*Qv*c0^4*c1^6 + 66*Qv*c0^4*c1^5*c2*c4 + 55*Qv*c0^4*c1^3*c2^4 - 11*Qv*c0^3*c1^7*c4 - 77*Qv*c0^3*c1^5*c2^3 + 44*Qv*c0^2*c1^7*c2^2 - 11*Qv*c0*c1^9*c2 + Qv*c1^11 + c0^11;
poly GN=c0^2*c1*c2*c4^3*c7^4 + c0^2*c2^3*c4*c7^4 - c0^2*c2*c4^3*c7^2;
poly GD=c0^2*c1^2*c4^2*c7^4 - 6*c0^2*c1*c2*c4^3*c7^4 - 6*c0^2*c2^3*c4*c7^4 + c0^2*c2^2*c4^4*c7^4 + c0^2*c2^2*c7^2 + 6*c0^2*c2*c4^3*c7^2 + c0^2*c4^2 + c1^2*c2^2*c4^2*c7^2;

poly P5=Qv^5;
poly G3=GD^3*F11; // common factor
// using (1+g2) g3 = g2^2+11z, (1+g2) g4 = g2^3 - 11z, z F11 = P5, e_k z F11 = F_k
poly a3=GN^2*GD*F11+11*P5*GD^3;   // GD^3 F11 (g2^2+11z)
poly a4=GN^3*F11-11*P5*GD^3;      // GD^3 F11 (g2^3-11z)
poly a2=GN*GD*(GD+GN)*F11;      // GD^3 F11 (1+g2) g2
poly cz=(GD+GN)*GD^2;             // GD^3 F11 (1+g2) z / P5 ... (times P5 or F_k)
poly M6=22*a4-cz*(1331*P5+F5);
poly M4=22*a3+1452*a4+cz*(14641*P5-F7);
poly M3=242*a3+5324*a4+cz*(73205*P5-F8);
poly M2=-11*a2+968*a3+11979*a4+cz*(161051*P5-F9);
poly M1=121*a2+2662*a3+14641*a4+cz*(161051*P5-F10);
poly QU=GN^5*F11^2 - P5*F11*(GD^5+13*GN*GD^4+34*GN^2*GD^3) - 121*P5^2*GD^5;
list T=M6,M4,M3,M2,M1,QU; list nm="M6","M4","M3","M2","M1","QU";
ideal G=GW;
"GB size"; size(G);
matrix LG=lift(W,G); int tg=0; int ii; int jj;
for(ii=1;ii<=nrows(LG);ii++){for(jj=1;jj<=ncols(LG);jj++){ tg=tg+size(LG[ii,jj]); }}
"GB-in-W cofactor terms "+string(tg);
int i;
for(i=1;i<=6;i++){
  matrix L=lift(G,T[i]); int tot=0; int j;
  for(j=1;j<=nrows(L);j++){ tot=tot+size(L[j,1]); }
  string(nm[i])+": target "+string(size(T[i]))+" GB-cofactor terms "+string(tot);
  kill L; kill tot; kill j;
}
quit;

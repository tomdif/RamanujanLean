CH=CH+(-1)^11*E11*q^(5*11)*Psi^(11-11);
poly D=q^11-Qv;
list dv=division(CH,D);
"remainder zero:"; dv[2][1]==0;
poly H=dv[1][1,1];
"CH terms "+string(size(CH))+" H terms "+string(size(H));

proc dumpP(poly p, string fn){
  link l=":w "+fn; poly r=p; string s="";
  int cnt=0;
  while(r!=0){
    intvec e=leadexp(r); number c=leadcoef(r);
    s=s+string(e[1])+" "+string(e[2])+" "+string(e[3])+" "+string(e[4])+" "+string(e[5])+" "+string(e[6])+" "+string(c)+newline;
    cnt++; if(cnt mod 2000==0){ write(l,s); s=""; }
    r=r-lead(r);
  }
  write(l,s); close(l);
}
dumpP(CH,"certs/CH_T.txt"); dumpP(H,"certs/CH_H.txt"); dumpP(Psi,"certs/CH_Psi.txt");
int jj; for(jj=1;jj<=11;jj++){ dumpP(`"E"+string(jj)`,"certs/CH_E"+string(jj)+".txt"); }
quit;

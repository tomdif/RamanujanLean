proc dumpP(poly p, string fn){
  link l=":w "+fn; poly r=p; string s="";
  int cnt=0;
  while(r!=0){
    intvec e=leadexp(r); number c=leadcoef(r);
    s=s+string(e[1])+" "+string(e[2])+" "+string(e[3])+" "+string(e[4])+" "+string(e[5])+" "+string(c)+newline;
    cnt++;
    if(cnt mod 2000==0){ write(l,s); s=""; }
    r=r-lead(r);
  }
  write(l,s); close(l);
}
proc mcontent(poly p){
  intvec m=leadexp(p); poly r=p; int i;
  while(r!=0){ intvec e=leadexp(r); for(i=1;i<=5;i++){ if(e[i]<m[i]){m[i]=e[i];} } r=r-lead(r); }
  return(monomial(m));
}
dumpP(GN,"certs/P_GN.txt"); dumpP(GD,"certs/P_GD.txt");
dumpP(F3,"certs/P_F3.txt"); dumpP(F4,"certs/P_F4.txt"); dumpP(F5,"certs/P_F5.txt"); dumpP(F6,"certs/P_F6.txt");
dumpP(F7,"certs/P_F7.txt"); dumpP(F8,"certs/P_F8.txt"); dumpP(F9,"certs/P_F9.txt"); dumpP(F10,"certs/P_F10.txt");
dumpP(F11,"certs/P_F11.txt");
quit;

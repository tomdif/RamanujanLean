LIB "elim.lib";
ring r=0,(Q,t1,t2,t3,t4,t5),dp;
option(redSB);
ideal W=Q^2*t1^2*t2*t3 + t2*t4*t5^2 - t3^2*t4*t5,
Q^3*t1^3*t2 + t3*t5^3 - t4^3*t5,
Q*t1^2*t2*t5 + t1*t3*t4^2 - t2^2*t3*t5,
Q^2*t1^3*t4 + t2*t4^3 - t3^3*t5,
Q*t2^3*t3 + t1*t5^3 - t3^3*t4,
Q*t1*t2*t3^2 + t1*t4*t5^2 - t2*t3*t4^2,
Q*t1*t2^2*t4 + t1*t4^2*t5 - t2*t3^2*t5,
Q*t1^2*t3*t4 + t1*t3*t5^2 - t2^2*t4*t5,
Q^2*t1*t2^3 + t2*t5^3 - t3*t4^3,
Q*t1^3*t5 + t1*t3^3 - t2^3*t4;
ideal G=std(W);
ideal S=sat(W,t1*t2*t3*t4*t5);
S=std(S);
poly I3=33*Q^6*t1^8*t2^4*t3^6*t4^2 - 55*Q^5*t1^7*t2^5*t3^3*t4^4*t5 - 220*Q^4*t1^7*t2^3*t3^3*t4^5*t5^2 - 11*Q^4*t1^7*t2^2*t3^5*t4^5*t5 - 2772*Q^4*t1^6*t2^4*t3^5*t4^3*t5^2 + 110*Q^4*t1^5*t2^6*t3^4*t4^4*t5 - 11*Q^4*t1^5*t2^5*t3^7*t4*t5^2 + 110*Q^3*t1^6*t2^4*t3*t4^4*t5^5 - 209*Q^3*t1^6*t2^3*t3^3*t4^4*t5^4 + 1848*Q^3*t1^5*t2^4*t3^5*t4^2*t5^4 - 1848*Q^3*t1^5*t2^4*t3^4*t4^5*t5^2 + 220*Q^3*t1^5*t2^3*t3^7*t4^2*t5^3 + 209*Q^3*t1^4*t2^6*t3^4*t4^3*t5^3 + 33*Q^2*t1^6*t3^4*t4^8*t5^2 + 55*Q^2*t1^5*t2^4*t3*t4^3*t5^7 + 2772*Q^2*t1^5*t2^2*t3^4*t4^6*t5^3 + 1848*Q^2*t1^4*t2^5*t3^2*t4^4*t5^5 - 110*Q^2*t1^4*t2^4*t3^5*t4*t5^6 - 16610*Q^2*t1^4*t2^4*t3^4*t4^4*t5^4 + 55*Q^2*t1^4*t2^3*t3^7*t4*t5^5 - 209*Q^2*t1^4*t2^3*t3^6*t4^4*t5^3 + 2772*Q^2*t1^3*t2^5*t3^6*t4^2*t5^4 - 220*Q^2*t1^2*t2^7*t3^5*t4^3*t5^3 + 33*Q^2*t1^2*t2^6*t3^8*t5^4 - 11*Q*t1^5*t2*t3^2*t4^7*t5^5 - 2772*Q*t1^4*t2^3*t3^2*t4^5*t5^6 - 1848*Q*t1^4*t2^2*t3^4*t4^5*t5^5 - 110*Q*t1^4*t2*t3^6*t4^5*t5^4 - 220*Q*t1^3*t2^5*t3^2*t4^3*t5^7 + 209*Q*t1^3*t2^4*t3^4*t4^3*t5^6 - 209*Q*t1^3*t2^4*t3^3*t4^6*t5^4 + 2772*Q*t1^2*t2^6*t3^3*t4^4*t5^5 + 1848*Q*t1^2*t2^5*t3^5*t4^4*t5^4 + 11*Q*t1*t2^7*t3^5*t4^2*t5^5 + 55*Q*t1*t2^7*t3^4*t4^5*t5^3 + 33*t1^4*t2^2*t4^6*t5^8 - 220*t1^3*t2^2*t3^3*t4^7*t5^5 + 55*t1^3*t2*t3^5*t4^7*t5^4 - 11*t1^2*t2^5*t3*t4^5*t5^7 + 110*t1*t2^5*t3^4*t4^6*t5^4 + 33*t2^8*t3^2*t4^4*t5^6;
"I3 in W:"; reduce(I3,G)==0;
"I3 in sat W:"; reduce(I3,S)==0;
poly e3=11*Q^3*t1^4*t2^2*t3^3*t4 - 11*Q*t1^3*t3^2*t4^4*t5 + 44*Q*t1^2*t2^2*t3^2*t4^2*t5^2 - 11*Q*t1*t2^3*t3^4*t5^2 + 11*t1^2*t2*t4^3*t5^4 - 11*t2^4*t3*t4^2*t5^3;
"e3 in W:"; reduce(e3,G)==0;
"e3 in sat W:"; reduce(e3,S)==0;
poly e4=88*Q^3*t1^4*t2^2*t3^3*t4 - 33*Q^2*t1^3*t2^2*t3^3*t5^2 + 33*Q^2*t1^3*t2^2*t3^2*t4^3 - 88*Q*t1^3*t3^2*t4^4*t5 - 33*Q*t1^2*t2^3*t4^2*t5^3 + 451*Q*t1^2*t2^2*t3^2*t4^2*t5^2 - 88*Q*t1*t2^3*t3^4*t5^2 + 88*t1^2*t2*t4^3*t5^4 + 33*t1^2*t3^2*t4^3*t5^3 - 88*t2^4*t3*t4^2*t5^3 - 33*t2^3*t3^3*t4^2*t5^2;
"e4 in W:"; reduce(e4,G)==0;
"e4 in sat W:"; reduce(e4,S)==0;
quit;

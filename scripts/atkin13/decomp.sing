LIB "elim.lib";
LIB "primdec.lib";
ring r=0,(J1,J2,J3,J4,J5,J6,Q,iQ),dp;
option(redSB);
ideal I=(-1)*Q^0*J2*J2*J2*J4+(1)*Q^0*J1*J3*J3*J3+(1)*Q^1*J1*J1*J1*J5,
(-1)*Q^0*J2*J2*J3*J5+(1)*Q^0*J1*J3*J4*J4+(1)*Q^1*J1*J1*J2*J6,
(-1)*Q^0*J2*J2*J4*J6+(1)*Q^0*J1*J3*J5*J5+(1)*Q^1*J1*J1*J3*J6,
(-1)*Q^0*J2*J2*J5*J6+(1)*Q^0*J1*J3*J6*J6+(1)*Q^1*J1*J1*J4*J5,
(-1)*Q^0*J1*J3*J3*J3+(-1)*Q^1*J1*J1*J1*J5+(1)*Q^0*J2*J2*J2*J4,
(-1)*Q^0*J3*J3*J3*J5+(1)*Q^0*J2*J4*J4*J4+(1)*Q^2*J1*J1*J1*J6,
(-1)*Q^0*J3*J3*J4*J6+(1)*Q^0*J2*J4*J5*J5+(1)*Q^2*J1*J1*J2*J5,
(-1)*Q^0*J3*J3*J5*J6+(1)*Q^0*J2*J4*J6*J6+(1)*Q^2*J1*J1*J3*J4,
(-1)*Q^0*J1*J3*J4*J4+(-1)*Q^1*J1*J1*J2*J6+(1)*Q^0*J2*J2*J3*J5,
(-1)*Q^0*J2*J4*J4*J4+(-1)*Q^2*J1*J1*J1*J6+(1)*Q^0*J3*J3*J3*J5,
(-1)*Q^0*J4*J4*J4*J6+(1)*Q^0*J3*J5*J5*J5+(1)*Q^3*J1*J1*J1*J4,
(-1)*Q^0*J4*J4*J5*J6+(1)*Q^0*J3*J5*J6*J6+(1)*Q^3*J1*J1*J2*J3,
(-1)*Q^0*J1*J3*J5*J5+(-1)*Q^1*J1*J1*J3*J6+(1)*Q^0*J2*J2*J4*J6,
(-1)*Q^0*J2*J4*J5*J5+(-1)*Q^2*J1*J1*J2*J5+(1)*Q^0*J3*J3*J4*J6,
(-1)*Q^0*J3*J5*J5*J5+(-1)*Q^3*J1*J1*J1*J4+(1)*Q^0*J4*J4*J4*J6,
(-1)*Q^0*J5*J5*J5*J6+(1)*Q^0*J4*J6*J6*J6+(1)*Q^4*J1*J1*J1*J2,
(-1)*Q^0*J1*J3*J6*J6+(-1)*Q^1*J1*J1*J4*J5+(1)*Q^0*J2*J2*J5*J6,
(-1)*Q^0*J2*J4*J6*J6+(-1)*Q^2*J1*J1*J3*J4+(1)*Q^0*J3*J3*J5*J6,
(-1)*Q^0*J3*J5*J6*J6+(-1)*Q^3*J1*J1*J2*J3+(1)*Q^0*J4*J4*J5*J6,
(-1)*Q^0*J4*J6*J6*J6+(-1)*Q^4*J1*J1*J1*J2+(1)*Q^0*J5*J5*J5*J6,
(-1)*Q^0*J2*J3*J3*J6+(1)*Q^0*J1*J4*J4*J5+(1)*Q^1*J1*J2*J2*J6,
(-1)*Q^0*J3*J3*J3*J6+(1)*Q^0*J1*J5*J5*J5+(1)*Q^1*J2*J2*J2*J5,
(-1)*Q^0*J3*J3*J4*J5+(1)*Q^0*J1*J5*J6*J6+(1)*Q^1*J2*J2*J3*J4,
(-1)*Q^0*J1*J4*J4*J5+(-1)*Q^1*J1*J2*J2*J6+(1)*Q^0*J2*J3*J3*J6,
(-1)*Q^0*J3*J4*J4*J6+(1)*Q^0*J2*J5*J5*J6+(1)*Q^2*J1*J2*J2*J4,
(-1)*Q^0*J4*J4*J4*J5+(1)*Q^0*J2*J6*J6*J6+(1)*Q^2*J2*J2*J2*J3,
(-1)*Q^0*J1*J5*J5*J5+(-1)*Q^1*J2*J2*J2*J5+(1)*Q^0*J3*J3*J3*J6,
(-1)*Q^0*J2*J5*J5*J6+(-1)*Q^2*J1*J2*J2*J4+(1)*Q^0*J3*J4*J4*J6,
(-1)*Q^0*J4*J5*J5*J5+(1)*Q^0*J3*J6*J6*J6+(1)*Q^3*J1*J2*J2*J2,
(-1)*Q^0*J1*J5*J6*J6+(-1)*Q^1*J2*J2*J3*J4+(1)*Q^0*J3*J3*J4*J5,
(-1)*Q^0*J2*J6*J6*J6+(-1)*Q^2*J2*J2*J2*J3+(1)*Q^0*J4*J4*J4*J5,
(-1)*Q^0*J3*J6*J6*J6+(-1)*Q^3*J1*J2*J2*J2+(1)*Q^0*J4*J5*J5*J5,
(-1)*Q^0*J2*J4*J4*J5+(1)*Q^0*J1*J5*J5*J6+(1)*Q^1*J1*J3*J3*J4,
(-1)*Q^0*J3*J4*J4*J4+(1)*Q^0*J1*J6*J6*J6+(1)*Q^1*J2*J3*J3*J3,
(-1)*Q^0*J1*J5*J5*J6+(-1)*Q^1*J1*J3*J3*J4+(1)*Q^0*J2*J4*J4*J5,
(-1)*Q^0*J3*J4*J5*J5+(1)*Q^0*J2*J5*J6*J6+(1)*Q^2*J1*J2*J3*J3,
(-1)*Q^0*J1*J6*J6*J6+(-1)*Q^1*J2*J3*J3*J3+(1)*Q^0*J3*J4*J4*J4,
(-1)*Q^0*J2*J5*J6*J6+(-1)*Q^2*J1*J2*J3*J3+(1)*Q^0*J3*J4*J5*J5,
(-1)*Q^0*J2*J3*J5*J5+(1)*Q^0*J1*J4*J6*J6+(1)*Q^1*J1*J2*J4*J4,
(-1)*Q^0*J1*J4*J6*J6+(-1)*Q^1*J1*J2*J4*J4+(1)*Q^0*J2*J3*J5*J5,
(-1)*Q^0*J2*J3*J4*J6+(1)*Q^0*J1*J4*J5*J6+(1)*Q^1*J1*J2*J3*J5,
(-1)*Q^0*J1*J4*J5*J6+(-1)*Q^1*J1*J2*J3*J5+(1)*Q^0*J2*J3*J4*J6,Q*iQ-1;

ideal S=sat(I,J1*J2*J3*J4*J5*J6);
S=std(S);
"dim"; dim(S);
list P=minAssGTZ(S);
"ncomp"; size(P);
int k;
for(k=1;k<=size(P);k++){ "comp",k; dim(std(P[k])); size(P[k]); }
quit;

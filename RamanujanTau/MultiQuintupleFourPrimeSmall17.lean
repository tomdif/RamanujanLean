private lemma short_index17_one (b : Bool) (i : ℕ) (n : ℤ)
    (hi : 1 ≤ i) (hiMax : i ≤ 5) (he : quintExp2 b 17 i n ≤ 118) :
    n.natAbs ≤ 1 := by
  have hn : -1 ≤ n ∧ n ≤ 1 := by
    interval_cases i <;> cases b <;>
      norm_num [quintExp2,quintExpA2,quintExpB2] at he <;>
      constructor <;> by_contra h <;>
      have hside : n ≤ -2 ∨ 2 ≤ n := by omega
    all_goals rcases hside with hside | hside <;>
      nlinarith [sq_nonneg (n+2),sq_nonneg (n-2)]
  omega

private lemma short_index17_two (b : Bool) (i : ℕ) (n : ℤ)
    (hi : 1 ≤ i) (hiMax : i ≤ 5) (he : quintExp2 b 17 i n ≤ 184) :
    n.natAbs ≤ 2 := by

    interval_cases i <;> cases b <;>
      norm_num [quintExp2,quintExpA2,quintExpB2] at he <;>
      constructor <;> by_contra h <;>
      have hside : n ≤ -3 ∨ 3 ≤ n := by omega
    all_goals rcases hside with hside | hside <;>
      nlinarith [sq_nonneg (n+3),sq_nonneg (n-3)]
  omega

def fourPrimeSmall17Radius (K : ℕ) : ℕ := if K ≤ 59 then 0 else 1

private lemma short_index17 (b : Bool) (i : ℕ) (n : ℤ) (K : ℕ)
    (hi : 1 ≤ i) (hiMax : i ≤ 5) (hK : K ≤ 92)
    (he : quintExp2 b 17 i n ≤ 2*(K : ℤ)) : n.natAbs ≤ fourPrimeSmall17Radius K+1 := by
  unfold fourPrimeSmall17Radius
  split_ifs with h
  · exact short_index17_one b i n hi hiMax (by omega)
  · exact short_index17_two b i n hi hiMax (by omega)

private lemma mem_short_box17 (K : ℕ) (hK : K ≤ 92) (x : QuadQuintBranchIndex)
    (he : quadExp2 17 3 1 4 5 x = 2*(K : ℤ)) : x ∈ quadBox (fourPrimeSmall17Radius K) := by
  rcases x with ⟨⟨⟨⟨b1,n1⟩,⟨b2,n2⟩⟩,⟨b3,n3⟩⟩,⟨b4,n4⟩⟩
  simp only [quadExp2,pointTripleExp2,tripleQuintExp2,pointB1,pointB2,pointB3,
    pointN1,pointN2,pointN3,quadB4,quadN4] at he
  have h1 := quintExp2_nonneg b1 17 3 n1 (by norm_num) (by norm_num)
  have h2 := quintExp2_nonneg b2 17 1 n2 (by norm_num) (by norm_num)
  have h3 := quintExp2_nonneg b3 17 4 n3 (by norm_num) (by norm_num)
  have h4 := quintExp2_nonneg b4 17 5 n4 (by norm_num) (by norm_num)
  norm_num only [Nat.cast_ofNat] at he h1 h2 h3 h4
  have hn1 := short_index17 b1 3 n1 K (by norm_num) (by norm_num) hK (by norm_num only [Nat.cast_ofNat]; omega)
  have hn2 := short_index17 b2 1 n2 K (by norm_num) (by norm_num) hK (by norm_num only [Nat.cast_ofNat]; omega)
  have hn3 := short_index17 b3 4 n3 K (by norm_num) (by norm_num) hK (by norm_num only [Nat.cast_ofNat]; omega)
  have hn4 := short_index17 b4 5 n4 K (by norm_num) (by norm_num) hK (by norm_num only [Nat.cast_ofNat]; omega)
  rw [quadBox,tripleQuintBranchBox]
  exact Finset.mem_product.mpr ⟨Finset.mem_product.mpr
    ⟨Finset.mem_product.mpr ⟨mem_quintBranchBox_of_natAbs_le (fourPrimeSmall17Radius K) b1 n1 hn1,
    mem_quintBranchBox_of_natAbs_le (fourPrimeSmall17Radius K) b2 n2 hn2⟩,
    mem_quintBranchBox_of_natAbs_le (fourPrimeSmall17Radius K) b3 n3 hn3⟩,
    mem_quintBranchBox_of_natAbs_le (fourPrimeSmall17Radius K) b4 n4 hn4⟩


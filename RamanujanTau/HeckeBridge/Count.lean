import RamanujanTau.SubgroupSum.Reduce
import RamanujanTau.TorsionSpec.Final

/-!
# There are exactly `p + 1` subgroups of order `p`

For a short curve `E` over a field with `#E[p] = p²` (e.g. any nonsingular curve over an
algebraically closed field of characteristic `0`, `TorsionSpec.fullTorsion`), the order-`p`
subgroups `subs a b p` form a finite set of cardinality `p + 1`.

* `zm p P = {k • P | k < p}` — the cyclic subgroup generated by `P`.
* `eq_zm_of_mem` — an order-`p` subgroup is generated by any of its nonzero points.
* **`exists_subs_finset`** — `subs a b p` is a finset `Z` with `#Z = p + 1`.
* **`exists_enum`** — an enumeration `G : Fin (p+1) → Finset E` of all order-`p` subgroups, with
  `G 0` any prescribed one; `surj_of_inj` — an injective `Fin (p+1)`-family of order-`p` subgroups
  is automatically exhaustive.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace HeckeBridge

open Velu SubgroupSum

variable {F : Type*} [Field F] [DecidableEq F] {a b : F}

/-- The cyclic subgroup `{k • P | k < p}`. -/
def zm (p : ℕ) (P : (short a b).Point) : Finset (short a b).Point :=
  (Finset.range p).image fun k => k • P

section
variable {p : ℕ} [hp : Fact p.Prime]

lemma mem_zm_iff {P : (short a b).Point} (h : p • P = 0) (hP : P ≠ 0) (Q : (short a b).Point) :
    Q ∈ zm p P ↔ ∃ k : ℕ, Q = k • P := by
  constructor
  · intro hQ
    obtain ⟨k, -, rfl⟩ := Finset.mem_image.1 hQ
    exact ⟨k, rfl⟩
  · rintro ⟨k, rfl⟩
    have ho : addOrderOf P = p := addOrderOf_eq_prime h hP
    refine Finset.mem_image.2 ⟨k % p, Finset.mem_range.2 (Nat.mod_lt _ hp.out.pos), ?_⟩
    rw [← ho, mod_addOrderOf_nsmul]

lemma isSub_zm {P : (short a b).Point} (h : p • P = 0) (hP : P ≠ 0) : IsSub (zm p P) := by
  refine ⟨(mem_zm_iff h hP 0).2 ⟨0, (zero_nsmul P).symm⟩, ?_, ?_⟩
  · intro Q hQ R hR
    obtain ⟨k, rfl⟩ := (mem_zm_iff h hP _).1 hQ
    obtain ⟨l, rfl⟩ := (mem_zm_iff h hP _).1 hR
    exact (mem_zm_iff h hP _).2 ⟨k + l, (add_nsmul P k l).symm⟩
  · intro Q hQ
    obtain ⟨k, rfl⟩ := (mem_zm_iff h hP _).1 hQ
    refine (mem_zm_iff h hP _).2 ⟨k * (p - 1), ?_⟩
    have hp1 : 1 ≤ p := hp.out.one_lt.le
    refine (eq_neg_of_add_eq_zero_left ?_).symm
    rw [← add_nsmul, show k * (p - 1) + k = k * p by
      rw [Nat.mul_sub, mul_one, Nat.sub_add_cancel (Nat.le_mul_of_pos_right k (by omega))],
      mul_nsmul', h, nsmul_zero]

lemma card_zm {P : (short a b).Point} (h : p • P = 0) (hP : P ≠ 0) : (zm p P).card = p := by
  have ho : addOrderOf P = p := addOrderOf_eq_prime h hP
  rw [zm, Finset.card_image_of_injOn, Finset.card_range]
  intro i hi j hj hij
  refine nsmul_injOn_Iio_addOrderOf (x := P) ?_ ?_ hij
  · simpa [ho] using hi
  · simpa [ho] using hj

lemma zm_mem_subs {P : (short a b).Point} (h : p • P = 0) (hP : P ≠ 0) : zm p P ∈ subs a b p :=
  ⟨isSub_zm h hP, card_zm h hP⟩

lemma nsmul_eq_zero_of_mem_subs {G : Finset (short a b).Point} (hG : G ∈ subs a b p)
    {P : (short a b).Point} (hP : P ∈ G) : p • P = 0 := by
  obtain ⟨hS, hc⟩ := hG
  have hcard : Nat.card hS.toAddSubgroup = p := by
    rw [← hc]
    change Nat.card (G : Set (short a b).Point) = G.card
    rw [Nat.card_coe_set_eq, Set.ncard_coe_finset]
  have := card_nsmul_eq_zero' (G := hS.toAddSubgroup) (x := ⟨P, hP⟩)
  rw [hcard] at this
  exact congrArg Subtype.val this

lemma nsmul_mem_of_isSub {G : Finset (short a b).Point} (hG : IsSub G) {P : (short a b).Point}
    (hP : P ∈ G) (k : ℕ) : k • P ∈ G := by
  induction k with
  | zero => rw [zero_nsmul]; exact hG.1
  | succ k ih => rw [succ_nsmul]; exact hG.2.1 _ ih _ hP

/-- An order-`p` subgroup is generated by any nonzero point of it. -/
lemma eq_zm_of_mem {G : Finset (short a b).Point} (hG : G ∈ subs a b p) {P : (short a b).Point}
    (hPG : P ∈ G) (hP : P ≠ 0) : zm p P = G := by
  have h := nsmul_eq_zero_of_mem_subs hG hPG
  refine Finset.eq_of_subset_of_card_le ?_ (by rw [hG.2, card_zm h hP])
  intro Q hQ
  obtain ⟨k, rfl⟩ := (mem_zm_iff h hP _).1 hQ
  exact nsmul_mem_of_isSub hG.1 hPG k

lemma mem_zm_self {P : (short a b).Point} (h : p • P = 0) (hP : P ≠ 0) : P ∈ zm p P :=
  (mem_zm_iff h hP _).2 ⟨1, (one_nsmul P).symm⟩

/-- **Counting**: if `#E[p] = p²`, the order-`p` subgroups form a finset of cardinality `p + 1`. -/
theorem exists_subs_finset {T : Finset (short a b).Point} (hT : ∀ P, P ∈ T ↔ p • P = 0)
    (hTc : T.card = p ^ 2) :
    ∃ Z : Finset (Finset (short a b).Point), (∀ G, G ∈ subs a b p ↔ G ∈ Z) ∧ Z.card = p + 1 := by
  classical
  set Z := (T.erase 0).image (zm p) with hZ
  have hmemZ : ∀ G, G ∈ subs a b p ↔ G ∈ Z := by
    intro G
    constructor
    · intro hG
      obtain ⟨P, hPG, hP⟩ := Finset.exists_mem_ne (s := G) (by rw [hG.2]; exact hp.out.one_lt) 0
      exact Finset.mem_image.2 ⟨P, Finset.mem_erase.2 ⟨hP, (hT P).2
        (nsmul_eq_zero_of_mem_subs hG hPG)⟩, eq_zm_of_mem hG hPG hP⟩
    · intro hG
      obtain ⟨P, hP, rfl⟩ := Finset.mem_image.1 hG
      obtain ⟨hP0, hPT⟩ := Finset.mem_erase.1 hP
      exact zm_mem_subs ((hT P).1 hPT) hP0
  refine ⟨Z, hmemZ, ?_⟩
  have hfib : ∀ G ∈ Z, ((T.erase 0).filter fun P => zm p P = G) = G.erase 0 := by
    intro G hGZ
    have hG := (hmemZ G).2 hGZ
    ext P
    simp only [Finset.mem_filter, Finset.mem_erase]
    constructor
    · rintro ⟨⟨hP0, hPT⟩, rfl⟩
      exact ⟨hP0, mem_zm_self ((hT P).1 hPT) hP0⟩
    · rintro ⟨hP0, hPG⟩
      exact ⟨⟨hP0, (hT P).2 (nsmul_eq_zero_of_mem_subs hG hPG)⟩, eq_zm_of_mem hG hPG hP0⟩
  have hcount := Finset.card_eq_sum_card_fiberwise (f := zm p) (s := T.erase 0) (t := Z)
    (fun P hP => Finset.mem_image_of_mem _ hP)
  rw [Finset.sum_congr rfl fun G hG => by rw [hfib G hG]] at hcount
  have h0T : (0 : (short a b).Point) ∈ T := (hT 0).2 (nsmul_zero p)
  rw [Finset.sum_congr rfl fun G hG => by
      rw [Finset.card_erase_of_mem ((hmemZ G).2 hG).1.1, ((hmemZ G).2 hG).2],
    Finset.sum_const, smul_eq_mul, Finset.card_erase_of_mem h0T, hTc] at hcount
  have hp2 : 2 ≤ p := hp.out.two_le
  have e : p ^ 2 - 1 = (p + 1) * (p - 1) := by
    obtain ⟨m, rfl⟩ : ∃ m, p = m + 1 := ⟨p - 1, by omega⟩
    simp only [Nat.add_sub_cancel]
    rw [show (m + 1) ^ 2 = (m + 1 + 1) * m + 1 by ring, Nat.add_sub_cancel]
  rw [e] at hcount
  exact (Nat.eq_of_mul_eq_mul_right (by omega : 0 < p - 1) hcount).symm

/-- An injective `Fin (p+1)`-family of order-`p` subgroups is exhaustive (when `#E[p] = p²`). -/
theorem surj_of_inj {T : Finset (short a b).Point} (hT : ∀ P, P ∈ T ↔ p • P = 0)
    (hTc : T.card = p ^ 2) (G : Fin (p + 1) → Finset (short a b).Point)
    (hmem : ∀ c, G c ∈ subs a b p) (hinj : Function.Injective G) :
    ∀ H ∈ subs a b p, ∃ c, G c = H := by
  classical
  obtain ⟨Z, hZ, hZc⟩ := exists_subs_finset hT hTc
  have hsub : Finset.univ.image G ⊆ Z := by
    intro H hH
    obtain ⟨c, -, rfl⟩ := Finset.mem_image.1 hH
    exact (hZ _).1 (hmem c)
  have heq : Finset.univ.image G = Z := Finset.eq_of_subset_of_card_le hsub (by
    rw [Finset.card_image_of_injective _ hinj, Finset.card_univ, Fintype.card_fin, hZc])
  intro H hH
  have : H ∈ Finset.univ.image G := heq ▸ (hZ H).1 hH
  obtain ⟨c, -, hc⟩ := Finset.mem_image.1 this
  exact ⟨c, hc⟩

/-- **An enumeration of all order-`p` subgroups**, with a prescribed `G 0`. -/
theorem exists_enum {T : Finset (short a b).Point} (hT : ∀ P, P ∈ T ↔ p • P = 0)
    (hTc : T.card = p ^ 2) {H₀ : Finset (short a b).Point} (hH₀ : H₀ ∈ subs a b p) :
    ∃ G : Fin (p + 1) → Finset (short a b).Point, (∀ c, G c ∈ subs a b p) ∧
      Function.Injective G ∧ (∀ H ∈ subs a b p, ∃ c, G c = H) ∧ G 0 = H₀ := by
  classical
  obtain ⟨Z, hZ, hZc⟩ := exists_subs_finset hT hTc
  let e : Fin (p + 1) ≃ Z := (Z.equivFinOfCardEq hZc).symm
  let i₀ : Fin (p + 1) := e.symm ⟨H₀, (hZ _).1 hH₀⟩
  let e' : Fin (p + 1) ≃ Z := (Equiv.swap 0 i₀).trans e
  refine ⟨fun c => (e' c : Finset _), fun c => (hZ _).2 (e' c).2,
    fun c d h => e'.injective (Subtype.ext h), fun H hH => ⟨e'.symm ⟨H, (hZ _).1 hH⟩, by simp⟩, ?_⟩
  simp [e', i₀]

end

/-- Over an algebraically closed field of characteristic `0`, every nonsingular short curve has
an enumeration of its `p + 1` subgroups of order `p` with any prescribed `G 0`. -/
theorem exists_enum_algClosed [IsAlgClosed F] [CharZero F] (p : ℕ) [hp : Fact p.Prime]
    (hΔ : 4 * a ^ 3 + 27 * b ^ 2 ≠ 0) {H₀ : Finset (short a b).Point} (hH₀ : H₀ ∈ subs a b p) :
    ∃ G : Fin (p + 1) → Finset (short a b).Point, (∀ c, G c ∈ subs a b p) ∧
      Function.Injective G ∧ (∀ H ∈ subs a b p, ∃ c, G c = H) ∧ G 0 = H₀ := by
  obtain ⟨T, hT, hTc⟩ := TorsionSpec.fullTorsion (F := F) hp.out.two_le a b hΔ
  exact exists_enum hT hTc hH₀

theorem surj_of_inj_algClosed [IsAlgClosed F] [CharZero F] (p : ℕ) [hp : Fact p.Prime]
    (hΔ : 4 * a ^ 3 + 27 * b ^ 2 ≠ 0) (G : Fin (p + 1) → Finset (short a b).Point)
    (hmem : ∀ c, G c ∈ subs a b p) (hinj : Function.Injective G) :
    ∀ H ∈ subs a b p, ∃ c, G c = H := by
  obtain ⟨T, hT, hTc⟩ := TorsionSpec.fullTorsion (F := F) hp.out.two_le a b hΔ
  exact surj_of_inj hT hTc G hmem hinj

/-- Some order-`p` subgroup exists (over an algebraically closed field of characteristic `0`). -/
theorem subs_nonempty [IsAlgClosed F] [CharZero F] (p : ℕ) [hp : Fact p.Prime]
    (hΔ : 4 * a ^ 3 + 27 * b ^ 2 ≠ 0) : ∃ H, H ∈ subs a b p := by
  classical
  obtain ⟨T, hT, hTc⟩ := TorsionSpec.fullTorsion (F := F) hp.out.two_le a b hΔ
  obtain ⟨P, hPT, hP⟩ := Finset.exists_mem_ne (s := T) (by
    rw [hTc]; nlinarith [hp.out.two_le]) 0
  exact ⟨zm p P, zm_mem_subs ((hT P).1 hPT) hP⟩

end HeckeBridge

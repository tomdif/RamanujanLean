theorem h24 : 24 * δ 17 + 1 = 17 ^ 2 := by decide

/-- `L_17(b) mod 17` lies on the line `𝔽_17·f` and is nonzero, for every `b ≥ 1`. -/
theorem rank_one (b : ℕ) (hb : 1 ≤ b) : ∃ x : ZMod 17, x ≠ 0 ∧ Ψ 17 (L 17 b) = C x * Ψ 17 f :=
  (boylan_webb_mod 17 h24 f 7 7 13 eigen.1 eigen.2.1 eigen.2.2

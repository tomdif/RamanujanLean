    (by decide) (by decide) (by decide) f_ne_zero).2.2.1 b hb

/-- **Partition form**: `p(17^(b+2)·m − e_(b+2)) ≡ 6·p(17^b·m − e_b) (mod 17)`, `b ≥ 1`. -/
theorem partition (b : ℕ) (hb : 1 ≤ b) (m : ℕ) :
    ((pZ ((17 : ℕ) ^ (b + 2) * m - eB 17 (b + 2)) : ℤ) : ZMod 17) =
      (6 : ZMod 17) * ((pZ ((17 : ℕ) ^ b * m - eB 17 b) : ℤ) : ZMod 17) := by
  have h := (boylan_webb_mod 17 h24 f 7 7 13 eigen.1 eigen.2.1 eigen.2.2
    (by decide) (by decide) (by decide) f_ne_zero).2.2.2 b hb m
  rw [show ((7 * 13 : ℤ) : ZMod 17) = 6 by decide] at h
  exact h


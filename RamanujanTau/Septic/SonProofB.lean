lemma SBbG_E (z : ((((ℤ × ℤ) × ℤ) × ℤ) × ℤ) × ℤ) : SBbG (SBbE z).1 (SBbE z).2 = SBbW z := by
  simp only [SBbG, SBbE, Equiv.coe_fn_mk]
  rw [SBbco0, SBbco1, SBbco2, SBbco3, SBbco4, SBbco5]
  rfl

lemma good_SBbG (s : Fin 7 × Fin 7) : Good (SBbG s) :=
  good_prod _ _ (good_prod _ _ (good_prod _ _ (good_prod _ _ (good_prod _ _ (good_T _) (good_T _)) (good_T _)) (good_T _)) (good_T _)) (good_T _)

lemma cnt_SBbG (s : Fin 7 × Fin 7) : cnt (SBbG s) = T (SBbr0 s) * T (SBbr1 s) * T (SBbr2 s) * T (SBbr3 s) * T (SBbr4 s) * T (SBbr5 s) := by
  simp only [T]
  rw [cnt_mul _ _ (good_T _) (good_T _),
    cnt_mul _ _ (good_prod _ _ (good_T _) (good_T _)) (good_T _),
    cnt_mul _ _ (good_prod _ _ (good_prod _ _ (good_T _) (good_T _)) (good_T _)) (good_T _),
    cnt_mul _ _ (good_prod _ _ (good_prod _ _ (good_prod _ _ (good_T _) (good_T _)) (good_T _)) (good_T _)) (good_T _),
    cnt_mul _ _ (good_prod _ _ (good_prod _ _ (good_prod _ _ (good_prod _ _ (good_T _) (good_T _)) (good_T _)) (good_T _)) (good_T _)) (good_T _)]
  rfl

noncomputable def SBbpoly : PowerSeries ℤ :=
      (1) * T 0 ^ 6
      + (12) * T 0 * T 1 ^ 3 * T 3 ^ 2
      + (12) * T 0 * T 1 ^ 2 * T 2 ^ 3
      + (12) * T 0 * T 2 ^ 2 * T 3 ^ 3
      + (12) * T 1 ^ 2 * T 2 ^ 2 * T 3 ^ 2

lemma SBbsum : ∑ s : Fin 7 × Fin 7, cnt (SBbG s) = SBbpoly := by
  simp only [cnt_SBbG, Fintype.sum_prod_type, Fin.sum_univ_seven, SBbr0, SBbr1, SBbr2, SBbr3, SBbr4, SBbr5]
  norm_num [T4, T5, T6, SBbpoly]
  ring

lemma SBbcnt : cnt SBbW = SBbpoly := by
  rw [cnt_congr SBbE (g := fun p : (Fin 7 × Fin 7) × ((((ℤ × ℤ) × ℤ) × ℤ) × ℤ) × ℤ => SBbG p.1 p.2) SBbG_E,
    cnt_fin_prod SBbG good_SBbG, SBbsum]


/-- the isometry `M/7 : L_U → L_U'` in pivot coordinates (unimodular). -/
def SBV : ((((ℤ × ℤ) × ℤ) × ℤ) × ℤ) × ℤ ≃ ((((ℤ × ℤ) × ℤ) × ℤ) × ℤ) × ℤ where
  toFun z := ((((((-4) * z.1.1.1.1.1 + (-1) * z.1.1.1.1.2 + (-3) * z.1.1.1.2 + (-1) * z.1.1.2 + (-5) * z.1.2 + (2) * z.2, (-2) * z.1.1.1.1.1 + (-1) * z.1.1.1.1.2 + (-2) * z.1.1.1.2 + (-5) * z.1.1.2 + (3) * z.1.2 + (-1) * z.2), (3) * z.1.1.1.1.1 + (1) * z.1.1.1.1.2 + (2) * z.1.1.1.2 + (3) * z.1.1.2 + (1) * z.1.2), (1) * z.1.1.1.1.1 + (1) * z.1.1.1.1.2 + (2) * z.1.1.1.2 + (2) * z.1.1.2 + (-1) * z.1.2), (4) * z.1.1.1.1.1 + (1) * z.1.1.1.1.2 + (3) * z.1.1.1.2 + (2) * z.1.1.2 + (4) * z.1.2 + (-2) * z.2), (4) * z.1.1.1.1.1 + (1) * z.1.1.1.1.2 + (3) * z.1.1.1.2 + (5) * z.1.1.2 + (-1) * z.2)
  invFun z := ((((((-2) * z.1.1.1.1.1 + (3) * z.1.1.1.1.2 + (2) * z.1.1.1.2 + (1) * z.1.1.2 + (-5) * z.1.2 + (3) * z.2, (5) * z.1.1.1.1.1 + (5) * z.1.1.1.1.2 + (5) * z.1.1.1.2 + (3) * z.1.1.2 + (2) * z.1.2 + (1) * z.2), (-3) * z.1.1.1.1.1 + (-3) * z.1.1.1.1.2 + (-3) * z.1.1.1.2 + (-1) * z.1.1.2 + (-1) * z.1.2 + (-1) * z.2), (2) * z.1.1.1.1.1 + (-2) * z.1.1.1.1.2 + (-1) * z.1.1.1.2 + (-1) * z.1.1.2 + (4) * z.1.2 + (-2) * z.2), (1) * z.1.1.1.1.1 + (-2) * z.1.1.1.1.2 + (-1) * z.1.1.1.2 + (-1) * z.1.1.2 + (3) * z.1.2 + (-2) * z.2), (-2) * z.1.1.1.1.1 + (-2) * z.1.1.1.1.2 + (-1) * z.1.1.1.2 + (-1) * z.1.1.2 + (-1) * z.1.2 + (-1) * z.2)
  left_inv z := by
    obtain ⟨⟨⟨⟨⟨z0, z1⟩, z2⟩, z3⟩, z4⟩, z5⟩ := z
    ext <;> simp only <;> ring
  right_inv z := by
    obtain ⟨⟨⟨⟨⟨z0, z1⟩, z2⟩, z3⟩, z4⟩, z5⟩ := z
    ext <;> simp only <;> ring

lemma SBW_V (z : ((((ℤ × ℤ) × ℤ) × ℤ) × ℤ) × ℤ) : SBbW (SBV z) = SBaW z := by
  obtain ⟨⟨⟨⟨⟨z0, z1⟩, z2⟩, z3⟩, z4⟩, z5⟩ := z
  simp only [SBV, Equiv.coe_fn_mk, SBaW, SBbW, SBak0, SBak1, SBak2, SBak3, SBak4, SBak5, SBbk0, SBbk1, SBbk2, SBbk3, SBbk4, SBbk5]
  ring

/-- **isometry identity `SB`**: `P_U = P_U'`. -/
theorem SB_identity : SBapoly = SBbpoly := by
  rw [← SBacnt, ← SBbcnt]
  exact cnt_congr SBV SBW_V

lemma twelve_ne : (12 : PowerSeries ℤ) ≠ 0 := by
  intro h
  have := congrArg (PowerSeries.coeff 0) h
  rw [show (12 : PowerSeries ℤ) = PowerSeries.C (12 : ℤ) by simp, PowerSeries.coeff_C] at this
  simp at this

/-- **Son's sextic relation** in `T`-form. -/
theorem sonSextic_T' :
    T 0 * (T 1 ^ 2 * T 2 ^ 3 + T 2 ^ 2 * T 3 ^ 3 + T 3 ^ 2 * T 1 ^ 3)
      = T 0 ^ 3 * T 1 * T 2 * T 3 + 2 * (T 1 * T 2 * T 3) ^ 2 := by
  have h := SB_identity
  simp only [SBapoly, SBbpoly] at h
  have h2 : (12 : PowerSeries ℤ) * (T 0 * (T 1 ^ 2 * T 2 ^ 3 + T 2 ^ 2 * T 3 ^ 3 + T 3 ^ 2 * T 1 ^ 3)
      - (T 0 ^ 3 * T 1 * T 2 * T 3 + 2 * (T 1 * T 2 * T 3) ^ 2)) = 0 := by
    linear_combination (-1 : PowerSeries ℤ) * h
  rcases mul_eq_zero.mp h2 with h3 | h3
  · exact absurd h3 twelve_ne
  · exact sub_eq_zero.mp h3

/-- **Son's sextic relation** `SonSextic` (Entry 1.1(iv)/(v), second symmetric function). -/
theorem sonSextic : SonSextic := by
  have h := sonSextic_T'
  rw [T0_eq, T1_eq, T2_eq, T3_eq] at h
  exact h


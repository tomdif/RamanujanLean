/-- the coset sum `Σ_{v ∈ W_1} Π T_{vᵢ}`. -/
lemma O1sum : ∑ st : Idx4, cnt (O1G st) = O1poly := by
  simp only [cnt_O1G, Fintype.sum_prod_type, Fin.sum_univ_seven, O1r0, O1r1, O1r2, O1r3, O1r4, O1r5, O1r6, O1r7]
  norm_num [T4, T5, T6, O1poly]
  ring

/-- **8-dimensional lattice identity 1**: `φ(q⁷)⁸ = P_{W_1}(a, b, c, d)`. -/
theorem octo1_identity : ramF 7 7 ^ 8 = O1poly := by
  rw [Phi8_cnt, cnt_congr (O1e1.trans O1e2) (g := fun p : Idx4 × Z8 => O1G p.1 p.2)
    (fun n => by simp only [Equiv.trans_apply]; rw [O1G_e2, O1W_e1]),
    cnt_fin_prod O1G good_O1G, O1sum]


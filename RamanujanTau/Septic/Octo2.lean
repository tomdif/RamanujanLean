/-- the polynomial `P_{W_2}(a,b,c,d)` (multiplicities of the class patterns on `W_2`). -/
noncomputable def O2poly : PowerSeries ℤ :=
      1 * T 0 ^ 8
      + 16 * T 0 ^ 4 * T 1 ^ 3 * T 2
      + 16 * T 0 ^ 4 * T 1 * T 3 ^ 3
      + 16 * T 0 ^ 4 * T 2 ^ 3 * T 3
      + 48 * T 0 ^ 3 * T 1 ^ 3 * T 3 ^ 2
      + 48 * T 0 ^ 3 * T 1 ^ 2 * T 2 ^ 3
      + 48 * T 0 ^ 3 * T 2 ^ 2 * T 3 ^ 3
      + 48 * T 0 ^ 2 * T 1 ^ 5 * T 3
      + 480 * T 0 ^ 2 * T 1 ^ 2 * T 2 ^ 2 * T 3 ^ 2
      + 48 * T 0 ^ 2 * T 1 * T 2 ^ 5
      + 48 * T 0 ^ 2 * T 2 * T 3 ^ 5
      + 288 * T 0 * T 1 ^ 4 * T 2 ^ 2 * T 3
      + 288 * T 0 * T 1 ^ 2 * T 2 * T 3 ^ 4
      + 288 * T 0 * T 1 * T 2 ^ 4 * T 3 ^ 2
      + 16 * T 1 ^ 6 * T 2 ^ 2
      + 224 * T 1 ^ 4 * T 2 * T 3 ^ 3
      + 224 * T 1 ^ 3 * T 2 ^ 4 * T 3
      + 16 * T 1 ^ 2 * T 3 ^ 6
      + 224 * T 1 * T 2 ^ 3 * T 3 ^ 4
      + 16 * T 2 ^ 6 * T 3 ^ 2

/-- the coset sum `Σ_{v ∈ W_2} Π T_{vᵢ}`. -/
lemma O2sum : ∑ st : Idx4, cnt (O2G st) = O2poly := by
  simp only [cnt_O2G, Fintype.sum_prod_type, Fin.sum_univ_seven, O2r0, O2r1, O2r2, O2r3, O2r4, O2r5, O2r6, O2r7]
  norm_num [T4, T5, T6, O2poly]
  ring

/-- **8-dimensional lattice identity 2**: `φ(q⁷)⁸ = P_{W_2}(a, b, c, d)`. -/
theorem octo2_identity : ramF 7 7 ^ 8 = O2poly := by
  rw [Phi8_cnt, cnt_congr (O2e1.trans O2e2) (g := fun p : Idx4 × Z8 => O2G p.1 p.2)
    (fun n => by simp only [Equiv.trans_apply]; rw [O2G_e2, O2W_e1]),
    cnt_fin_prod O2G good_O2G, O2sum]


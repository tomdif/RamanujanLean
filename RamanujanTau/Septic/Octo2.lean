    7 * ((k.1.2 - O2r7 (O2s k.1)) / 7) + O2r7 (O2s k.1) = k.1.2 := by
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨k0, k1⟩, k2⟩, k3⟩, k4⟩, k5⟩, k6⟩, k7⟩, hk⟩ := k
  obtain ⟨⟨q0, g0⟩, ⟨q1, g1⟩, ⟨q2, g2⟩, ⟨q3, g3⟩, ⟨q4, g4⟩, ⟨q5, g5⟩, ⟨q6, g6⟩, ⟨q7, g7⟩⟩ := hk
  simp only [O2t0, O2t1, O2t2, O2t3, O2t4, O2t5, O2t6, O2t7] at g0 g1 g2 g3 g4 g5 g6 g7
  simp only [O2s, O2r0, O2r1, O2r2, O2r3, O2r4, O2r5, O2r6, O2r7, toNat_emod7]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · omega
  · omega
  · omega
  · omega
  · have hd : k4 - ((2) * k0 + (6) * k2 + (6) * k3) = 7 * ((3) * q0 + (4) * q1 + (6) * q2 + (6) * q3 + (1) * k0 + (1) * k1 + (1) * k4 + (1) * k5 + (-2) * k6 + (-2) * k7) := by linear_combination (3) * g0 + (4) * g1 + (6) * g2 + (6) * g3
    omega
  · have hd : k5 - ((1) * k0 + (1) * k1 + (2) * k2) = 7 * ((1) * q0) := by linear_combination (1) * g0
    omega
  · have hd : k6 - ((2) * k0 + (1) * k1 + (2) * k2 + (2) * k3) = 7 * ((1) * q0 + (1) * q3) := by linear_combination (1) * g0 + (1) * g3
    omega
  · have hd : k7 - ((5) * k0 + (5) * k1 + (2) * k2 + (1) * k3) = 7 * ((1) * q0 + (4) * q1 + (4) * q3 + (1) * k3 + (1) * k5 + (-1) * k7) := by linear_combination (1) * g0 + (4) * g1 + (4) * g3
    omega

def O2e2 : O2L ≃ Idx4 × Z8 where
  toFun k := (O2s k.1, ((((((((k.1.1.1.1.1.1.1.1 - O2r0 (O2s k.1)) / 7, (k.1.1.1.1.1.1.1.2 - O2r1 (O2s k.1)) / 7), (k.1.1.1.1.1.1.2 - O2r2 (O2s k.1)) / 7), (k.1.1.1.1.1.2 - O2r3 (O2s k.1)) / 7), (k.1.1.1.1.2 - O2r4 (O2s k.1)) / 7), (k.1.1.1.2 - O2r5 (O2s k.1)) / 7), (k.1.1.2 - O2r6 (O2s k.1)) / 7), (k.1.2 - O2r7 (O2s k.1)) / 7))
  invFun q := ⟨(((((((7 * q.2.1.1.1.1.1.1.1 + O2r0 q.1, 7 * q.2.1.1.1.1.1.1.2 + O2r1 q.1), 7 * q.2.1.1.1.1.1.2 + O2r2 q.1), 7 * q.2.1.1.1.1.2 + O2r3 q.1), 7 * q.2.1.1.1.2 + O2r4 q.1), 7 * q.2.1.1.2 + O2r5 q.1), 7 * q.2.1.2 + O2r6 q.1), 7 * q.2.2 + O2r7 q.1), O2mem_mk q⟩
  left_inv k := by
    obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := O2cls k
    apply Subtype.ext
    simp only
    rw [h0, h1, h2, h3, h4, h5, h6, h7]
  right_inv q := by
    simp only [O2s_mk]
    obtain ⟨st, ⟨⟨⟨⟨⟨⟨⟨m0, m1⟩, m2⟩, m3⟩, m4⟩, m5⟩, m6⟩, m7⟩⟩ := q
    ext <;> simp only <;> omega

def O2WL (k : O2L) : ℤ := k.1.1.1.1.1.1.1.1 ^ 2 + k.1.1.1.1.1.1.1.2 ^ 2 + k.1.1.1.1.1.1.2 ^ 2 + k.1.1.1.1.1.2 ^ 2 + k.1.1.1.1.2 ^ 2 + k.1.1.1.2 ^ 2 + k.1.1.2 ^ 2 + k.1.2 ^ 2

lemma O2W_e1 (n : Z8) : O2WL (O2e1 n) = W8 n := by
  simp only [O2WL, O2e1, Equiv.coe_fn_mk, W8, O2k0, O2k1, O2k2, O2k3, O2k4, O2k5, O2k6, O2k7]
  ring

lemma O2G_e2 (k : O2L) : O2G (O2e2 k).1 (O2e2 k).2 = O2WL k := by
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := O2cls k
  simp only [O2G, O2e2, Equiv.coe_fn_mk, O2WL]
  rw [h0, h1, h2, h3, h4, h5, h6, h7]
  try ring

lemma good_O2G (st : Idx4) : Good (O2G st) :=

  toFun z := ((((((-2) * z.1.1.1.1.1 + (-2) * z.1.1.1.2 + (2) * z.1.1.2 + (-5) * z.1.2 + (-1) * z.2, (4) * z.1.1.1.1.1 + (4) * z.1.1.1.1.2 + (3) * z.1.1.1.2 + (1) * z.1.1.2 + (-1) * z.1.2 + (5) * z.2), (-3) * z.1.1.1.1.2 + (-5) * z.1.1.2 + (-2) * z.1.2 + (3) * z.2), (-3) * z.1.1.1.1.1 + (-2) * z.1.1.1.1.2 + (-2) * z.1.1.1.2 + (1) * z.1.1.2 + (2) * z.1.2 + (-5) * z.2), (1) * z.1.1.1.1.1 + (1) * z.1.1.1.1.2 + (1) * z.1.1.1.2 + (1) * z.1.1.2 + (4) * z.1.2 + (-1) * z.2), (1) * z.1.1.1.1.1 + (2) * z.1.1.1.1.2 + (1) * z.1.1.1.2 + (3) * z.1.1.2 + (6) * z.1.2 + (-3) * z.2)
  invFun z := ((((((2) * z.1.1.1.1.1 + (3) * z.1.1.1.2 + (-1) * z.1.1.2 + (-3) * z.1.2 + (5) * z.2, (-4) * z.1.1.1.1.1 + (-2) * z.1.1.1.1.2 + (-4) * z.1.1.1.2 + (-2) * z.1.1.2 + (-5) * z.1.2 + (-1) * z.2), (4) * z.1.1.1.1.2 + (2) * z.1.1.1.2 + (5) * z.1.1.2 + (-2) * z.1.2 + (1) * z.2), (3) * z.1.1.1.1.1 + (1) * z.1.1.1.1.2 + (2) * z.1.1.1.2 + (1) * z.1.1.2 + (6) * z.1.2 + (-1) * z.2), (-1) * z.1.1.1.1.2 + (-1) * z.1.1.1.2 + (-1) * z.1.1.2 + (3) * z.1.2 + (-2) * z.2), (1) * z.1.1.1.1.1 + (-1) * z.1.1.1.1.2 + (-1) * z.1.1.1.2 + (-1) * z.1.1.2 + (7) * z.1.2 + (-4) * z.2)
  left_inv z := by
    obtain ⟨⟨⟨⟨⟨z0, z1⟩, z2⟩, z3⟩, z4⟩, z5⟩ := z
    ext <;> simp only <;> ring
  right_inv z := by
    obtain ⟨⟨⟨⟨⟨z0, z1⟩, z2⟩, z3⟩, z4⟩, z5⟩ := z
    ext <;> simp only <;> ring

lemma S6W_V (z : ((((ℤ × ℤ) × ℤ) × ℤ) × ℤ) × ℤ) : S6bW (S6V z) = S6aW z := by
  obtain ⟨⟨⟨⟨⟨z0, z1⟩, z2⟩, z3⟩, z4⟩, z5⟩ := z
  simp only [S6V, Equiv.coe_fn_mk, S6aW, S6bW, S6ak0, S6ak1, S6ak2, S6ak3, S6ak4, S6ak5, S6bk0, S6bk1, S6bk2, S6bk3, S6bk4, S6bk5]
  ring

/-- **isometry identity `S6`**: `P_U = P_U'`. -/
theorem S6_identity : S6apoly = S6bpoly := by
  rw [← S6acnt, ← S6bcnt]
  exact cnt_congr S6V S6W_V

lemma three_ne : (3 : PowerSeries ℤ) ≠ 0 := by
  intro h
  have := congrArg (PowerSeries.coeff 0) h
  rw [show (3 : PowerSeries ℤ) = PowerSeries.C (3 : ℤ) by simp, PowerSeries.coeff_C] at this
  simp at this

/-- **Entry 1.1(iii)** in `T`-form. -/
theorem sonEntryIII_T' :
    T 0 * ramF 7 7 ^ 8 + (T 0 ^ 3 - 8 * T 1 * T 2 * T 3) ^ 3
      = (2 * T 0 ^ 5 + 40 * T 0 ^ 2 * T 1 * T 2 * T 3) * ramF 7 7 ^ 4 := by
  have hQ := quaternion_identity_T
  have hB := sonSextic_T'
  have h7 := S7_identity
  have h6 := S6_identity
  simp only [S7apoly, S7bpoly] at h7
  simp only [S6apoly, S6bpoly] at h6
  have h3 : (3 : PowerSeries ℤ) * (T 0 * ramF 7 7 ^ 8 + (T 0 ^ 3 - 8 * T 1 * T 2 * T 3) ^ 3
      - (2 * T 0 ^ 5 + 40 * T 0 ^ 2 * T 1 * T 2 * T 3) * ramF 7 7 ^ 4) = 0 := by
    linear_combination (3 * (T 0 * (ramF 7 7 ^ 4 + (T 0 ^ 4 + 24 * T 0 * T 1 * T 2 * T 3 + 8 * (T 1 ^ 3 * T 2 + T 2 ^ 3 * T 3 + T 3 ^ 3 * T 1))) - (2 * T 0 ^ 5 + 40 * T 0 ^ 2 * T 1 * T 2 * T 3))) * hQ
      + (192*(T 0) ^ 3 + 192*(T 0)*(T 1) ^ 2 + 192*(T 0)*(T 1)*(T 2) + 192*(T 0)*(T 1)*(T 3) + 192*(T 0)*(T 2) ^ 2 + 192*(T 0)*(T 2)*(T 3) + 192*(T 0)*(T 3) ^ 2 - 192*(T 1) ^ 3 - 192*(T 1) ^ 2*(T 2) + 960*(T 1)*(T 2)*(T 3) - 192*(T 1)*(T 3) ^ 2 - 192*(T 2) ^ 3 - 192*(T 2) ^ 2*(T 3) - 192*(T 3) ^ 3) * hB + (48*(T 0) ^ 2 - 48*(T 0)*(T 1) - 48*(T 0)*(T 2) - 48*(T 0)*(T 3) + 48*(T 1)*(T 2) + 48*(T 1)*(T 3) + 48*(T 2)*(T 3)) * h7 + (-16*(T 0)*(T 1) ^ 2 - 16*(T 0)*(T 1)*(T 2) - 16*(T 0)*(T 1)*(T 3) - 16*(T 0)*(T 2) ^ 2 - 16*(T 0)*(T 2)*(T 3) - 16*(T 0)*(T 3) ^ 2 - 16*(T 1)*(T 2)*(T 3)) * h6
  rcases mul_eq_zero.mp h3 with h | h
  · exact absurd h three_ne
  · exact sub_eq_zero.mp h

/-- **Son's Entry 1.1(iii)** `SonEntryIII`. -/
theorem sonEntryIII : SonEntryIII := by
  have h := sonEntryIII_T'
  rw [T0_eq, T1_eq, T2_eq, T3_eq] at h
  exact h

/-- **Son's septic core** (Entry 1.1(iii) and the sextic relation (B)), unconditionally. -/
theorem septicSonCore : SepticSonCore := ⟨sonSextic, sonEntryIII⟩

end RamanujanTau.Septic.SonProof

import RamanujanTau.MultiQuintupleFourPrimeInvolution

/-! Integral lattice preservation from the supported short-vector involution,
and preservation of the dual residue lattice. -/
namespace Ramanujan.MultiQuintuple
open scoped BigOperators
set_option maxHeartbeats 2000000

def fourProjectiveModule (p : ℕ) (v : Fin 4 → ℤ) : Submodule ℤ (Fin 4 → ℤ) where
  carrier := {x | ∃ a : ℤ, ∃ z : Fin 4 → ℤ, x=a • v+(p : ℤ) • z}
  zero_mem' := ⟨0,0,by simp⟩
  add_mem' := by
    rintro x y ⟨a,z,hx⟩ ⟨b,w,hy⟩
    refine ⟨a+b,z+w,?_⟩
    rw [hx,hy]
    module
  smul_mem' := by
    rintro c x ⟨a,z,hx⟩
    refine ⟨c*a,c • z,?_⟩
    rw [hx]
    module

theorem fourProjectiveModule_base (p : ℕ) (v : Fin 4 → ℤ) : v ∈ fourProjectiveModule p v :=
  ⟨1,0,by simp⟩

theorem fourProjectiveModule_multiple (p : ℕ) (v z : Fin 4 → ℤ) :
    (p : ℤ) • z ∈ fourProjectiveModule p v := ⟨0,z,by simp⟩

theorem four_short_span_le_projective (p : ℕ) (v : Fin 4 → ℤ) :
    Submodule.span ℤ (fourShortPointSet p v) ≤ fourProjectiveModule p v := by
  apply Submodule.span_le.mpr
  rintro x ⟨a,rfl⟩
  exact ⟨(fourFourierLift p v a.val).scalar,(fourFourierLift p v a.val).remainder,
    (fourFourierLift p v a.val).point_eq⟩

/-- The entire integral projective lattice is generated by supported short
Fourier points. This is equality of integer modules, not just rational span. -/
theorem fourPrime_short_span_eq_projective {p : ℕ} [Fact p.Prime] (m n : ℤ)
    (hp : (p : ℤ)=m*m+n*n) (hp100 : 100<p) (hp3 : (p : ZMod 3) ≠ 0)
    (h3 : (3 : ZMod p) ≠ 0) (hm : (m : ZMod p) ≠ 0) :
    Submodule.span ℤ (fourShortPointSet p (fourPrimeV m n))=
      fourProjectiveModule p (fourPrimeV m n) := by
  apply le_antisymm (four_short_span_le_projective _ _)
  rintro x ⟨a,z,hx⟩
  exact fourPrime_projective_mem_short_span m n hp hp100 hp3 h3 hm ⟨x,a,z,hx⟩

/-- A rational linear map taking integer generators to integer generators
preserves their integer span. -/
theorem four_linear_preserves_integer_span (T : FourRatPoint →ₗ[ℚ] FourRatPoint)
    (S : Set (Fin 4 → ℤ))
    (hT : ∀ x ∈ S, ∃ y ∈ S, T (fourIntToRat x)=fourIntToRat y)
    (x : Fin 4 → ℤ) (hx : x ∈ Submodule.span ℤ S) :
    ∃ y ∈ Submodule.span ℤ S, T (fourIntToRat x)=fourIntToRat y := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨y,hy,he⟩ := hT x hx
      exact ⟨y,Submodule.subset_span hy,he⟩
  | zero =>
      refine ⟨0,Submodule.zero_mem _,?_⟩
      have hz0 : fourIntToRat (0 : Fin 4 → ℤ)=(0 : FourRatPoint) := by
        ext i
        simp [fourIntToRat]
      rw [hz0,map_zero]
  | add x y hx hy ix iy =>
      obtain ⟨u,hu,he⟩ := ix
      obtain ⟨w,hw,hf⟩ := iy
      exact ⟨u+w,Submodule.add_mem _ hu hw,by rw [fourIntToRat_add,map_add,he,hf,fourIntToRat_add]⟩
  | smul c x hx ix =>
      obtain ⟨u,hu,he⟩ := ix
      exact ⟨c • u,Submodule.smul_mem _ c hu,
        by rw [fourIntToRat_int_smul,map_smul,he,fourIntToRat_int_smul]⟩

def fourResidueModule (p : ℕ) (v : Fin 4 → ℤ) : Submodule ℤ (Fin 4 → ℤ) where
  carrier := {x | (p : ℤ) ∣ fourDot v x}
  zero_mem' := by simp
  add_mem' := by
    intro x y hx hy
    change (p : ℤ) ∣ fourDot v (x+y)
    rw [fourDot_add_right]
    exact dvd_add hx hy
  smul_mem' := by
    intro c x hx
    change (p : ℤ) ∣ fourDot v (c • x)
    rw [fourDot_smul_right]
    exact dvd_mul_of_dvd_right hx c

theorem four_projective_pairing_dvd (p : ℕ) (v x y : Fin 4 → ℤ)
    (hx : x ∈ fourResidueModule p v) (hy : y ∈ fourProjectiveModule p v) :
    (p : ℤ) ∣ fourDot x y := by
  obtain ⟨a,z,hz⟩ := hy
  rw [hz,fourDot_add_right,fourDot_smul_right,fourDot_smul_right,fourDot_comm x v]
  exact dvd_add (dvd_mul_of_dvd_right hx a) (dvd_mul_right _ _)

theorem fourDot_single (x : FourRatPoint) (i : Fin 4) :
    fourDot x (Pi.single i (1 : ℚ))=x i := by
  fin_cases i <;> simp [fourDot]

/-- Duality recovers integrality as well as the residue condition: preserving
N forces the rational orthogonal involution to preserve L. -/
theorem four_involution_preserves_residue {p : ℕ} (hp : p ≠ 0)
    (v : Fin 4 → ℤ) (T : FourOrthogonalInvolution)
    (hN : ∀ x ∈ fourProjectiveModule p v, ∃ y ∈ fourProjectiveModule p v,
      T.linear (fourIntToRat x)=fourIntToRat y)
    (x : Fin 4 → ℤ) (hx : x ∈ fourResidueModule p v) :
    ∃ y ∈ fourResidueModule p v, T.linear (fourIntToRat x)=fourIntToRat y := by
  have hpair : ∀ z ∈ fourProjectiveModule p v, ∃ k : ℤ,
      fourDot (T.linear (fourIntToRat x)) (fourIntToRat z)=(p : ℚ)*(k : ℚ) := by
    intro z hz
    obtain ⟨w,hw,he⟩ := hN z hz
    obtain ⟨k,hk⟩ := four_projective_pairing_dvd p v x w hx hw
    have hd := T.dot_preserving (fourIntToRat x) (T.linear (fourIntToRat z))
    rw [T.involutive,he,fourDot_intToRat] at hd
    refine ⟨k,hd.trans ?_⟩
    exact_mod_cast hk
  have hcoords : ∀ i : Fin 4, ∃ k : ℤ, T.linear (fourIntToRat x) i=(k : ℚ) := by
    intro i
    obtain ⟨k,hk⟩ := hpair ((p : ℤ) • Pi.single i 1) (fourProjectiveModule_multiple p v _)
    have he : fourIntToRat ((p : ℤ) • Pi.single i 1)=(p : ℚ) • Pi.single i (1 : ℚ) := by
      ext j
      by_cases hj : j=i <;> simp [fourIntToRat,hj]
    rw [he,fourDot_smul_right,fourDot_single] at hk
    exact ⟨k,mul_left_cancel₀ (by exact_mod_cast hp : (p : ℚ) ≠ 0) hk⟩
  choose y hy using hcoords
  have he : T.linear (fourIntToRat x)=fourIntToRat y := funext hy
  refine ⟨y,?_,he⟩
  obtain ⟨k,hk⟩ := hpair v (fourProjectiveModule_base p v)
  rw [he,fourDot_intToRat] at hk
  have hki : fourDot y v=(p : ℤ)*k := by exact_mod_cast hk
  change (p : ℤ) ∣ fourDot v y
  rw [fourDot_comm]
  exact ⟨k,hki⟩

/-- A short-point pairing extends to preservation of both integer lattices. -/
theorem fourPrime_involution_preserves_lattices {p : ℕ} [Fact p.Prime] (m n : ℤ)
    (hp : (p : ℤ)=m*m+n*n) (hp100 : 100<p) (hp3 : (p : ZMod 3) ≠ 0)
    (h3 : (3 : ZMod p) ≠ 0) (hm : (m : ZMod p) ≠ 0) (T : FourOrthogonalInvolution)
    (hshort : ∀ x : FourShortIndex p (fourPrimeV m n),
      ∃ y : FourShortIndex p (fourPrimeV m n),
        T.linear (fourIntToRat (fourDualPoint p (fourPrimeV m n) x.val))=
          fourIntToRat (fourDualPoint p (fourPrimeV m n) y.val)) :
    (∀ x ∈ fourProjectiveModule p (fourPrimeV m n),
      ∃ y ∈ fourProjectiveModule p (fourPrimeV m n), T.linear (fourIntToRat x)=fourIntToRat y) ∧
    (∀ x ∈ fourResidueModule p (fourPrimeV m n),
      ∃ y ∈ fourResidueModule p (fourPrimeV m n), T.linear (fourIntToRat x)=fourIntToRat y) := by
  have hspan := fourPrime_short_span_eq_projective m n hp hp100 hp3 h3 hm
  have hN : ∀ x ∈ fourProjectiveModule p (fourPrimeV m n),
      ∃ y ∈ fourProjectiveModule p (fourPrimeV m n), T.linear (fourIntToRat x)=fourIntToRat y := by
    intro x hx
    rw [← hspan] at hx ⊢
    apply four_linear_preserves_integer_span T.linear _ _ x hx
    rintro z ⟨a,rfl⟩
    obtain ⟨b,hb⟩ := hshort a
    exact ⟨fourDualPoint p (fourPrimeV m n) b.val,⟨b,rfl⟩,hb⟩
  exact ⟨hN,four_involution_preserves_residue (Fact.out : p.Prime).ne_zero _ T hN⟩


/-- Actual coefficient vanishing gives a symmetry of both integral lattices,
with the analytic phase and character reversal retained on the short points. -/
theorem fourPrime_vanishing_lattice_involution {p m n R : ℕ} [Fact p.Prime]
    (hp : p=m^2+n^2) (hp100 : 100<p) (hnpos : 0<n) (hnm : n<m)
    (hbound : 2*(m+n)<p) (hR : R<p)
    (hz : PersistentFourVanishing p (fourPrimeFamilyIndices m n) R) :
    ∃ T : FourOrthogonalInvolution,
      (∀ x ∈ fourProjectiveModule p (fourPrimeV (m : ℤ) (n : ℤ)),
        ∃ y ∈ fourProjectiveModule p (fourPrimeV (m : ℤ) (n : ℤ)),
          T.linear (fourIntToRat x)=fourIntToRat y) ∧
      (∀ x ∈ fourResidueModule p (fourPrimeV (m : ℤ) (n : ℤ)),
        ∃ y ∈ fourResidueModule p (fourPrimeV (m : ℤ) (n : ℤ)),
          T.linear (fourIntToRat x)=fourIntToRat y) ∧
      (∀ x : FourShortIndex p (fourPrimeV (m : ℤ) (n : ℤ)),
        ∃ y : FourShortIndex p (fourPrimeV (m : ℤ) (n : ℤ)),
          T.linear (fourIntToRat (fourDualPoint p (fourPrimeV (m : ℤ) (n : ℤ)) x.val))=
            fourIntToRat (fourDualPoint p (fourPrimeV (m : ℤ) (n : ℤ)) y.val) ∧
          fourCanonicalPhase p (fourPrimeV (m : ℤ) (n : ℤ)) R y.val=
            fourCanonicalPhase p (fourPrimeV (m : ℤ) (n : ℤ)) R x.val+p ∧
          fourCubicCharacter y.val.2= -fourCubicCharacter x.val.2) := by
  obtain ⟨T,hT⟩ := fourPrime_vanishing_involution hp hp100 hnpos hnm hbound hR hz
  have hprime : p.Prime := Fact.out
  have hpi : (p : ℤ)=(m : ℤ)*(m : ℤ)+(n : ℤ)*(n : ℤ) := by
    exact_mod_cast (show p=m*m+n*n by simpa only [pow_two] using hp)
  have hp3 : (p : ZMod 3) ≠ 0 := by
    apply (ZMod.natCast_eq_zero_iff p 3).not.mpr
    intro hd
    rcases (Nat.dvd_prime hprime).mp hd with h | h <;> omega
  have h3 : (3 : ZMod p) ≠ 0 :=
    (ZMod.natCast_eq_zero_iff 3 p).not.mpr (Nat.not_dvd_of_pos_of_lt (by decide) (by omega))
  have hm : ((m : ℤ) : ZMod p) ≠ 0 := by
    simpa only [Int.cast_natCast] using (ZMod.natCast_eq_zero_iff m p).not.mpr
      (Nat.not_dvd_of_pos_of_lt (by omega) (by omega))
  obtain ⟨hN,hL⟩ := fourPrime_involution_preserves_lattices m n hpi hp100 hp3 h3 hm T (by
    intro x
    obtain ⟨y,hy⟩ := hT x
    exact ⟨y,hy.1⟩)
  exact ⟨T,hN,hL,hT⟩

end Ramanujan.MultiQuintuple

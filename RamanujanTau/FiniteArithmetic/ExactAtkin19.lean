/-- **Exactness of the Atkin–O'Brien recurrence at `ℓ = 19`**: for every `b ≥ 1`, no scalar `c`
gives `19^(b+1) ∣ L(b+2) − c L(b)`. -/
theorem exact : ∀ b, 1 ≤ b → ∀ c : ℤ_[19], ¬ Dvd ((19 : ℕ) : ℤ_[19]) (b + 1) (Ll 19 (b + 2) - c • Ll 19 b) := by
  obtain ⟨hUB, hDB⟩ := SmallThreshold.ub_db (ℓ := 19) (by norm_num) (by norm_num)
  obtain ⟨κ, -, hser⟩ := L_padic (ℓ := 19) (by norm_num) (by norm_num) (by norm_num) Cert19.h24 10
    Cert19.f Cert19.form_f Cert19.coeff_zero_f coeff_one_19 Cert19.rank_one Cert19.two_step hUB hDB
  have hbase := SmallThreshold.fail_of_detOk Cert19.h24 8289 100 4 23 1429 8288
      (by norm_num) (by norm_num) (by norm_num) (by rw [SmallThreshold.pentLow100]; norm_num)
      (by norm_num [eB, ek]) (by norm_num [eB, ek]) (by norm_num [eB, ek]) (by norm_num [eB, ek])
      (by norm_num) SmallThreshold.cert19
  obtain ⟨DU⟩ := stepU
  obtain ⟨DD⟩ := stepD
  exact exact_of_model hℓ (by norm_num) (by norm_num) Cert19.h24 hUB hDB κ hser Cert19.f Cert19.form_f
    Cert19.coeff_zero_f coeff_one_19 Cert19.rank_one hbase B hB hB0 hspan w hw0 hwf DU DD


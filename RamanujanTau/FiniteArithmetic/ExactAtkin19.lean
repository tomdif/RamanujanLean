theorem hspan (a : PowerSeries ℤ) (ha : IntForm ((2 * (19 - 1) : ℕ) : ℤ) a) (ha0 : coeff 0 (Ψ 19 a) = 0) :
    ∃ c : Fin 3 → ZMod 19, Ψ 19 a =
      ∑ k, C (c k) * PowerSeries.map (PadicInt.toZMod (p := 19)) (ModP.ev ℤ_[19] (B k)) := by
  set c0 : ZMod 19 := coeff 1 (Ψ 19 a) with hc0
  set c1 : ZMod 19 := coeff 2 (Ψ 19 a) - c0 * 10 with hc1
  set c2 : ZMod 19 := coeff 3 (Ψ 19 a) - c0 * 2 - c1 * 7 with hc2
  refine ⟨![c0, c1, c2], ?_⟩
  simp only [hev, map_map_int, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Matrix.cons_val_zero,
    Matrix.cons_val_succ, Matrix.cons_val_one, Matrix.head_cons, add_zero, Fin.succ_zero_eq_one,
    Fin.succ_one_eq_two]
  set rr := a - PowerSeries.C ((c0.val : ℕ) : ℤ) * bs 0 - PowerSeries.C ((c1.val : ℕ) : ℤ) * bs 1 - PowerSeries.C ((c2.val : ℕ) : ℤ) * bs 2 with hrr
  have hr : IntForm ((2 * (19 - 1) : ℕ) : ℤ) rr :=
    (((ha.sub ((form_bs 0).C_mul _)).sub ((form_bs 1).C_mul _)).sub ((form_bs 2).C_mul _))
  have hΨ : Ψ 19 rr = Ψ 19 a - C c0 * Ψ 19 (bs 0) - C c1 * Ψ 19 (bs 1) - C c2 * Ψ 19 (bs 2) := by
    simp only [hrr, map_sub, map_mul, PowerSeries.map_C, Int.coe_castRingHom, Int.cast_natCast,
      ZMod.natCast_zmod_val]
  have hz : Ψ 19 rr = 0 := by
    apply sturm 19 4 _ (by norm_num) rr hr
    rw [show (((2 * (19 - 1) : ℕ) : ℤ)).toNat / 12 + 1 = 4 by decide, PowerSeries.X_pow_dvd_iff]
    intro m hm
    rw [hΨ]
    simp only [map_sub, coeff_C_mul]
    interval_cases m
    · rw [b0_c0, b1_c0, b2_c0]
      simp only [hc2, hc1, hc0, ha0]
      ring
    · rw [b0_c1, b1_c1, b2_c1]
      simp only [hc2, hc1, hc0]
      ring
    · rw [b0_c2, b1_c2, b2_c2]
      simp only [hc2, hc1, hc0]
      ring
    · rw [b0_c3, b1_c3, b2_c3]
      simp only [hc2, hc1, hc0]
      ring
  rw [hΨ] at hz
  linear_combination hz


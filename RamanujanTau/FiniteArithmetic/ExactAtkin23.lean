/-- **Exactness of the Atkin–O'Brien recurrence at `ℓ = 23`**: for every `b ≥ 1`, no scalar `c`
gives `23^(b+1) ∣ L(b+2) − c L(b)`. -/
theorem exact : ∀ b, 1 ≤ b → ∀ c : ℤ_[23], ¬ Dvd ((23 : ℕ) : ℤ_[23]) (b + 1) (Ll 23 (b + 2) - c • Ll 23 b) := by
  obtain ⟨hUB, hDB⟩ := SmallThreshold.ub_db (ℓ := 23) (by norm_num) (by norm_num)
  obtain ⟨κ, -, hser⟩ := L_padic (ℓ := 23) (by norm_num) (by norm_num) (by norm_num) Cert23.h24 5
    Cert23.f Cert23.form_f Cert23.coeff_zero_f coeff_one_23 Cert23.rank_one Cert23.two_step hUB hDB
  have hbase := SmallThreshold.fail_of_detOk Cert23.h24 12675 100 1 24 507 12674
      (by norm_num) (by norm_num) (by norm_num) (by rw [SmallThreshold.pentLow100]; norm_num)
      (by norm_num [eB, ek]) (by norm_num [eB, ek]) (by norm_num [eB, ek]) (by norm_num [eB, ek])
      (by norm_num) SmallThreshold.cert23
  obtain ⟨DU⟩ := stepU
  obtain ⟨DD⟩ := stepD
  exact exact_of_model hℓ (by norm_num) (by norm_num) Cert23.h24 hUB hDB κ hser Cert23.f Cert23.form_f
    Cert23.coeff_zero_f coeff_one_23 Cert23.rank_one hbase B hB hB0 hspan w hw0 hwf DU DD

end RamanujanTau.FiniteArithmetic.ExactAtkin23

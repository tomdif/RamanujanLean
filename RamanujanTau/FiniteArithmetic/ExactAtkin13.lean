/-- **Exactness of the Atkin–O'Brien recurrence at `ℓ = 13`**: for every `b ≥ 1`, no scalar `c`
gives `13^(b+1) ∣ L(b+2) − c L(b)`. -/
theorem exact : ∀ b, 1 ≤ b → ∀ c : ℤ_[13], ¬ Dvd ((13 : ℕ) : ℤ_[13]) (b + 1) (Ll 13 (b + 2) - c • Ll 13 b) := by
  obtain ⟨hUB, hDB⟩ := SmallThreshold.ub_db (ℓ := 13) (by norm_num) (by norm_num)
  obtain ⟨κ, -, hser⟩ := L_padic (ℓ := 13) (by norm_num) (by norm_num) (by norm_num) Cert13.h24 6
    Cert13.f Cert13.form_f Cert13.coeff_zero_f coeff_one_13 Cert13.rank_one Cert13.two_step hUB hDB
  have hbase := SmallThreshold.fail_of_detOk Cert13.h24 3205 100 6 19 1007 3204
      (by norm_num) (by norm_num) (by norm_num) (by rw [SmallThreshold.pentLow100]; norm_num)
      (by norm_num [eB, ek]) (by norm_num [eB, ek]) (by norm_num [eB, ek]) (by norm_num [eB, ek])
      (by norm_num) SmallThreshold.cert13
  obtain ⟨DU⟩ := stepU
  obtain ⟨DD⟩ := stepD
  exact exact_of_model hℓ (by norm_num) (by norm_num) Cert13.h24 hUB hDB κ hser Cert13.f Cert13.form_f
    Cert13.coeff_zero_f coeff_one_13 Cert13.rank_one hbase B hB hB0 hspan w hw0 hwf DU DD


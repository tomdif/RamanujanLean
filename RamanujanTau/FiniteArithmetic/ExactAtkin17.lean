/-- **Exactness of the Atkin–O'Brien recurrence at `ℓ = 17`**: for every `b ≥ 1`, no scalar `c`
gives `17^(b+1) ∣ L(b+2) − c L(b)`. -/
theorem exact : ∀ b, 1 ≤ b → ∀ c : ℤ_[17], ¬ Dvd ((17 : ℕ) : ℤ_[17]) (b + 1) (Ll 17 (b + 2) - c • Ll 17 b) := by
  obtain ⟨hUB, hDB⟩ := SmallThreshold.ub_db (ℓ := 17) (by norm_num) (by norm_num)
  obtain ⟨κ, -, hser⟩ := L_padic (ℓ := 17) (by norm_num) (by norm_num) (by norm_num) Cert17.h24 6
    Cert17.f Cert17.form_f Cert17.coeff_zero_f coeff_one_17 Cert17.rank_one Cert17.two_step hUB hDB
  have hbase := SmallThreshold.fail_of_detOk Cert17.h24 6347 100 5 22 1433 6346
      (by norm_num) (by norm_num) (by norm_num) (by rw [SmallThreshold.pentLow100]; norm_num)
      (by norm_num [eB, ek]) (by norm_num [eB, ek]) (by norm_num [eB, ek]) (by norm_num [eB, ek])
      (by norm_num) SmallThreshold.cert17
  obtain ⟨DU⟩ := stepU
  obtain ⟨DD⟩ := stepD
  exact exact_of_model hℓ (by norm_num) (by norm_num) Cert17.h24 hUB hDB κ hser Cert17.f Cert17.form_f
    Cert17.coeff_zero_f coeff_one_17 Cert17.rank_one hbase B hB hB0 hspan w hw0 hwf DU DD


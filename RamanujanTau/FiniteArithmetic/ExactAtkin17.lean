lemma hcvU (k : Fin 2) (m : ℕ) (hm : m < 3) :
    PadicInt.toZModPow 2 (coeff m (Ulin 17 ((fun k => ModP.ev ℤ_[17] (B k) * Einv 17 hℓ ^ 2) k))) =

theorem hspan (a : PowerSeries ℤ) (ha : IntForm ((2 * (17 - 1) : ℕ) : ℤ) a) (ha0 : coeff 0 (Ψ 17 a) = 0) :
    ∃ c : Fin 2 → ZMod 17, Ψ 17 a =
      ∑ k, C (c k) * PowerSeries.map (PadicInt.toZMod (p := 17)) (ModP.ev ℤ_[17] (B k)) := by
  set c0 : ZMod 17 := coeff 1 (Ψ 17 a) with hc0
  set c1 : ZMod 17 := coeff 2 (Ψ 17 a) - c0 * 3 with hc1
  refine ⟨![c0, c1], ?_⟩
  simp only [hev, map_map_int, Fin.sum_univ_succ, Fin.sum_univ_zero, Fin.isValue, Matrix.cons_val_zero,
    Matrix.cons_val_succ, Matrix.cons_val_one, Matrix.head_cons, add_zero, Fin.succ_zero_eq_one,
    Fin.succ_one_eq_two]
  set rr := a - PowerSeries.C ((c0.val : ℕ) : ℤ) * bs 0 - PowerSeries.C ((c1.val : ℕ) : ℤ) * bs 1 with hrr
  have hr : IntForm ((2 * (17 - 1) : ℕ) : ℤ) rr :=
    ((ha.sub ((form_bs 0).C_mul _)).sub ((form_bs 1).C_mul _))
  have hΨ : Ψ 17 rr = Ψ 17 a - C c0 * Ψ 17 (bs 0) - C c1 * Ψ 17 (bs 1) := by
    simp only [hrr, map_sub, map_mul, PowerSeries.map_C, Int.coe_castRingHom, Int.cast_natCast,
      ZMod.natCast_zmod_val]
  have hz : Ψ 17 rr = 0 := by
    apply sturm 17 3 _ (by norm_num) rr hr
    rw [show (((2 * (17 - 1) : ℕ) : ℤ)).toNat / 12 + 1 = 3 by decide, PowerSeries.X_pow_dvd_iff]
    intro m hm
    rw [hΨ]
    simp only [map_sub, coeff_C_mul]
    interval_cases m
    · rw [b0_c0, b1_c0]
      simp only [hc1, hc0, ha0]
      ring
    · rw [b0_c1, b1_c1]
      simp only [hc1, hc0]
      ring
    · rw [b0_c2, b1_c2]
      simp only [hc1, hc0]
      ring
  rw [hΨ] at hz
  linear_combination hz

def w : Fin 1 → ℕ → ℤ := ![fun m => if m = 0 then 0 else if m = 1 then 5 else if m = 2 then 1 else 0]

lemma hw0 : ∀ j, w j 0 = 0 := by intro j; fin_cases j <;> rfl
lemma hwf : ∀ j, ∑ m ∈ Finset.range 3, (w j m : ZMod 17) * coeff m (Ψ 17 Cert17.f) = 0 := by
  intro j
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add]
  rw [Cg_coeff cgl_f (show 0 ≤ 34 by norm_num), Cg_coeff cgl_f (show 1 ≤ 34 by norm_num), Cg_coeff cgl_f (show 2 ≤ 34 by norm_num)]
  fin_cases j <;> decide


set_option maxRecDepth 100000 in
/-- The single kernel evaluation of all lanes. -/
theorem ok_eq : ok P T = true := by decide +kernel

theorem sizes : Sizes P := ⟨by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide⟩

theorem identities : Identities 37 T X := ⟨by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide⟩

/-- **`b_37(m) = 2m − 1` for every `m ≥ 1`** (Boylan–Webb's literal invariant). -/
theorem bEll_37 (m : ℕ) (hm : 1 ≤ m) : BLBound.bEll 37 m = 2 * m - 1 :=
  @bEll_of_ok P T X (inferInstanceAs (Fact (Nat.Prime 37))) sizes identities ok_eq m hm

end RamanujanTau.FiniteArithmetic.Rank2At37

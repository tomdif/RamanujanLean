set_option autoImplicit false
namespace RamanujanTau.FiniteArithmetic.Rank2At37
open Rank2Packed

instance : Fact (Nat.Prime 37) := ⟨by norm_num⟩

def P : Params := ⟨37, 4108, 20, 37^2 * (2^18 / 37^2), 6, 1, 13, 12, 18, 33, ![(1, 6, 0), (2, 3, 0), (3, 0, 0)]⟩

def T : Table := ⟨![![1, 0, 0], ![10, 1, 0], ![14, 6, 1]],
  ![![4, 1, 9], ![21, 31, 5], ![5, 15, 11]],
  ![![0, 0, 0], ![21, 15, 13], ![27, 6, 22]],
  ![0, 1, 17], ![1, 29, 22], ![17, 28, 15], 28⟩


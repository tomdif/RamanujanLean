set_option maxRecDepth 100000 in
/-- The single kernel evaluation of all lanes. -/
theorem ok_eq : ok P T = true := by decide +kernel

theorem sizes : Sizes P := ⟨by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide⟩

theorem identities : Identities 41 T X := ⟨by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide⟩

/-- **`b_41(m) = 2m − 1` for every `m ≥ 1`** (Boylan–Webb's literal invariant). -/
theorem bEll_41 (m : ℕ) (hm : 1 ≤ m) : BLBound.bEll 41 m = 2 * m - 1 :=
  @bEll_of_ok P T X (inferInstanceAs (Fact (Nat.Prime 41))) sizes identities ok_eq m hm


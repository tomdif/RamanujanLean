set_option autoImplicit false
namespace RamanujanTau.FiniteArithmetic.Rank2At41
open Rank2Packed

instance : Fact (Nat.Prime 41) := ⟨by norm_num⟩

def P : Params := ⟨41, 5044, 29, 41^2 * (2^18 / 41^2), 6, 1, 13, 12, 18, 33, ![(1, 7, 0), (2, 4, 0), (3, 1, 0)]⟩

def T : Table := ⟨![![1, 0, 0], ![16, 1, 0], ![39, 10, 1]],
  ![![36, 9, 24], ![20, 24, 22], ![39, 36, 10]],
  ![![0, 0, 0], ![0, 23, 29], ![12, 22, 31]],

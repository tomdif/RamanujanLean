      quintupleSpecialized 13 3 * quintupleSpecialized 13 5) = fourPrimeSmall13ShortCoeff K := by
  rw [coeff_quad_eq_finiteBox 13 1 2 3 5 K
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
  unfold fourPrimeSmall13ShortCoeff
  apply Finset.sum_congr_of_eq_on_inter
  · intro x hx hnx
    by_contra hn
    have he : quadExp2 13 1 2 3 5 x = 2*(K : ℤ) := by
      by_contra h; simp [quadContribution,h] at hn
    exact hnx (mem_short_box13 K hK x he)
  · intro x hx hnx
    by_contra hn
    have he : quadExp2 13 1 2 3 5 x = 2*(K : ℤ) := by
      by_contra h; simp [quadContribution,h] at hn
    exact hnx (mem_quadBox_of_exp 13 1 2 3 5 K x
      (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) he)

  · intro x hx hy; rfl



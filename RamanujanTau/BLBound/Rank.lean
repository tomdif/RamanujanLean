import RamanujanTau.BLBound.Dim

/-!
# The rank of `X̄` and the bound of Folsom–Kent–Ono

For every prime `ℓ ≥ 13`, with `R = ⌊(ℓ+12)/24⌋`:

* `X̄^k` has rank `R` on `S̄` for all `k ≥ 1`, and `D̄(S̄) = V̄`;
* the polynomial `χ` of `exists_chi` has degree `R`;
* `Λ^odd(b,m)` is generated by at most `R` elements for `b ≥ 2m-1`.

For the last, dividing by `ℓ` and applying `X` alternate as in `chi_main`, so the `ℓ`-torsion of the module
injects into `V̄`. The number of generators of a finite abelian `ℓ`-group is the rank of its `ℓ`-torsion.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanTau.BLBound
open PowerSeries AtkinOBrien AtkinOBrienFinal BoylanWebb
open RamanujanTau.TheoremA.HalfIntegral

noncomputable section

variable {ℓ : ℕ} [hℓ : Fact ℓ.Prime]

/-! ### The operators on `V̄` and `S̄` -/

lemma Tv_bijective (h13 : 13 ≤ ℓ) : Function.Bijective (Tv (ℓ := ℓ) h13) := by
  haveI := finite_Vbar (ℓ := ℓ) h13
  have hinj : Function.Injective (Tv (ℓ := ℓ) h13) := by
    rw [injective_iff_map_eq_zero]
    rintro ⟨v, hv⟩ h
    apply Subtype.ext
    exact Xbar_inj h13 hv (congrArg Subtype.val h)
  exact ⟨hinj, LinearMap.injective_iff_surjective.mp hinj⟩

lemma Xbar_pow_mem (h13 : 13 ≤ ℓ) (k : ℕ) {v : PowerSeries (ZMod ℓ)} (hv : v ∈ Vbar ℓ) :
    (Xbar ℓ ^ k) v ∈ Vbar ℓ := by
  induction k with
  | zero => simpa using hv
  | succ k ih =>
    rw [pow_succ', Module.End.mul_apply]
    exact Xbar_mem h13 ih

/-- `X̄^k` maps `V̄` onto `V̄`. -/
lemma Xbar_pow_surj (h13 : 13 ≤ ℓ) (k : ℕ) {v : PowerSeries (ZMod ℓ)} (hv : v ∈ Vbar ℓ) :
    ∃ w ∈ Vbar ℓ, (Xbar ℓ ^ k) w = v := by
  induction k generalizing v with
  | zero => exact ⟨v, hv, by simp⟩
  | succ k ih =>
    obtain ⟨⟨u, hu⟩, hw⟩ := (Tv_bijective (ℓ := ℓ) h13).2 ⟨v, hv⟩
    obtain ⟨w, hw', he⟩ := ih hu
    refine ⟨w, hw', ?_⟩
    rw [pow_succ', Module.End.mul_apply, he]
    exact congrArg Subtype.val hw

/-- **The image of `X̄^k` on `S̄` is `V̄`.** -/
theorem map_Xbar_pow_Sbar (h13 : 13 ≤ ℓ) (k : ℕ) (hk : 1 ≤ k) :
    (Sbar ℓ).map (Xbar ℓ ^ k) = Vbar ℓ := by
  apply le_antisymm
  · rintro _ ⟨v, hv, rfl⟩
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    rw [pow_succ, Module.End.mul_apply]
    exact Xbar_pow_mem h13 j (Xbar_range h13 hv)
  · intro v hv
    obtain ⟨w, hw, he⟩ := Xbar_pow_surj h13 k hv
    exact ⟨w, Vbar_le_Sbar h13 hw, he⟩

/-- **`X̄^k` has rank `⌊(ℓ+12)/24⌋` on `S̄`, for all `k ≥ 1`.** -/
theorem rank_Xbar_pow (h13 : 13 ≤ ℓ) (k : ℕ) (hk : 1 ≤ k) :
    Module.finrank (ZMod ℓ) ((Sbar ℓ).map (Xbar ℓ ^ k)) = (ℓ + 12) / 24 := by
  rw [map_Xbar_pow_Sbar h13 k hk, finrank_Vbar h13]

/-- **`D̄` maps `S̄` onto `V̄`.** -/
theorem map_Dbar_Sbar (h13 : 13 ≤ ℓ) : (Sbar ℓ).map (Dbar ℓ) = Vbar ℓ := by
  apply le_antisymm
  · rintro _ ⟨v, hv, rfl⟩
    obtain ⟨a, ha, he⟩ := D_image h13 hv.1
    exact ⟨a, ha, he⟩
  · intro v hv
    obtain ⟨⟨u, hu⟩, hw⟩ := (Tv_bijective (ℓ := ℓ) h13).2 ⟨v, hv⟩
    have hS := Vbar_le_Sbar h13 hu
    refine ⟨U ℓ u, ⟨U_mem_formBar h13 hS, ?_⟩, congrArg Subtype.val hw⟩
    rw [coeff_U, mul_zero]
    exact hS.2

/-- **The polynomial `χ` has degree `⌊(ℓ+12)/24⌋`.** -/
theorem exists_chi_R (h13 : 13 ≤ ℓ) : ∃ χ : Polynomial ℤ, χ.Monic ∧ ¬ (ℓ : ℤ) ∣ χ.coeff 0 ∧
    χ.natDegree = (ℓ + 12) / 24 ∧
    ∀ v ∈ Vbar ℓ, Polynomial.aeval (Xbar ℓ) (χ.map (Int.castRingHom (ZMod ℓ))) v = 0 := by
  obtain ⟨χ, h1, h2, h3, h4⟩ := exists_chi_deg (ℓ := ℓ) h13
  exact ⟨χ, h1, h2, by rw [h3, finrank_Vbar h13], h4⟩

/-- **`R = ⌈d/2⌉`, where `d = dim S̄`.** -/
theorem R_eq_half (h13 : 13 ≤ ℓ) : (Module.finrank (ZMod ℓ) (Sbar ℓ) + 1) / 2 = (ℓ + 12) / 24 := by
  have h := finrank_Sbar (ℓ := ℓ) h13
  have hj := ell_mod (ℓ := ℓ) h13
  have hd := ell_decomp (ℓ := ℓ)
  unfold monoCount at h
  rcases hj with h' | h' | h' | h' | h' | h' | h' | h' <;> omega

/-- **The kernel of `X̄` on `S̄` has dimension `⌊d/2⌋`.** -/
theorem finrank_ker_Xbar (h13 : 13 ≤ ℓ) :
    Module.finrank (ZMod ℓ) (LinearMap.ker ((Xbar ℓ).domRestrict (Sbar ℓ))) + (ℓ + 12) / 24 =
      Module.finrank (ZMod ℓ) (Sbar ℓ) := by
  haveI := finite_Sbar (ℓ := ℓ) h13
  have h := LinearMap.finrank_range_add_finrank_ker ((Xbar ℓ).domRestrict (Sbar ℓ))
  have hr : LinearMap.range ((Xbar ℓ).domRestrict (Sbar ℓ)) = (Sbar ℓ).map (Xbar ℓ ^ 1) := by
    rw [LinearMap.range_domRestrict, pow_one]
  rw [hr, rank_Xbar_pow h13 1 le_rfl] at h
  omega

/-! ### Finite abelian groups -/

/-- A finite vector space over `ℤ/p` is spanned by a family whose length is its dimension. -/
lemma exists_span_fin {Q : Type*} [AddCommGroup Q] {p : ℕ} [hp : Fact p.Prime] [Module (ZMod p) Q] [Finite Q] :
    ∃ (d : ℕ) (e : Fin d → Q), Nat.card Q = p ^ d ∧ Submodule.span (ZMod p) (Set.range e) = ⊤ := by
  haveI : Module.Finite (ZMod p) Q := Module.Finite.of_finite
  refine ⟨_, Module.finBasis (ZMod p) Q, ?_, (Module.finBasis (ZMod p) Q).span_eq⟩
  rw [Module.natCard_eq_pow_finrank (K := ZMod p), Nat.card_zmod]

/-- An additive subgroup containing a spanning family over `ℤ/p` is everything. -/
lemma mem_of_span_zmod {Q : Type*} [AddCommGroup Q] {p d : ℕ} [hp : Fact p.Prime] [Module (ZMod p) Q]
    (H : AddSubgroup Q) (e : Fin d → Q) (he : ∀ i, e i ∈ H)
    (hspan : Submodule.span (ZMod p) (Set.range e) = ⊤) (x : Q) : x ∈ H := by
  have hx : x ∈ Submodule.span (ZMod p) (Set.range e) := by
    rw [hspan]
    exact Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨i, rfl⟩ := hy
    exact he i
  | zero => exact H.zero_mem
  | add y z _ _ hy hz => exact H.add_mem hy hz
  | smul c y _ hy =>
    rw [← ZMod.natCast_zmod_val c, Nat.cast_smul_eq_nsmul]
    exact H.nsmul_mem hy _

/-- Nakayama: a subgroup of a group killed by `p^m` is everything if it is everything modulo `p`. -/
lemma top_of_gen {A : Type*} [AddCommGroup A] {p m : ℕ} (hm : ∀ x : A, (p ^ m) • x = 0) (H : AddSubgroup A)
    (hgen : ∀ x : A, ∃ h ∈ H, ∃ y : A, x = h + p • y) : H = ⊤ := by
  have hiter : ∀ k : ℕ, ∀ x : A, ∃ h ∈ H, ∃ y : A, x = h + (p ^ k) • y := by
    intro k
    induction k with
    | zero => exact fun x => ⟨0, H.zero_mem, x, by simp⟩
    | succ k ih =>
      intro x
      obtain ⟨h, hh, y, rfl⟩ := ih x
      obtain ⟨h', hh', y', rfl⟩ := hgen y
      refine ⟨h + (p ^ k) • h', H.add_mem hh (H.nsmul_mem hh' _), y', ?_⟩
      rw [smul_add, smul_smul, pow_succ]
      abel
  rw [eq_top_iff]
  intro x _
  obtain ⟨h, hh, y, rfl⟩ := hiter m x
  rw [hm, add_zero]
  exact hh

/-- The quotient by `p` has as many elements as the `p`-torsion. -/
lemma card_quot_eq {A : Type*} [AddCommGroup A] [Finite A] (p : ℕ) :
    Nat.card (A ⧸ (nsmulAddMonoidHom p : A →+ A).range) = Nat.card {x : A // p • x = 0} := by
  set f : A →+ A := nsmulAddMonoidHom p
  have h1 := AddSubgroup.card_mul_index f.ker
  have h2 := AddSubgroup.card_mul_index f.range
  rw [AddSubgroup.index_ker] at h1
  have hpos : 0 < Nat.card f.range := Nat.card_pos
  have : Nat.card f.range * f.range.index = Nat.card f.range * Nat.card f.ker := by
    rw [h2, ← h1, mul_comm]
  exact Nat.eq_of_mul_eq_mul_left hpos this

/-- A finite abelian group killed by `p^m`, with at most `p^R` elements of order dividing `p`, is
generated by at most `R` elements. -/
lemma gens_of_socle {A : Type*} [AddCommGroup A] [Finite A] {p m R : ℕ} [hp : Fact p.Prime]
    (hm : ∀ x : A, (p ^ m) • x = 0) (hc : Nat.card {x : A // p • x = 0} ≤ p ^ R) :
    ∃ s : Finset A, s.card ≤ R ∧ AddSubgroup.closure (s : Set A) = ⊤ := by
  classical
  let f : A →+ A := nsmulAddMonoidHom p
  have hQ : ∀ x : A ⧸ f.range, p • x = 0 := by
    intro x
    obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective x
    rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff]
    exact ⟨a, rfl⟩
  letI : Module (ZMod p) (A ⧸ f.range) := AddCommGroup.zmodModule hQ
  obtain ⟨d, e, hde, hspan⟩ := exists_span_fin (Q := A ⧸ f.range) (p := p)
  have hd : d ≤ R := by
    rw [card_quot_eq] at hde
    rw [hde] at hc
    exact (Nat.pow_le_pow_iff_right hp.out.one_lt).mp hc
  have hlift : ∀ i, ∃ a : A, (QuotientAddGroup.mk a : A ⧸ f.range) = e i := fun i =>
    QuotientAddGroup.mk_surjective _
  choose a ha using hlift
  refine ⟨Finset.univ.image a, Finset.card_image_le.trans (by simpa using hd), ?_⟩
  set H := AddSubgroup.closure ((Finset.univ.image a : Finset A) : Set A) with hH
  have hgen : ∀ x : A, ∃ h ∈ H, ∃ y : A, x = h + p • y := by
    intro x
    let H' : AddSubgroup (A ⧸ f.range) := H.map (QuotientAddGroup.mk' f.range)
    have hx : (QuotientAddGroup.mk x : A ⧸ f.range) ∈ H' :=
      mem_of_span_zmod (p := p) H' e (fun i => ⟨a i, AddSubgroup.subset_closure (by simp), ha i⟩) hspan _
    obtain ⟨h, hh, he⟩ := hx
    obtain ⟨y, hy⟩ := QuotientAddGroup.eq.mp he
    refine ⟨h, hh, y, ?_⟩
    have hy' : p • y = -h + x := hy
    rw [hy']
    abel
  exact top_of_gen hm H hgen

/-! ### Division by `ℓ` in the envelope -/

/-- Dividing by `ℓ^n` costs `n` applications of `X`. -/
theorem X_pow_div (h13 : 13 ≤ ℓ) (h5 : 5 ≤ ℓ) (n : ℕ) {F G : PS ℓ} (hF : F ∈ B h5 1)
    (h : F = ((ℓ : ℤ_[ℓ]) ^ n) • G) : (Xop ℓ ^ n) G ∈ B h5 1 := by
  induction n generalizing F G with
  | zero => simpa [h] using hF
  | succ n ih =>
    have hF2 : ((ℓ : ℤ_[ℓ]) ^ n) • G ∈ B h5 2 :=
      B_div h5 hF (by rw [h, pow_succ', mul_smul])
    have hX := X_mem h13 h5 (by norm_num) hF2
    rw [map_smul] at hX
    have := ih hX rfl
    rwa [pow_succ, Module.End.mul_apply]

/-- `X` of an element of the envelope reduces into `V̄`. -/
lemma red_X_mem (h13 : 13 ≤ ℓ) (h5 : 5 ≤ ℓ) {y : PS ℓ} (hy : y ∈ B h5 1) : red ℓ (Xop ℓ y) ∈ Vbar ℓ := by
  obtain ⟨hU, -⟩ := bounds h13 h5
  have hUe : Env ℓ h5 1 (α ℓ) (Ulin ℓ y) := U_env h5 h13 hU 1 (by norm_num) _ hy.2
  exact red_D_mem h13 (env_formBar h5 (α ℓ) (fun i hi => (envelopes_ge_two h13 i hi).1) _ hUe)

/-! ### Reduction modulo `ℓ^m` -/

/-- Reduction of `ℓ`-adic series modulo `ℓ^m`. -/
abbrev redP (ℓ : ℕ) [Fact ℓ.Prime] (m : ℕ) : PS ℓ →+* PowerSeries (Rm ℓ m) :=
  PowerSeries.map (PadicInt.toZModPow (p := ℓ) m)

lemma redP_X (m : ℕ) (f : PS ℓ) : redP ℓ m (Xop ℓ f) = Xm ℓ m (redP ℓ m f) := by
  have hΦ : redP ℓ m (Φl ℓ) = redm ℓ m (Φ ℓ) := by
    ext n
    simp [Φl, PowerSeries.coeff_map]
  change redP ℓ m (U ℓ (Φl ℓ * U ℓ f)) = U ℓ (redm ℓ m (Φ ℓ) * U ℓ (redP ℓ m f))
  rw [map_U, map_mul, map_U, hΦ]

lemma redP_pow_X (m k : ℕ) (f : PS ℓ) : redP ℓ m ((Xop ℓ ^ k) f) = (Xm ℓ m ^ k) (redP ℓ m f) := by
  induction k with
  | zero => simp
  | succ k ih => rw [pow_succ', pow_succ', Module.End.mul_apply, Module.End.mul_apply, redP_X, ih]

lemma redP_smul (m : ℕ) (c : ℤ_[ℓ]) (f : PS ℓ) :
    redP ℓ m (c • f) = (PadicInt.toZModPow (p := ℓ) m c) • redP ℓ m f := by
  rw [PowerSeries.smul_eq_C_mul, PowerSeries.smul_eq_C_mul, map_mul, PowerSeries.map_C]

lemma redP_eq_zero (m : ℕ) {f : PS ℓ} (h : redP ℓ m f = 0) : ∃ H : PS ℓ, f = ((ℓ : ℤ_[ℓ]) ^ m) • H := by
  have hc : ∀ n, ∃ c : ℤ_[ℓ], PowerSeries.coeff n f = (ℓ : ℤ_[ℓ]) ^ m * c := by
    intro n
    have h0 : PadicInt.toZModPow (p := ℓ) m (PowerSeries.coeff n f) = 0 := by
      have := congrArg (PowerSeries.coeff n) h
      rwa [PowerSeries.coeff_map, map_zero] at this
    have hk : PowerSeries.coeff n f ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) m) := h0
    rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton] at hk
    obtain ⟨c, hc⟩ := hk
    exact ⟨c, by rw [hc]⟩
  choose c hc using hc
  refine ⟨PowerSeries.mk c, ?_⟩
  ext n
  rw [PowerSeries.coeff_smul, PowerSeries.coeff_mk, hc, smul_eq_mul]

/-- Elements of `Λ^odd` come from the envelope. -/
lemma exists_lift (h13 : 13 ≤ ℓ) (h5 : 5 ≤ ℓ) (m b : ℕ) {v : PowerSeries (Rm ℓ m)} (hv : v ∈ Lam ℓ m b) :
    ∃ F ∈ B h5 1, redP ℓ m F = v := by
  haveI : NeZero (ℓ ^ m) := ⟨pow_ne_zero m hℓ.out.ne_zero⟩
  have hXpow : ∀ n : ℕ, ∀ {G : PS ℓ}, G ∈ B h5 1 → (Xop ℓ ^ n) G ∈ B h5 1 := by
    intro n
    induction n with
    | zero => intro G hG; simpa using hG
    | succ n ih =>
      intro G hG
      rw [pow_succ', Module.End.mul_apply]
      exact X_mem h13 h5 (by norm_num) (ih hG)
  induction hv using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨k, -, rfl⟩ := hx
    refine ⟨Ll ℓ (2 * k + 1), ?_, toZModPow_Ll m _⟩
    rw [odd_eq]
    exact hXpow k (L_one_mem h13 h5)
  | zero => exact ⟨0, Submodule.zero_mem _, map_zero _⟩
  | add x y _ _ hx hy =>
    obtain ⟨F, hF, rfl⟩ := hx
    obtain ⟨G, hG, rfl⟩ := hy
    exact ⟨F + G, Submodule.add_mem _ hF hG, map_add _ _ _⟩
  | smul c x _ hx =>
    obtain ⟨F, hF, rfl⟩ := hx
    refine ⟨((c.val : ℕ) : ℤ_[ℓ]) • F, Submodule.smul_mem _ _ hF, ?_⟩
    rw [redP_smul, map_natCast, ZMod.natCast_zmod_val]

/-! ### The torsion of `Λ^odd` -/

/-- An element of order dividing `ℓ` is `ℓ^n` times a series. -/
lemma exists_quot (n : ℕ) {v : PowerSeries (Rm ℓ (n + 1))} (hv : ℓ • v = 0) :
    ∃ G : PS ℓ, redP ℓ (n + 1) (((ℓ : ℤ_[ℓ]) ^ n) • G) = v := by
  haveI : NeZero (ℓ ^ (n + 1)) := ⟨pow_ne_zero _ hℓ.out.ne_zero⟩
  have hc : ∀ i, ∃ y : ℕ, (PowerSeries.coeff i v) = ((ℓ ^ n * y : ℕ) : Rm ℓ (n + 1)) := by
    intro i
    have h0 : ℓ • PowerSeries.coeff i v = 0 := by
      have := congrArg (PowerSeries.coeff i) hv
      rwa [map_nsmul, map_zero] at this
    set z := PowerSeries.coeff i v with hz
    have hz' : ((ℓ * z.val : ℕ) : Rm ℓ (n + 1)) = 0 := by
      push_cast
      rw [ZMod.natCast_zmod_val, ← nsmul_eq_mul]
      exact h0
    have key : ∀ a : ℕ, ℓ ^ (n + 1) ∣ ℓ * a → ℓ ^ n ∣ a := fun a h => by
      rw [pow_succ'] at h
      exact Nat.dvd_of_mul_dvd_mul_left hℓ.out.pos h
    obtain ⟨y, hy⟩ := key _ ((ZMod.natCast_eq_zero_iff _ _).mp hz')
    exact ⟨y, by rw [← hy, ZMod.natCast_zmod_val]⟩
  choose y hy using hc
  refine ⟨PowerSeries.mk fun i => ((y i : ℕ) : ℤ_[ℓ]), ?_⟩
  ext i
  rw [redP_smul, PowerSeries.coeff_smul, PowerSeries.coeff_map, PowerSeries.coeff_mk, hy, smul_eq_mul]
  simp

/-- **The torsion of `Λ^odd` injects into `V̄`.** -/
theorem card_socle_le (h13 : 13 ≤ ℓ) (n k₀ : ℕ) (hk : n + 1 ≤ k₀ + 1) :
    Nat.card {v : Lam ℓ (n + 1) (2 * k₀ + 1) // ℓ • v = 0} ≤ ℓ ^ ((ℓ + 12) / 24) := by
  classical
  have h5 : 5 ≤ ℓ := by omega
  obtain ⟨heq, hfin⟩ := chain_structure (ℓ := ℓ) h13 (n + 1) (by omega) k₀ hk
  have hb := (mem_bSet (ℓ := ℓ) h13 (n + 1) (by omega) k₀ hk).2
  rw [show 2 * k₀ + 1 + 2 = 2 * (k₀ + 1) + 1 by ring, ← heq] at hb
  set Λ := Lam ℓ (n + 1) (2 * k₀ + 1) with hΛ
  have hinj : ∀ j : ℕ, ∀ x ∈ Λ, (Xm ℓ (n + 1) ^ j) x = 0 → x = 0 := by
    intro j
    induction j with
    | zero => intro x _ h; simpa using h
    | succ j ih =>
      intro x hx h
      rw [pow_succ (Xm ℓ (n + 1)) j, Module.End.mul_apply] at h
      have h1 := ih _ (hb.mapsTo hx) h
      exact hb.injOn hx (Submodule.zero_mem _) (by rw [h1, map_zero])
  haveI := finite_Vbar (ℓ := ℓ) h13
  haveI : Finite (Vbar ℓ) := Module.finite_of_finite (ZMod ℓ)
  have hq : ∀ v : {v : Λ // ℓ • v = 0}, ∃ G : PS ℓ, redP ℓ (n + 1) (((ℓ : ℤ_[ℓ]) ^ n) • G) = (v.1 : PowerSeries _) := by
    intro v
    refine exists_quot n ?_
    exact congrArg Subtype.val v.2
  choose G hG using hq
  have hmem : ∀ v, (Xbar ℓ ^ (n + 1)) (red ℓ (G v)) ∈ Vbar ℓ := by
    intro v
    obtain ⟨F, hF, hFe⟩ := exists_lift h13 h5 (n + 1) _ v.1.2
    have hz : redP ℓ (n + 1) (F - ((ℓ : ℤ_[ℓ]) ^ n) • G v) = 0 := by
      rw [map_sub, hFe, hG, sub_self]
    obtain ⟨H, hH⟩ := redP_eq_zero _ hz
    have hF' : F = ((ℓ : ℤ_[ℓ]) ^ n) • (G v + (ℓ : ℤ_[ℓ]) • H) := by
      rw [smul_add, smul_smul, ← pow_succ, ← hH]
      abel
    have hred : red ℓ (G v + (ℓ : ℤ_[ℓ]) • H) = red ℓ (G v) := by
      rw [map_add, PowerSeries.smul_eq_C_mul, map_mul, PowerSeries.map_C, map_natCast,
        ZMod.natCast_self, map_zero, zero_mul, add_zero]
    have hX := red_X_mem h13 h5 (X_pow_div h13 h5 n hF hF')
    rwa [← Module.End.mul_apply, ← pow_succ', red_pow_X, hred] at hX
  let tf : {v : Λ // ℓ • v = 0} → Vbar ℓ := fun v => ⟨_, hmem v⟩
  have htf : Function.Injective tf := by
    intro v w hvw
    have h0 : red ℓ ((Xop ℓ ^ (n + 1)) (G v - G w)) = 0 := by
      have := congrArg Subtype.val hvw
      rw [red_pow_X, map_sub, map_sub, sub_eq_zero]
      exact this
    obtain ⟨H, hH⟩ := PS_dvd_of_map _ h0
    have h1 : (Xm ℓ (n + 1) ^ (n + 1)) ((v.1 : PowerSeries _) - (w.1 : PowerSeries _)) = 0 := by
      rw [← hG, ← hG, ← map_sub, ← smul_sub, ← redP_pow_X, map_smul, hH, smul_smul, ← pow_succ]
      rw [redP_smul, map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self, zero_smul]
    have h2 := hinj _ _ (Submodule.sub_mem _ v.1.2 w.1.2) h1
    exact Subtype.ext (Subtype.ext (sub_eq_zero.mp h2))
  haveI : Finite Λ := hfin
  calc Nat.card {v : Λ // ℓ • v = 0} ≤ Nat.card (Vbar ℓ) := Nat.card_le_card_of_injective tf htf
    _ = ℓ ^ ((ℓ + 12) / 24) := by
      rw [Module.natCard_eq_pow_finrank (K := ZMod ℓ), Nat.card_zmod, finrank_Vbar h13]

/-- **The bound of Folsom–Kent–Ono.** `Λ^odd(2k₀+1, m)` is generated over `ℤ/ℓ^m` by at most
`⌊(ℓ+12)/24⌋` elements, whenever `2k₀+1 ≥ 2m-1`. -/
theorem rank_Lam_le (h13 : 13 ≤ ℓ) (m : ℕ) (hm : 1 ≤ m) (k₀ : ℕ) (hk : m ≤ k₀ + 1) :
    ∃ s : Finset (PowerSeries (Rm ℓ m)), s.card ≤ (ℓ + 12) / 24 ∧
      Submodule.span (Rm ℓ m) (s : Set (PowerSeries (Rm ℓ m))) = Lam ℓ m (2 * k₀ + 1) := by
  classical
  obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩
  obtain ⟨-, hfin⟩ := chain_structure (ℓ := ℓ) h13 (n + 1) hm k₀ hk
  haveI : Finite (Lam ℓ (n + 1) (2 * k₀ + 1)) := hfin
  have hkill : ∀ x : Lam ℓ (n + 1) (2 * k₀ + 1), (ℓ ^ (n + 1)) • x = 0 := by
    intro x
    have hz : ((ℓ ^ (n + 1) : ℕ) : Rm ℓ (n + 1)) = 0 := ZMod.natCast_self _
    apply Subtype.ext
    ext i
    change PowerSeries.coeff i ((ℓ ^ (n + 1)) • (x : PowerSeries (Rm ℓ (n + 1)))) = PowerSeries.coeff i 0
    rw [map_nsmul, nsmul_eq_mul, hz, zero_mul, map_zero]
  obtain ⟨s, hs, hspan⟩ := gens_of_socle hkill (card_socle_le h13 n k₀ hk)
  refine ⟨s.image Subtype.val, Finset.card_image_le.trans hs, le_antisymm ?_ ?_⟩
  · rw [Submodule.span_le]
    intro x hx
    obtain ⟨y, -, rfl⟩ := Finset.mem_image.mp hx
    exact y.2
  · have key : ∀ y : Lam ℓ (n + 1) (2 * k₀ + 1), y ∈ AddSubgroup.closure (s : Set _) →
        (y : PowerSeries (Rm ℓ (n + 1))) ∈ Submodule.span (Rm ℓ (n + 1))
          ((s.image Subtype.val : Finset _) : Set (PowerSeries (Rm ℓ (n + 1)))) := by
      intro y hy
      induction hy using AddSubgroup.closure_induction with
      | mem y hy => exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hy))
      | zero => exact Submodule.zero_mem _
      | add y z _ _ hy hz => exact Submodule.add_mem _ hy hz
      | neg y _ hy => exact Submodule.neg_mem _ hy
    intro x hx
    exact key ⟨x, hx⟩ (by rw [hspan]; trivial)

/-- **Boylan–Webb's `r_ℓ(m)`**: the least number of generators of the stable module. -/
def rEll (ℓ : ℕ) [Fact ℓ.Prime] (m : ℕ) : ℕ :=
  sInf {r | ∃ s : Finset (PowerSeries (Rm ℓ m)), s.card = r ∧
    Submodule.span (Rm ℓ m) (s : Set (PowerSeries (Rm ℓ m))) = Lam ℓ m (2 * m - 1)}

/-- **`r_ℓ(m) ≤ ⌊(ℓ+12)/24⌋`.** -/
theorem rEll_le (h13 : 13 ≤ ℓ) (m : ℕ) (hm : 1 ≤ m) : rEll ℓ m ≤ (ℓ + 12) / 24 := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  obtain ⟨s, hs, hspan⟩ := rank_Lam_le (ℓ := ℓ) h13 (k + 1) hm k le_rfl
  rw [show 2 * k + 1 = 2 * (k + 1) - 1 by omega] at hspan
  have h : rEll ℓ (k + 1) ≤ s.card := Nat.sInf_le ⟨s, rfl, hspan⟩
  exact h.trans hs

end


/-! ## coefficients -/

lemma cE2 {n : ℕ} (hn : n ≠ 0) : coeff n E₂ = -24 * (σ 1 n : ℤ) := by
  rw [E2_eq, map_sub, coeff_one, if_neg hn, coeff_ofNat_mul', coeff_Sk]; ring
lemma cE4 {n : ℕ} (hn : n ≠ 0) : coeff n E₄ = 240 * (σ 3 n : ℤ) := by rw [coeff_E4, if_neg hn]
lemma cE6 {n : ℕ} (hn : n ≠ 0) : coeff n E₆ = -504 * (σ 5 n : ℤ) := by rw [coeff_E6, if_neg hn]
lemma cF8 {n : ℕ} (hn : n ≠ 0) : coeff n F8 = 480 * (σ 7 n : ℤ) := by
  rw [F8, E4_sq, map_add, coeff_one, if_neg hn, coeff_ofNat_mul', coeff_Sk]; ring
lemma cF10 {n : ℕ} (hn : n ≠ 0) : coeff n F10 = -264 * (σ 9 n : ℤ) := by
  rw [F10, E4_mul_E6, map_sub, coeff_one, if_neg hn, coeff_ofNat_mul', coeff_Sk]; ring
lemma cE6sq (n : ℕ) : coeff n (E₆ ^ 2) = coeff n (E₄ ^ 3) - 1728 * TauCong.tauPS n := by
  have := congrArg (coeff n) (disc_eq (R := ℤ))
  rw [map_sub, coeff_ofNat_mul', coeff_Dq, Int.cast_id] at this
  linear_combination -this

lemma one_sub_E2 : 1 - E₂ = 24 * Sk 1 := by rw [E2_eq]; ring
lemma E4_sub_one : E₄ - 1 = 240 * Sk 3 := by rw [E4_eq]; ring
lemma E4_sub_E2sq : E₄ - E₂ ^ 2 = 288 * theta (Sk 1) := by
  obtain ⟨-, -, R3⟩ := RamanujanODEProof.ramanujanODE
  have h : theta E₂ = -(24 * theta (Sk 1)) := by
    rw [E2_eq, theta_sub, Igusa.theta_one, theta_ofNat_mul]; ring
  linear_combination R3 - 12 * h

lemma TA_eq : (1 - E₂) ^ 2 * (E₄ - E₂ ^ 2) ^ 2 = 47775744 * (Sk 1 ^ 2 * theta (Sk 1) ^ 2) := by
  rw [one_sub_E2, E4_sub_E2sq]; ring
lemma TB_eq : (E₄ - E₂ ^ 2) * (E₄ - 1) ^ 2 = 16588800 * (theta (Sk 1) * Sk 3 ^ 2) := by
  rw [E4_sub_one, E4_sub_E2sq]; ring

/-- Linearization of `TA` (exact identity in `ℤ⟦q⟧`). -/
theorem linA : (2520 : PowerSeries ℤ) * ((1 - E₂) ^ 2 * (E₄ - E₂ ^ 2) ^ 2) =
    725760 * theta^[3] E₂ - 4354560 * theta^[4] E₂ + 5225472 * theta^[5] E₂ + 72576 * theta^[2] E₄ - 580608 * theta^[3] E₄ + 808704 * theta^[4] E₄ - 69120 * theta^[2] E₆ + 155520 * theta^[3] E₆ + 20160 * theta^[2] F8 + 16 * E₄ ^ 3 - 16 * E₆ ^ 2 := by
  linear_combination (-420) * tE2_3 + (210) * tE2_4 + (-21) * tE2_5 + (-504) * tE4_2 + (336) * tE4_3 + (-39) * tE4_4 + (480) * tE6_2 + (-90) * tE6_3 + (-140) * tF8_2

/-- Integrality of `Sk 1 ^ 2 * theta (Sk 1) ^ 2` at a prime zero of `τ`. -/
theorem condA {p : ℕ} (hp : p.Prime) (h0 : TauCong.tauPS p = 0) :
    (124416 : ℤ) ∣ 350 * (p : ℤ) ^ 9 - 2835 * (p : ℤ) ^ 8 + 8280 * (p : ℤ) ^ 7 - 9576 * (p : ℤ) ^ 6 - 126 * (p : ℤ) ^ 5 + 10170 * (p : ℤ) ^ 4 - 8505 * (p : ℤ) ^ 3 + 2240 * (p : ℤ) ^ 2 := by
  have hn := hp.ne_zero
  have hk := congrArg (coeff p) linA
  rw [TA_eq] at hk
  simp only [map_add, map_sub, map_neg, neg_mul, coeff_ofNat_mul', coeff_iter, cE2 hn, cE4 hn, cE6 hn,
    cF8 hn, cF10 hn, cE6sq, h0] at hk
  simp only [sigma_prime_cast hp] at hk
  refine ⟨35 * coeff p (Sk 1 ^ 2 * theta (Sk 1) ^ 2), ?_⟩
  apply mul_left_cancel₀ (show (19104768 : ℤ) ≠ 0 by norm_num)
  linear_combination (-691) * hk

/-- Linearization of `TB` (exact identity in `ℤ⟦q⟧`). -/
theorem linB : (360 : PowerSeries ℤ) * ((E₄ - E₂ ^ 2) * (E₄ - 1) ^ 2) =
    -4320 * theta^[1] E₂ + 5184 * theta^[2] E₄ + 2880 * theta^[1] E₆ - 720 * theta^[2] F8 - 864 * theta^[1] F10 + 128 * E₄ ^ 3 - 128 * E₆ ^ 2 := by
  linear_combination (360) * tE2_1 + (-36) * tE4_2 + (-240) * tE6_1 + (5) * tF8_2 + (72) * tF10_1

/-- Integrality of `theta (Sk 1) * Sk 3 ^ 2` at a prime zero of `τ`. -/
theorem condB {p : ℕ} (hp : p.Prime) (h0 : TauCong.tauPS p = 0) :
    (125 : ℤ) ∣ 33 * (p : ℤ) ^ 10 - 50 * (p : ℤ) ^ 9 - 210 * (p : ℤ) ^ 6 + 180 * (p : ℤ) ^ 5 + 145 * (p : ℤ) ^ 2 - 162 * (p : ℤ) := by
  have hn := hp.ne_zero
  have hk := congrArg (coeff p) linB
  rw [TB_eq] at hk
  simp only [map_add, map_sub, map_neg, neg_mul, coeff_ofNat_mul', coeff_iter, cE2 hn, cE4 hn, cE6 hn,
    cF8 hn, cF10 hn, cE6sq, h0] at hk
  simp only [sigma_prime_cast hp] at hk
  refine ⟨6912 * coeff p (theta (Sk 1) * Sk 3 ^ 2), ?_⟩
  apply mul_left_cancel₀ (show (4776192 : ℤ) ≠ 0 by norm_num)
  linear_combination (-691) * hk


lemma dA512 : ∀ x : ZMod 512, 350 * x ^ 9 - 2835 * x ^ 8 + 8280 * x ^ 7 - 9576 * x ^ 6 - 126 * x ^ 5 + 10170 * x ^ 4 - 8505 * x ^ 3 + 2240 * x ^ 2 = 0 → x.val % 2 = 0 ∨ x.val = 511 := by
  decide +kernel
lemma dA243 : ∀ x : ZMod 243, 350 * x ^ 9 - 2835 * x ^ 8 + 8280 * x ^ 7 - 9576 * x ^ 6 - 126 * x ^ 5 + 10170 * x ^ 4 - 8505 * x ^ 3 + 2240 * x ^ 2 = 0 → x.val % 3 = 0 ∨ x.val = 242 := by
  decide +kernel
lemma dB125 : ∀ x : ZMod 125, 33 * x ^ 10 - 50 * x ^ 9 - 210 * x ^ 6 + 180 * x ^ 5 + 145 * x ^ 2 - 162 * x = 0 → x.val % 5 = 0 ∨ x.val = 124 := by
  decide +kernel

/-- **A prime zero of `τ` is `≡ −1` modulo `2⁹`, `3⁵` and `5³`.** -/
theorem prime_zero_deep {p : ℕ} (hp : p.Prime) (h : τ p = 0) :
    p % 512 = 511 ∧ p % 243 = 242 ∧ p % 125 = 124 := by
  have ht : TauCong.tauPS p = 0 := by rw [← tau_eq_tauPS]; exact h
  have h2 : p ≠ 2 := by rintro rfl; rw [tau_two] at h; norm_num at h
  have h3 : p ≠ 3 := by rintro rfl; rw [tau_three] at h; norm_num at h
  have h5 : p ≠ 5 := by rintro rfl; rw [tau_five] at h; norm_num at h
  obtain ⟨k, hk⟩ := condA hp ht
  obtain ⟨k', hk'⟩ := condB hp ht
  refine ⟨?_, ?_, ?_⟩
  · have hz : ((350 * (p : ℤ) ^ 9 - 2835 * (p : ℤ) ^ 8 + 8280 * (p : ℤ) ^ 7 - 9576 * (p : ℤ) ^ 6 - 126 * (p : ℤ) ^ 5 + 10170 * (p : ℤ) ^ 4 - 8505 * (p : ℤ) ^ 3 + 2240 * (p : ℤ) ^ 2 : ℤ) : ZMod 512) = 0 := by
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]; exact dvd_trans (by norm_num) ⟨k, hk⟩
    push_cast at hz
    rcases dA512 (p : ZMod 512) hz with hx | hx <;> rw [ZMod.val_natCast] at hx
    · exact absurd (prime_eq_of_dvd hp Nat.prime_two (by omega)) h2
    · exact hx
  · have hz : ((350 * (p : ℤ) ^ 9 - 2835 * (p : ℤ) ^ 8 + 8280 * (p : ℤ) ^ 7 - 9576 * (p : ℤ) ^ 6 - 126 * (p : ℤ) ^ 5 + 10170 * (p : ℤ) ^ 4 - 8505 * (p : ℤ) ^ 3 + 2240 * (p : ℤ) ^ 2 : ℤ) : ZMod 243) = 0 := by
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]; exact dvd_trans (by norm_num) ⟨k, hk⟩

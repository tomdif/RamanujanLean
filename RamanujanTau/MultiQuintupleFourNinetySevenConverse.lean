/-- Exactly four residue progressions vanish for this product, for all N. -/
theorem four97_persistent_vanishing_iff (R : ℕ) (hR : R < 97) :
    (∀ N : ℕ, coeff (97*N+R) (quintupleSpecialized 97 5 * quintupleSpecialized 97 4 *
      quintupleSpecialized 97 9 * quintupleSpecialized 97 13) = 0) ↔
    R=9 ∨ R=13 ∨ R=55 ∨ R=64 := by
  constructor
  · intro hz
    rcases four97_residue_or_witness R hR with hr | ⟨N,_,hn⟩
    · exact hr
    · exact False.elim (hn (hz N))
  · intro hr N
    exact coeff_fourReflection_97 R N hr

/-- Sixteen terms are an exact finite test for every residue of this product. -/
theorem four97_finite_test_iff (R : ℕ) (hR : R < 97) :
    (∀ N : ℕ, coeff (97*N+R) (quintupleSpecialized 97 5 * quintupleSpecialized 97 4 *
      quintupleSpecialized 97 9 * quintupleSpecialized 97 13) = 0) ↔
    (∀ N : ℕ, N ≤ 15 → coeff (97*N+R) (quintupleSpecialized 97 5 * quintupleSpecialized 97 4 *
      quintupleSpecialized 97 9 * quintupleSpecialized 97 13) = 0) := by
  constructor
  · exact fun h N _ => h N
  · intro h
    apply (four97_persistent_vanishing_iff R hR).mpr
    rcases four97_residue_or_witness R hR with hr | ⟨N,hle,hn⟩
    · exact hr
    · exact False.elim (hn (h N hle))

private theorem coefficient97_54_before :
    ∀ N : Fin 15, four97ShortCoeff (97*N.val+54) = 0 := by
  intro N
  fin_cases N
  · exact before97_0
  · exact before97_1
  · exact before97_2
  · exact before97_3
  · exact before97_4
  · exact before97_5
  · exact before97_6
  · exact before97_7
  · exact before97_8
  · exact before97_9
  · exact before97_10
  · exact before97_11
  · exact before97_12
  · exact before97_13
  · exact before97_14

/-- The cutoff is attained: residue 54 first becomes nonzero at N=15. -/
theorem first_witness_four97 :
    (∀ N : ℕ, N < 15 → coeff (97*N+54) (quintupleSpecialized 97 5 * quintupleSpecialized 97 4 *
      quintupleSpecialized 97 9 * quintupleSpecialized 97 13) = 0) ∧
    coeff (97*15+54) (quintupleSpecialized 97 5 * quintupleSpecialized 97 4 *
      quintupleSpecialized 97 9 * quintupleSpecialized 97 13) = 1 := by
  constructor
  · intro N hN
    rw [coeff_four97_eq_short _ (by omega)]
    exact coefficient97_54_before ⟨N,hN⟩
  · rw [coeff_four97_eq_short _ (by norm_num)]
    exact coefficient97_54


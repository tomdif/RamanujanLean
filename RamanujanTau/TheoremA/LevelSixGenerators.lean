import RamanujanTau.TheoremA.LevelSixCosets
import Mathlib.NumberTheory.ModularForms.LevelOne

/-!
# A finite generating set for Γ₀(6)

The twelve-representative certificate gives 24 correcting matrices. A group
argument proves that they generate Γ₀(6). This reduces invariance of a proposed
eta quotient to finitely many explicit transformations.
-/

set_option autoImplicit false

namespace RamanujanTau.TheoremA.LevelSix
open Matrix CongruenceSubgroup ModularGroup
open scoped MatrixGroups ModularForm

@[simp] theorem rep_zero : rep 0 = 1 := rfl

theorem rep_mem_iff (i : Fin 12) : rep i ∈ Gamma0 6 ↔ i = 0 := by
  revert i
  change ∀ i, ((rep i) 1 0 : ZMod 6) = 0 ↔ i = 0
  decide +kernel

def generator : Bool × Fin 12 → SL(2, ℤ)
  | (false, i) => rep i * S * (rep (permS i))⁻¹
  | (true, i) => rep i * T * (rep (permT i))⁻¹

def generated : Subgroup SL(2, ℤ) := Subgroup.closure (Set.range generator)

lemma generator_mem (b : Bool) (i : Fin 12) : generator (b, i) ∈ Gamma0 6 := by
  cases b
  · exact correctionS_mem i
  · exact correctionT_mem i

lemma generated_le : generated ≤ Gamma0 6 := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨⟨b, i⟩, rfl⟩
  exact generator_mem b i

/-- Matrices whose right action permutes the representatives modulo H. -/
def transports (H : Subgroup SL(2, ℤ)) : Subgroup SL(2, ℤ) where
  carrier g := ∃ σ : Equiv.Perm (Fin 12), ∀ i, rep i * g * (rep (σ i))⁻¹ ∈ H
  one_mem' := ⟨Equiv.refl _, fun i => by simp⟩
  mul_mem' := by
    rintro g h ⟨σ, hσ⟩ ⟨τ, hτ⟩
    refine ⟨σ.trans τ, fun i => ?_⟩
    have he : rep i * (g * h) * (rep (τ (σ i)))⁻¹ =
        (rep i * g * (rep (σ i))⁻¹) * (rep (σ i) * h * (rep (τ (σ i)))⁻¹) := by group
    rw [show (σ.trans τ) i = τ (σ i) from rfl, he]
    exact H.mul_mem (hσ i) (hτ (σ i))
  inv_mem' := by
    rintro g ⟨σ, hσ⟩
    refine ⟨σ.symm, fun i => ?_⟩
    have he : rep i * g⁻¹ * (rep (σ.symm i))⁻¹ =
        (rep (σ.symm i) * g * (rep i)⁻¹)⁻¹ := by group
    rw [he]
    exact H.inv_mem (by simpa using hσ (σ.symm i))

lemma transports_generated_eq_top : transports generated = ⊤ := by
  apply top_unique
  rw [← SpecialLinearGroup.SL2Z_generators]
  apply (Subgroup.closure_le _).mpr
  intro g hg
  rcases hg with rfl | rfl
  · refine ⟨permS, fun i => ?_⟩
    exact Subgroup.subset_closure ⟨(false, i), rfl⟩
  · refine ⟨permT, fun i => ?_⟩
    exact Subgroup.subset_closure ⟨(true, i), rfl⟩

/-- Γ₀(6) is generated by the explicit 24 correcting matrices. -/
theorem generated_eq_Gamma0 : generated = Gamma0 6 := by
  apply le_antisymm generated_le
  intro g hg
  have ht : g ∈ transports generated := by rw [transports_generated_eq_top]; trivial
  obtain ⟨σ, hσ⟩ := ht
  have hc : g * (rep (σ 0))⁻¹ ∈ generated := by simpa only [rep_zero, one_mul] using hσ 0
  have hr : (rep (σ 0))⁻¹ ∈ Gamma0 6 := by
    simpa using (Gamma0 6).mul_mem ((Gamma0 6).inv_mem hg) (generated_le hc)
  have hi : σ 0 = 0 := (rep_mem_iff _).mp (by simpa using (Gamma0 6).inv_mem hr)
  simpa [hi] using hc

theorem exists_rep (g : SL(2, ℤ)) : ∃ i, g * (rep i)⁻¹ ∈ Gamma0 6 := by
  have ht : g ∈ transports generated := by rw [transports_generated_eq_top]; trivial
  obtain ⟨σ, hσ⟩ := ht
  refine ⟨σ 0, ?_⟩
  rw [← generated_eq_Gamma0]
  simpa only [rep_zero, one_mul] using hσ 0

/-- Invariance on 24 explicit matrices implies invariance on all of Γ₀(6). -/
theorem slash_invariant_of_generators {f : UpperHalfPlane → ℂ} {k : ℤ}
    (h : ∀ b i, f ∣[k] generator (b, i) = f)
    (g : SL(2, ℤ)) (hg : g ∈ Gamma0 6) : f ∣[k] g = f := by
  apply Subgroup.closure_induction (p := fun γ _ => f ∣[k] γ = f) ?_ (by simp)
  · intro x y hx hy hfx hfy
    rw [SlashAction.slash_mul, hfx, hfy]
  · intro x hx hfx
    rw [← hfx, ← SlashAction.slash_mul]
    simp [hfx]
  · change g ∈ generated
    rw [generated_eq_Gamma0]
    exact hg
  · rintro _ ⟨⟨b, i⟩, rfl⟩
    exact h b i

end RamanujanTau.TheoremA.LevelSix

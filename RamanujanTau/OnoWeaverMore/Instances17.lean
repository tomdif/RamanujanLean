import RamanujanTau.OnoWeaverMore.Core

/-!
# Ono–Weaver congruences modulo 17, both types, for primes `Q < 500`

Generated by `scripts/onoweavermore/gen_instances.py` from `scan.py` (exact `p(n) mod 17`).
One kernel-certified prefix of 929,634 partition numbers modulo 17 (`all17`) supplies the
coefficient `q^1` of `T(Q²) Σ p(17N − 12) q^N` for every `Q` in the list; the eigen-relation is
`EigenLift.etaHeckeMod_17` (Shimura lift + dimension-one certificate).
Pairs `(Q, ε)`: `ε = 0` is Ono's type (`17 ∣ p((17Q³n+1)/24)`, `Q ∤ n`), `ε = ±1` is Atkin's
type (`17 ∣ p((17Q²m+1)/24)` whenever `(m/Q) = ε`).
-/

set_option autoImplicit false

namespace RamanujanTau.OnoWeaverMore.L17
open PowerSeries BoylanWebb RamanujanTau.OnoWeaverMore

instance factL : Fact (Nat.Prime 17) := ⟨by norm_num⟩

/-- The pairs `(Q, ε)` certified modulo 17. -/
def pairs : List (ℕ × ℤ) := [(23, -1), (41, 0), (67, 1), (89, 0), (103, 0), (107, -1), (127, -1), (151, -1), (191, -1), (293, -1), (359, -1), (373, 1), (433, 0)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, all pairs. -/
theorem all17 : allOk 17 262140 929634 8 4 20 5 18 43 1 pairs = true := by
  decide +kernel

theorem coeff_ok (Q : ℕ) [Fact Q.Prime] (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    coeff 1 (TT 17 Q (Ψ 17 (Pser 17 1))) = muE 17 Q ε * coeff 1 (Ψ 17 (Pser 17 1)) ∧
      coeff 1 (Ψ 17 (Pser 17 1)) ≠ 0 :=
  allOk_sound 17 (by norm_num) (by decide) (kN := 20) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by decide) all17 Q ε hmem

theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    TT 17 Q (Ψ 17 (Pser 17 1)) = C (muE 17 Q ε) * Ψ 17 (Pser 17 1) :=
  eigen_of_etaHecke 17 Q (by norm_num) (by norm_num) Cert17.h24 Cert17.f Cert17.form_f
    (by rw [← coeff_zero_eq_constantCoeff_apply]; exact Cert17.coeff_zero_f)
    ((((7 : ℤ)) : ZMod 17)) (by decide) Cert17.eigen.1
    (RamanujanTau.AtkinSporadic.EigenLift.etaHeckeMod_17 hQ5) _ (coeff_ok Q ε hmem).1

instance factQ23 : Fact (Nat.Prime 23) := ⟨by norm_num⟩

/-- Atkin type: `p((17·23²m+1)/24) ≡ 0 (mod 17)` whenever `(m/23) = (-1)`. -/
theorem atkin_17_23 (m : ℕ) (hm : 24 ∣ 17 * 23 ^ 2 * m + 1) (hQm : legendreSym 23 m = (-1)) :
    17 ∣ Fintype.card (Nat.Partition ((17 * 23 ^ 2 * m + 1) / 24)) :=
  atkin_of_eigen 17 (by decide) 23 (by norm_num) (-1) (by norm_num)
    (eigen 23 (by norm_num) (-1) (by decide)) m hm hQm

/-- Explicit progression: `17 ∣ p(206839n + 2623)` for all `n`
(`24·2623 − 1 = 17·23²·7`, `(7/23) = -1`). -/
theorem atkin_17_23_progression (n : ℕ) : 17 ∣ Fintype.card (Nat.Partition (206839 * n + 2623)) := by
  have h := atkin_17_23 (7 + 552 * n) (by norm_num; omega) (by
    rw [legendreSym.mod]
    have : ((((7 + 552 * n : ℕ)) : ℤ) % (23 : ℕ)) = 7 := by push_cast; omega
    rw [this, RamanujanTau.AtkinSporadic.legendreSym_val 23 (by norm_num)]
    decide)
  have e : (17 * 23 ^ 2 * (7 + 552 * n) + 1) / 24 = 206839 * n + 2623 := by
    norm_num; omega
  rwa [e] at h

instance factQ41 : Fact (Nat.Prime 41) := ⟨by norm_num⟩

/-- `p((17·41³n+1)/24) ≡ 0 (mod 17)` for `41 ∤ n` (already in `AtkinSporadic.WeaverUnconditional`; reproved here). -/
theorem ono_17_41 (n : ℕ) (hn : ¬ 41 ∣ n) (h : 24 ∣ 17 * 41 ^ 3 * n + 1) :
    17 ∣ Fintype.card (Nat.Partition ((17 * 41 ^ 3 * n + 1) / 24)) :=
  ono_of_eigen 17 (by decide) 41 (by norm_num) (eigen 41 (by norm_num) 0 (by decide)) n hn h


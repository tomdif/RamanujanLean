import RamanujanTau.OnoWeaverMore.Core

/-!
# Ono–Weaver congruences modulo 19, both types, for primes `Q < 500`

Generated by `scripts/onoweavermore/gen_instances.py` from `scan.py` (exact `p(n) mod 19`).
One kernel-certified prefix of 735,305 partition numbers modulo 19 (`all19`) supplies the
coefficient `q^1` of `T(Q²) Σ p(19N − 15) q^N` for every `Q` in the list; the eigen-relation is
`EigenLift.etaHeckeMod_19` (Shimura lift + dimension-one certificate).
Pairs `(Q, ε)`: `ε = 0` is Ono's type (`19 ∣ p((19Q³n+1)/24)`, `Q ∤ n`), `ε = ±1` is Atkin's
type (`19 ∣ p((19Q²m+1)/24)` whenever `(m/Q) = ε`).
-/

set_option autoImplicit false

namespace RamanujanTau.OnoWeaverMore.L19
open PowerSeries BoylanWebb RamanujanTau.OnoWeaverMore

instance factL : Fact (Nat.Prime 19) := ⟨by norm_num⟩

/-- The pairs `(Q, ε)` certified modulo 19. -/
def pairs : List (ℕ × ℤ) := [(13, -1), (23, -1), (61, 1), (97, -1), (101, 0), (103, 1), (109, 1), (137, 1), (191, 0), (193, 1), (211, 0), (269, -1), (271, 1), (337, 0), (349, 0), (431, -1)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, all pairs. -/
theorem all19 : allOk 19 262143 735305 8 3 20 5 18 43 1 pairs = true := by
  decide +kernel

theorem coeff_ok (Q : ℕ) [Fact Q.Prime] (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    coeff 1 (TT 19 Q (Ψ 19 (Pser 19 1))) = muE 19 Q ε * coeff 1 (Ψ 19 (Pser 19 1)) ∧
      coeff 1 (Ψ 19 (Pser 19 1)) ≠ 0 :=
  allOk_sound 19 (by norm_num) (by decide) (kN := 20) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by decide) all19 Q ε hmem

theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    TT 19 Q (Ψ 19 (Pser 19 1)) = C (muE 19 Q ε) * Ψ 19 (Pser 19 1) :=
  eigen_of_etaHecke 19 Q (by norm_num) (by norm_num) Cert19.h24 Cert19.f Cert19.form_f
    (by rw [← coeff_zero_eq_constantCoeff_apply]; exact Cert19.coeff_zero_f)
    ((((5 : ℤ)) : ZMod 19)) (by decide) Cert19.eigen.1
    (RamanujanTau.AtkinSporadic.EigenLift.etaHeckeMod_19 hQ5) _ (coeff_ok Q ε hmem).1

instance factQ13 : Fact (Nat.Prime 13) := ⟨by norm_num⟩

/-- Atkin type: `p((19·13²m+1)/24) ≡ 0 (mod 19)` whenever `(m/13) = (-1)`. -/
theorem atkin_19_13 (m : ℕ) (hm : 24 ∣ 19 * 13 ^ 2 * m + 1) (hQm : legendreSym 13 m = (-1)) :
    19 ∣ Fintype.card (Nat.Partition ((19 * 13 ^ 2 * m + 1) / 24)) :=
  atkin_of_eigen 19 (by decide) 13 (by norm_num) (-1) (by norm_num)
    (eigen 13 (by norm_num) (-1) (by decide)) m hm hQm

/-- Explicit progression: `19 ∣ p(41743n + 669)` for all `n`
(`24·669 − 1 = 19·13²·5`, `(5/13) = -1`). -/
theorem atkin_19_13_progression (n : ℕ) : 19 ∣ Fintype.card (Nat.Partition (41743 * n + 669)) := by
  have h := atkin_19_13 (5 + 312 * n) (by norm_num; omega) (by
    rw [legendreSym.mod]
    have : ((((5 + 312 * n : ℕ)) : ℤ) % (13 : ℕ)) = 5 := by push_cast; omega
    rw [this, RamanujanTau.AtkinSporadic.legendreSym_val 13 (by norm_num)]
    decide)
  have e : (19 * 13 ^ 2 * (5 + 312 * n) + 1) / 24 = 41743 * n + 669 := by
    norm_num; omega
  rwa [e] at h


import RamanujanTau.OnoWeaverMore.Core

/-!
# Ono–Weaver congruences modulo 23, both types, for primes `Q < 500`

Generated by `scripts/onoweavermore/gen_instances.py` from `scan.py` (exact `p(n) mod 23`).
One kernel-certified prefix of 169,857 partition numbers modulo 23 (`all23`) supplies the
coefficient `q^1` of `T(Q²) Σ p(23N − 22) q^N` for every `Q` in the list; the eigen-relation is
`EigenLift.etaHeckeMod_23` (Shimura lift + dimension-one certificate).
Pairs `(Q, ε)`: `ε = 0` is Ono's type (`23 ∣ p((23Q³n+1)/24)`, `Q ∤ n`), `ε = ±1` is Atkin's
type (`23 ∣ p((23Q²m+1)/24)` whenever `(m/Q) = ε`).
-/

set_option autoImplicit false

namespace RamanujanTau.OnoWeaverMore.L23
open PowerSeries BoylanWebb RamanujanTau.OnoWeaverMore

instance factL : Fact (Nat.Prime 23) := ⟨by norm_num⟩

/-- The pairs `(Q, ε)` certified modulo 23. -/
def pairs : List (ℕ × ℤ) := [(5, 0), (19, 0), (37, 0), (47, 0), (67, 0), (107, -1), (179, 0), (239, 0), (353, 0), (421, -1)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, all pairs. -/
theorem all23 : allOk 23 262131 169857 8 2 18 5 18 41 1 pairs = true := by
  decide +kernel

theorem coeff_ok (Q : ℕ) [Fact Q.Prime] (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    coeff 1 (TT 23 Q (Ψ 23 (Pser 23 1))) = muE 23 Q ε * coeff 1 (Ψ 23 (Pser 23 1)) ∧
      coeff 1 (Ψ 23 (Pser 23 1)) ≠ 0 :=
  allOk_sound 23 (by norm_num) (by decide) (kN := 18) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by decide) all23 Q ε hmem

theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    TT 23 Q (Ψ 23 (Pser 23 1)) = C (muE 23 Q ε) * Ψ 23 (Pser 23 1) :=
  eigen_of_etaHecke 23 Q (by norm_num) (by norm_num) Cert23.h24 Cert23.f Cert23.form_f
    (by rw [← coeff_zero_eq_constantCoeff_apply]; exact Cert23.coeff_zero_f)
    ((((1 : ℤ)) : ZMod 23)) (by decide) Cert23.eigen.1
    (RamanujanTau.AtkinSporadic.EigenLift.etaHeckeMod_23 hQ5) _ (coeff_ok Q ε hmem).1

instance factQ5 : Fact (Nat.Prime 5) := ⟨by norm_num⟩

/-- `p((23·5³n+1)/24) ≡ 0 (mod 23)` for `5 ∤ n` (already in `AtkinSporadic.WeaverUnconditional`; reproved here). -/
theorem ono_23_5 (n : ℕ) (hn : ¬ 5 ∣ n) (h : 24 ∣ 23 * 5 ^ 3 * n + 1) :
    23 ∣ Fintype.card (Nat.Partition ((23 * 5 ^ 3 * n + 1) / 24)) :=
  ono_of_eigen 23 (by decide) 5 (by norm_num) (eigen 5 (by norm_num) 0 (by decide)) n hn h


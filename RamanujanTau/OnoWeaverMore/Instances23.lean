instance factQ107 : Fact (Nat.Prime 107) := ⟨by norm_num⟩

/-- Atkin type: `p((23·107²m+1)/24) ≡ 0 (mod 23)` whenever `(m/107) = (-1)`. -/
theorem atkin_23_107 (m : ℕ) (hm : 24 ∣ 23 * 107 ^ 2 * m + 1) (hQm : legendreSym 107 m = (-1)) :
    23 ∣ Fintype.card (Nat.Partition ((23 * 107 ^ 2 * m + 1) / 24)) :=
  atkin_of_eigen 23 (by decide) 107 (by norm_num) (-1) (by norm_num)
    (eigen 107 (by norm_num) (-1) (by decide)) m hm hQm

/-- Explicit progression: `23 ∣ p(28175989n + 800953)` for all `n`
(`24·800953 − 1 = 23·107²·73`, `(73/107) = -1`). -/
theorem atkin_23_107_progression (n : ℕ) : 23 ∣ Fintype.card (Nat.Partition (28175989 * n + 800953)) := by
  have h := atkin_23_107 (73 + 2568 * n) (by norm_num; omega) (by
    rw [legendreSym.mod]
    have : ((((73 + 2568 * n : ℕ)) : ℤ) % (107 : ℕ)) = 73 := by push_cast; omega
    rw [this, RamanujanTau.AtkinSporadic.legendreSym_val 107 (by norm_num)]
    decide)
  have e : (23 * 107 ^ 2 * (73 + 2568 * n) + 1) / 24 = 28175989 * n + 800953 := by
    norm_num; omega
  rwa [e] at h


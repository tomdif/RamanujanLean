import RamanujanTau.OnoWeaverMore.Eigen2931

/-!
# Ono–Weaver congruences modulo 29, both types, for primes `Q < 500`

Generated by `scripts/onoweavermore/gen_instances.py` from `scan.py` (exact `p(n) mod 29`).
One kernel-certified prefix of 4,505,551 partition numbers modulo 29 (`all29`) supplies the
coefficient `q^2` of `T(Q²) Σ p(29N − 35) q^N` for every `Q` in the list; the eigen-relation is
`eigen_29` (Shimura lift + dimension-one certificate at weight 26).
Pairs `(Q, ε)`: `ε = 0` is Ono's type (`29 ∣ p((29Q³n+1)/24)`, `Q ∤ n`), `ε = ±1` is Atkin's
type (`29 ∣ p((29Q²m+1)/24)` whenever `(m/Q) = ε`).
-/

set_option autoImplicit false

namespace RamanujanTau.OnoWeaverMore.L29
open PowerSeries BoylanWebb RamanujanTau.OnoWeaverMore

instance factL : Fact (Nat.Prime 29) := ⟨by norm_num⟩

/-- The pairs `(Q, ε)` certified modulo 29. -/
def pairs : List (ℕ × ℤ) := [(17, -1), (41, 1), (137, 1), (139, 1), (193, 1), (227, 1), (229, -1), (331, 0), (347, 1), (367, -1), (431, 1), (439, -1), (443, -1)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, all pairs. -/
theorem all29 : allOk 29 262131 4505551 8 7 23 5 18 46 2 pairs = true := by
  decide +kernel

theorem coeff_ok (Q : ℕ) [Fact Q.Prime] (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    coeff 2 (TT 29 Q (Ψ 29 (Pser 29 1))) = muE 29 Q ε * coeff 2 (Ψ 29 (Pser 29 1)) ∧
      coeff 2 (Ψ 29 (Pser 29 1)) ≠ 0 :=
  allOk_sound 29 (by norm_num) (by decide) (kN := 23) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by decide) all29 Q ε hmem

theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    TT 29 Q (Ψ 29 (Pser 29 1)) = C (muE 29 Q ε) * Ψ 29 (Pser 29 1) :=
  eigen_of_exists 29 Q 2 _ (eigen_29 Q hQ5) (coeff_ok Q ε hmem)

instance factQ17 : Fact (Nat.Prime 17) := ⟨by norm_num⟩

/-- Atkin type: `p((29·17²m+1)/24) ≡ 0 (mod 29)` whenever `(m/17) = (-1)`. -/
theorem atkin_29_17 (m : ℕ) (hm : 24 ∣ 29 * 17 ^ 2 * m + 1) (hQm : legendreSym 17 m = (-1)) :
    29 ∣ Fintype.card (Nat.Partition ((29 * 17 ^ 2 * m + 1) / 24)) :=
  atkin_of_eigen 29 (by decide) 17 (by norm_num) (-1) (by norm_num)
    (eigen 17 (by norm_num) (-1) (by decide)) m hm hQm

/-- Explicit progression: `29 ∣ p(142477n + 31778)` for all `n`
(`24·31778 − 1 = 29·17²·91`, `(91/17) = -1`). -/
theorem atkin_29_17_progression (n : ℕ) : 29 ∣ Fintype.card (Nat.Partition (142477 * n + 31778)) := by
  have h := atkin_29_17 (91 + 408 * n) (by norm_num; omega) (by
    rw [legendreSym.mod]
    have : ((((91 + 408 * n : ℕ)) : ℤ) % (17 : ℕ)) = 6 := by push_cast; omega
    rw [this, RamanujanTau.AtkinSporadic.legendreSym_val 17 (by norm_num)]
    decide)
  have e : (29 * 17 ^ 2 * (91 + 408 * n) + 1) / 24 = 142477 * n + 31778 := by
    norm_num; omega
  rwa [e] at h


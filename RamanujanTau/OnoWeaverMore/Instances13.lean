instance factQ97 : Fact (Nat.Prime 97) := ⟨by norm_num⟩

/-- Atkin type: `p((13·97²m+1)/24) ≡ 0 (mod 13)` whenever `(m/97) = 1`. -/
theorem atkin_13_97 (m : ℕ) (hm : 24 ∣ 13 * 97 ^ 2 * m + 1) (hQm : legendreSym 97 m = 1) :
    13 ∣ Fintype.card (Nat.Partition ((13 * 97 ^ 2 * m + 1) / 24)) :=
  atkin_of_eigen 13 (by decide) 97 (by norm_num) 1 (by norm_num)
    (eigen 97 (by norm_num) 1 (by decide)) m hm hQm

/-- Explicit progression: `13 ∣ p(11864749n + 56062)` for all `n`
(`24·56062 − 1 = 13·97²·11`, `(11/97) = 1`). -/
theorem atkin_13_97_progression (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (11864749 * n + 56062)) := by
  have h := atkin_13_97 (11 + 2328 * n) (by norm_num; omega) (by
    rw [legendreSym.mod]
    have : ((((11 + 2328 * n : ℕ)) : ℤ) % (97 : ℕ)) = 11 := by push_cast; omega
    rw [this, RamanujanTau.AtkinSporadic.legendreSym_val 97 (by norm_num)]
    decide)
  have e : (13 * 97 ^ 2 * (11 + 2328 * n) + 1) / 24 = 11864749 * n + 56062 := by
    norm_num; omega
  rwa [e] at h


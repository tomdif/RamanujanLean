import RamanujanTau.OnoWeaverMore.Core

/-!
# Ono–Weaver congruences modulo 13, both types, for primes `Q < 500`

Generated by `scripts/onoweavermore/gen_instances.py` from `scan.py` (exact `p(n) mod 13`).
One kernel-certified prefix of 1,367,087 partition numbers modulo 13 (`all13`) supplies the
coefficient `q^1` of `T(Q²) Σ p(13N − 7) q^N` for every `Q` in the list; the eigen-relation is
`EigenLift.etaHeckeMod_13` (Shimura lift + dimension-one certificate).
Pairs `(Q, ε)`: `ε = 0` is Ono's type (`13 ∣ p((13Q³n+1)/24)`, `Q ∤ n`), `ε = ±1` is Atkin's
type (`13 ∣ p((13Q²m+1)/24)` whenever `(m/Q) = ε`).
-/

set_option autoImplicit false

namespace RamanujanTau.OnoWeaverMore.L13
open PowerSeries BoylanWebb RamanujanTau.OnoWeaverMore

instance factL : Fact (Nat.Prime 13) := ⟨by norm_num⟩

/-- The pairs `(Q, ε)` certified modulo 13. -/
def pairs : List (ℕ × ℤ) := [(59, 0), (73, 0), (97, 1), (103, -1), (109, 1), (131, 0), (167, 0), (191, -1), (241, -1), (251, -1), (283, -1), (389, 0), (397, 1), (409, -1), (433, 0), (439, -1), (463, 1), (479, 0)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, all pairs. -/
theorem all13 : allOk 13 262132 1367087 8 4 21 4 18 43 1 pairs = true := by
  decide +kernel

theorem coeff_ok (Q : ℕ) [Fact Q.Prime] (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    coeff 1 (TT 13 Q (Ψ 13 (Pser 13 1))) = muE 13 Q ε * coeff 1 (Ψ 13 (Pser 13 1)) ∧
      coeff 1 (Ψ 13 (Pser 13 1)) ≠ 0 :=
  allOk_sound 13 (by norm_num) (by decide) (kN := 21) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by decide) all13 Q ε hmem

theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    TT 13 Q (Ψ 13 (Pser 13 1)) = C (muE 13 Q ε) * Ψ 13 (Pser 13 1) :=
  eigen_of_etaHecke 13 Q (by norm_num) (by norm_num) Cert13.h24 Cert13.f Cert13.form_f
    (by rw [← coeff_zero_eq_constantCoeff_apply]; exact Cert13.coeff_zero_f)
    ((((11 : ℤ)) : ZMod 13)) (by decide) Cert13.eigen.1
    (RamanujanTau.AtkinSporadic.EigenLift.etaHeckeMod_13 hQ5) _ (coeff_ok Q ε hmem).1

instance factQ59 : Fact (Nat.Prime 59) := ⟨by norm_num⟩

/-- `p((13·59³n+1)/24) ≡ 0 (mod 13)` for `59 ∤ n` (already in `AtkinSporadic.WeaverUnconditional`; reproved here). -/
theorem ono_13_59 (n : ℕ) (hn : ¬ 59 ∣ n) (h : 24 ∣ 13 * 59 ^ 3 * n + 1) :
    13 ∣ Fintype.card (Nat.Partition ((13 * 59 ^ 3 * n + 1) / 24)) :=
  ono_of_eigen 13 (by decide) 59 (by norm_num) (eigen 59 (by norm_num) 0 (by decide)) n hn h


import RamanujanTau.OnoWeaverMore.Eigen2931

/-!
# Ono–Weaver congruences modulo 31, both types, for primes `Q < 500`

Generated by `scripts/onoweavermore/gen_instances.py` from `scan.py` (exact `p(n) mod 31`).
One kernel-certified prefix of 4,707,187 partition numbers modulo 31 (`all31`) supplies the
coefficient `q^2` of `T(Q²) Σ p(31N − 40) q^N` for every `Q` in the list; the eigen-relation is
`eigen_31` (Shimura lift + dimension-one certificate at weight 28).
Pairs `(Q, ε)`: `ε = 0` is Ono's type (`31 ∣ p((31Q³n+1)/24)`, `Q ∤ n`), `ε = ±1` is Atkin's
type (`31 ∣ p((31Q²m+1)/24)` whenever `(m/Q) = ε`).
-/

set_option autoImplicit false

namespace RamanujanTau.OnoWeaverMore.L31
open PowerSeries BoylanWebb RamanujanTau.OnoWeaverMore

instance factL : Fact (Nat.Prime 31) := ⟨by norm_num⟩

/-- The pairs `(Q, ε)` certified modulo 31. -/
def pairs : List (ℕ × ℤ) := [(101, -1), (107, 0), (179, -1), (181, -1), (193, 1), (229, 0), (239, -1), (271, -1), (283, 0), (383, 0), (463, 0)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, all pairs. -/
theorem all31 : allOk 31 262136 4707187 8 7 23 5 18 46 2 pairs = true := by
  decide +kernel

theorem coeff_ok (Q : ℕ) [Fact Q.Prime] (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    coeff 2 (TT 31 Q (Ψ 31 (Pser 31 1))) = muE 31 Q ε * coeff 2 (Ψ 31 (Pser 31 1)) ∧
      coeff 2 (Ψ 31 (Pser 31 1)) ≠ 0 :=
  allOk_sound 31 (by norm_num) (by decide) (kN := 23) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by decide) all31 Q ε hmem

theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (ε : ℤ) (hmem : (Q, ε) ∈ pairs) :
    TT 31 Q (Ψ 31 (Pser 31 1)) = C (muE 31 Q ε) * Ψ 31 (Pser 31 1) :=
  eigen_of_exists 31 Q 2 _ (eigen_31 Q hQ5) (coeff_ok Q ε hmem)

instance factQ101 : Fact (Nat.Prime 101) := ⟨by norm_num⟩

/-- Atkin type: `p((31·101²m+1)/24) ≡ 0 (mod 31)` whenever `(m/101) = (-1)`. -/
theorem atkin_31_101 (m : ℕ) (hm : 24 ∣ 31 * 101 ^ 2 * m + 1) (hQm : legendreSym 101 m = (-1)) :
    31 ∣ Fintype.card (Nat.Partition ((31 * 101 ^ 2 * m + 1) / 24)) :=
  atkin_of_eigen 31 (by decide) 101 (by norm_num) (-1) (by norm_num)
    (eigen 101 (by norm_num) (-1) (by decide)) m hm hQm

/-- Explicit progression: `31 ∣ p(31939331n + 540228)` for all `n`
(`24·540228 − 1 = 31·101²·41`, `(41/101) = -1`). -/
theorem atkin_31_101_progression (n : ℕ) : 31 ∣ Fintype.card (Nat.Partition (31939331 * n + 540228)) := by
  have h := atkin_31_101 (41 + 2424 * n) (by norm_num; omega) (by
    rw [legendreSym.mod]
    have : ((((41 + 2424 * n : ℕ)) : ℤ) % (101 : ℕ)) = 41 := by push_cast; omega
    rw [this, RamanujanTau.AtkinSporadic.legendreSym_val 101 (by norm_num)]
    decide)
  have e : (31 * 101 ^ 2 * (41 + 2424 * n) + 1) / 24 = 31939331 * n + 540228 := by
    norm_num; omega
  rwa [e] at h

instance factQ107 : Fact (Nat.Prime 107) := ⟨by norm_num⟩

/-- `p((31·107³n+1)/24) ≡ 0 (mod 31)` for `107 ∤ n`. -/
theorem ono_31_107 (n : ℕ) (hn : ¬ 107 ∣ n) (h : 24 ∣ 31 * 107 ^ 3 * n + 1) :
    31 ∣ Fintype.card (Nat.Partition ((31 * 107 ^ 3 * n + 1) / 24)) :=
  ono_of_eigen 31 (by decide) 107 (by norm_num) (eigen 107 (by norm_num) 0 (by decide)) n hn h


lemma distb25 : ∀ i j : Fin 12, i ≠ j → (peb25 i - peb25 j) % 180 = 0 → (pmb25 i - pmb25 j) % 84 ≠ 0 := by decide

theorem Fb25_eq_zero : Fb25 = 0 :=
  zero_count (NQ := 5 * 36) (by norm_num) 11 (neg_ne_zero.mpr (zpow_ne_zero _ hm1))
    (FS_mem_Th hq36 150 (-1) (by simp)) peb25 (fun i => Z84 ^ pmb25 i) (fun i => zpow_ne_zero _ Z_ne)
    (fun i j hij a ha => Z_ne_Z (distb25 i j hij (by rw [ha]; push_cast; omega))) zerosb25

/-- **HM Theorem 0.3 for `f_{2,3,2}` at `y = −t^{150}`, `q = t^{36}`**, at every good `x`. -/
theorem hm03_b25 (ex : ℤ) {cx : ℂ} (h : CGood (-1) cx) :
    Jb hq36 * ev (fS hq36 150 (-1)) ex cx =
      gNum hq36 150 (-1) ex cx + kap (h5 hq36) * thV hq36 150 (-1) ex cx := by
  have h1 := FS_ev hq36 150 (-1) ex hm1 h
  have h0 : ev Fb25 ex cx = 0 := by rw [Fb25_eq_zero]; exact ev_zero ex _
  unfold Fb25 at h0
  rw [h0] at h1
  have := (mul_eq_zero.mp h1.symm).resolve_left (Pv_ne hq36 150 _ hm1 h ex)
  unfold Dv at this
  linear_combination this


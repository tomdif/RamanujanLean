/-- **HM Theorem 0.3 for `f_{2,3,2}` at `y = −t^{78}`, `q = t^{36}`**, at every good `x`. -/
theorem hm03_b13 (ex : ℤ) {cx : ℂ} (h : CGood (-1) cx) :
    Jb hq36 * ev (fS hq36 78 (-1)) ex cx =
      gNum hq36 78 (-1) ex cx + kap (h5 hq36) * thV hq36 78 (-1) ex cx := by
  have h1 := FS_ev hq36 78 (-1) ex hm1 h
  have h0 : ev Fb13 ex cx = 0 := by rw [Fb13_eq_zero]; exact ev_zero ex _
  unfold Fb13 at h0
  rw [h0] at h1
  have := (mul_eq_zero.mp h1.symm).resolve_left (Pv_ne hq36 78 _ hm1 h ex)
  unfold Dv at this
  linear_combination this


def peb7 : Fin 12 → ℤ := ![-20, -20, -20, 40, 40, 40, 100, 100, 100, 135, 135, 45]
def pmb7 : Fin 12 → ℤ := ![42, 14, 70, 42, 14, 70, 42, 14, 70, 84, 42, 84]

lemma zerosb7 (i : Fin 12) : ev Fb7 (peb7 i) (Z84 ^ pmb7 i) = 0 := by
  fin_cases i
  · exact zb7_0
  · exact zb7_1
  · exact zb7_2
  · exact zb7_3
  · exact zb7_4
  · exact zb7_5
  · exact zb7_6
  · exact zb7_7
  · exact zb7_8
  · exact zb7_9
  · exact zb7_10
  · exact zb7_11

lemma distb7 : ∀ i j : Fin 12, i ≠ j → (peb7 i - peb7 j) % 180 = 0 → (pmb7 i - pmb7 j) % 84 ≠ 0 := by decide

theorem Fb7_eq_zero : Fb7 = 0 :=
  zero_count (NQ := 5 * 36) (by norm_num) 11 (neg_ne_zero.mpr (zpow_ne_zero _ hm1))
    (FS_mem_Th hq36 42 (-1) (by simp)) peb7 (fun i => Z84 ^ pmb7 i) (fun i => zpow_ne_zero _ Z_ne)
    (fun i j hij a ha => Z_ne_Z (distb7 i j hij (by rw [ha]; push_cast; omega))) zerosb7

/-- **HM Theorem 0.3 for `f_{2,3,2}` at `y = −t^{42}`, `q = t^{36}`**, at every good `x`. -/
theorem hm03_b7 (ex : ℤ) {cx : ℂ} (h : CGood (-1) cx) :
    Jb hq36 * ev (fS hq36 42 (-1)) ex cx =
      gNum hq36 42 (-1) ex cx + kap (h5 hq36) * thV hq36 42 (-1) ex cx := by
  have h1 := FS_ev hq36 42 (-1) ex hm1 h
  have h0 : ev Fb7 ex cx = 0 := by rw [Fb7_eq_zero]; exact ev_zero ex _
  unfold Fb7 at h0
  rw [h0] at h1
  have := (mul_eq_zero.mp h1.symm).resolve_left (Pv_ne hq36 42 _ hm1 h ex)
  unfold Dv at this
  linear_combination this


lemma Pv_ne {qe : ℕ} (hqe : 1 ≤ qe) (ey : ℤ) (cy : ℂ) (hcy : cy ≠ 0) {cx : ℂ} (h : CGood cy cx) (ex : ℤ) :
    Pv hqe ey cy ex cx ≠ 0 := h.td hqe ey cy hcy ex

lemma hq36 : 1 ≤ 36 := by norm_num

lemma hm1 : (-1 : ℂ) ≠ 0 := by norm_num


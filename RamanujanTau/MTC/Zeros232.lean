def pmb25 : Fin 12 → ℤ := ![42, 14, 70, 42, 14, 70, 42, 14, 70, 84, 42, 84]

lemma zerosb25 (i : Fin 12) : ev Fb25 (peb25 i) (Z84 ^ pmb25 i) = 0 := by
  fin_cases i
  · exact zb25_0
  · exact zb25_1
  · exact zb25_2
  · exact zb25_3
  · exact zb25_4
  · exact zb25_5
  · exact zb25_6
  · exact zb25_7

/-- the degree-23 equation in `ℂ((t))`, `t² = q`. -/
theorem L23 : mono 2 1 * (2 * (θ hm6 2 1 * θ hm138 46 1)) =
    (θ hm8 4 1 * θ hm184 92 1) - 2 * (mono 6 1 * (θ hm8 2 1 * θ hm184 46 1)) - θ hm4 2 1 * θ hm92 46 1 := by
  rw [← LA23, ← LB23, ← LC23, S23a, S23b, S23c, S23r, S23s, S23t]
  simp only [show (mono 2 1 : L) = mono 1 1 ^ 2 from monoT23 2, show (mono 4 1 : L) = mono 1 1 ^ 4 from monoT23 4]
  ring

/-- product form: `2q f(−q)f(−q²³) = φ(−q²)φ(−q⁴⁶) − 2q³ψ(−q)ψ(−q²³) − φ(−q)φ(−q²³)`. -/
theorem P23 : 2 * PowerSeries.X * (J 1 3 * J 23 69) =
    J 2 4 * J 46 92 - 2 * PowerSeries.X ^ 3 * (J 1 4 * J 23 92) - J 1 2 * J 23 46 := by
  apply S_inj 2
  have h := L23
  rw [θu' hm6 2 (e' := 2) (by norm_num) (by norm_num) (by norm_num),
    θu' hm138 46 (e' := 46) (by norm_num) (by norm_num) (by norm_num),
    θu' hm8 4 (e' := 4) (by norm_num) (by norm_num) (by norm_num),
    θu' hm8 2 (e' := 2) (by norm_num) (by norm_num) (by norm_num),
    θu' hm184 92 (e' := 92) (by norm_num) (by norm_num) (by norm_num),
    θu' hm184 46 (e' := 46) (by norm_num) (by norm_num) (by norm_num),
    θu' hm4 2 (e' := 2) (by norm_num) (by norm_num) (by norm_num),
    θu' hm92 46 (e' := 46) (by norm_num) (by norm_num) (by norm_num)] at h
  simp only [show (mono 2 1 : L) = mono 1 1 ^ 2 from monoT23 2, show (mono 6 1 : L) = mono 1 1 ^ 6 from monoT23 6] at h
  apply ι_inj
  simp only [map_sub, map_add, map_mul, map_pow, map_ofNat, S_J 2 1 3 (by norm_num) (by norm_num),
    S_J 2 23 69 (by norm_num) (by norm_num), S_J 2 2 4 (by norm_num) (by norm_num),
    S_J 2 46 92 (by norm_num) (by norm_num), S_J 2 1 4 (by norm_num) (by norm_num),
    S_J 2 23 92 (by norm_num) (by norm_num), S_J 2 1 2 (by norm_num) (by norm_num),
    S_J 2 23 46 (by norm_num) (by norm_num), show (S 2) PowerSeries.X = PowerSeries.X ^ 2 from RankProof.Ea_X 2 _]
  simp only [Nat.reduceMul, ι_X, map_pow]
  linear_combination h

lemma S23_chip1 : S 23 (chip 1) = chip 23 := by rw [chip, S_one]; rfl

/-- **The degree-23 modular equation** (Schröter; Ramanujan; Yesilyurt (4.28)):
`χ(q)χ(q²³) − χ(−q)χ(−q²³) = 2q + 2q³/(χ(−q²)χ(−q⁴⁶))`. -/
theorem M23 : chip 1 * chip 23 - chim 1 * chim 23 =
    2 * PowerSeries.X + 2 * PowerSeries.X ^ 3 * Ring.inverse (chim 2 * chim 46) := by
  have hc1 := chip_mul 1
  norm_num at hc1
  have hsp := E1_split
  have a2 := atom 2 2 4 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  simp only [prod_range_succ, prod_range_zero, one_mul] at a2
  norm_num at a2
  have l1 : chip 1 * Pinf 1 1 = J 2 4 := by
    simp only [J, Nat.reduceSub]; rw [hsp, a2]; linear_combination (Pinf 2 4 * Pinf 4 4) * hc1
  have m1 : chim 1 * Pinf 1 1 = J 1 2 := by
    simp only [J, chim, Nat.reduceSub, Nat.reduceMul]; rw [hsp]; ring
  have n1 : Pinf 2 4 * J 1 4 = Pinf 1 1 := by
    simp only [J, Nat.reduceSub]
    simp (disch := norm_num) only [atom _ _ 4]
    simp only [prod_range_succ, prod_range_zero, one_mul, Nat.reduceMul, Nat.reduceAdd, Nat.reduceDiv, mul_zero,
      add_zero, mul_one]
    ring
  have k1 : J 1 3 = Pinf 1 1 := by
    simp only [J, Nat.reduceSub]
    simp (disch := norm_num) only [atom _ _ 3]
    simp only [prod_range_succ, prod_range_zero, one_mul, Nat.reduceMul, Nat.reduceAdd, Nat.reduceDiv, mul_zero,
      add_zero, mul_one]
  have l23 := congrArg (S 23) l1
  have m23 := congrArg (S 23) m1
  have n23 := congrArg (S 23) n1
  have k23 := congrArg (S 23) k1
  simp only [map_mul, S23_chip1, chim, S_P' 23 1 1 le_rfl le_rfl (rfl : 23 = 23 * 1) (rfl : 23 = 23 * 1),
    S_P' 23 1 2 le_rfl (by norm_num) (rfl : 23 = 23 * 1) (rfl : 46 = 23 * 2),
    S_P' 23 2 4 (by norm_num) (by norm_num) (rfl : 46 = 23 * 2) (rfl : 92 = 23 * 4),
    S_J' 23 2 4 (by norm_num) (by norm_num) (rfl : 46 = 23 * 2) (rfl : 92 = 23 * 4),
    S_J' 23 1 2 le_rfl (by norm_num) (rfl : 23 = 23 * 1) (rfl : 46 = 23 * 2),
    S_J' 23 1 3 le_rfl (by norm_num) (rfl : 23 = 23 * 1) (rfl : 69 = 23 * 3),
    S_J' 23 1 4 le_rfl (by norm_num) (rfl : 23 = 23 * 1) (rfl : 92 = 23 * 4), Nat.reduceMul] at l23 m23 n23 k23
  have hu : IsUnit (chim 2 * chim 46) :=
    (isUnit_Pinf 2 4 (by norm_num) (by norm_num)).mul (isUnit_Pinf 46 92 (by norm_num) (by norm_num))
  have hinv := Ring.inverse_mul_cancel _ hu
  simp only [chim, Nat.reduceMul] at hinv m1 ⊢
  have P := P23
  have hW : (Pinf 1 1 * Pinf 23 23 : PowerSeries ℤ) ≠ 0 :=
    mul_ne_zero (Pinf_ne 1 1 le_rfl le_rfl) (Pinf_ne 23 23 (by norm_num) (by norm_num))
  apply mul_left_cancel₀ hW
  linear_combination -P + 2 * PowerSeries.X * J 23 69 * k1 + 2 * PowerSeries.X * Pinf 1 1 * k23
    + (chip 23 * Pinf 23 23) * l1 + J 2 4 * l23
    - (Pinf 23 46 * Pinf 23 23) * m1 - J 1 2 * m23
    + 2 * PowerSeries.X ^ 3 * Ring.inverse (Pinf 2 4 * Pinf 46 92) * Pinf 23 23 * n1
    + 2 * PowerSeries.X ^ 3 * Ring.inverse (Pinf 2 4 * Pinf 46 92) * Pinf 2 4 * J 1 4 * n23
    - 2 * PowerSeries.X ^ 3 * (J 1 4 * J 23 92) * hinv

end Forty

private lemma monoT (k : ℕ) : (mono (k : ℤ) 1 : L) = mono 1 1 ^ k := by
  rw [mono, single_pow]; simp

lemma SkX (k : ℕ) [NeZero k] : S k X = X ^ k := RankProof.Ea_X k _

lemma S_fb_s (k : ℕ) [NeZero k] (e N : ℕ) (h1 : 1 ≤ e) (h2 : e < N) : S k (fb e N) = fb (k * e) (k * N) :=
  S_fb k e N h1 h2 rfl rfl

lemma S_fb0_s (k : ℕ) [NeZero k] (N : ℕ) (h : 1 ≤ N) : S k (fb0 N) = fb0 (k * N) := S_fb0 k N h rfl

lemma Ng_fb_ev (e N : ℕ) (he : Even e) (hN : Even N) (h1 : 1 ≤ e) (h2 : e < N) : Ng (fb e N) = fb e N := by
  obtain ⟨a, rfl⟩ := he
  obtain ⟨b, rfl⟩ := hN
  rw [show a + a = 2 * a by ring, show b + b = 2 * b by ring]
  exact Ng_fb_even a b (by omega) (by omega)

lemma Ng_fb0_ev (N : ℕ) (hN : Even N) (h : 1 ≤ N) : Ng (fb0 N) = fb0 N := by
  obtain ⟨b, rfl⟩ := hN
  rw [show b + b = 2 * b by ring]

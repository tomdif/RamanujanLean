import RamanujanTau.BLBound.Threshold
import RamanujanTau.FiniteArithmetic.DeterminantRank

/-!
# A uniform determinant criterion for the lower bound `b_ℓ(m) ≥ 2m − 1`

For every prime `ℓ ≥ 13` and every precision `m`, the stable odd module
`Λ^odd(b, m)` is generated by at most `R = ⌊(ℓ+12)/24⌋` elements
(`BLBound.rank_Lam_le`, a consequence of Theorem A). Hence any `R + 1` series of
an odd tail that has already stabilized have all `(R+1)`-coefficient minors equal
to zero modulo `ℓ^m` (`FiniteArithmetic.card_le_of_coeff_det_ne_zero`).

Contrapositively (`lt_bEll_of_det`): one `(R+1) × (R+1)` coefficient minor of
`L(2k+1+2c₀), …, L(2k+1+2c_R)` that is nonzero modulo `ℓ^m` forces `b_ℓ(m) > 2k+1`.
At `k = m − 2` this gives the exact value `b_ℓ(m) = 2m − 1` (`bEll_eq_of_det`).
The integer form `bEll_eq_of_int_det` asks only that `ℓ^m` not divide one integer
minor of the actual partition series.

No recurrence, no operator `Θ`, no seed and no Katz model enter. The statement is
uniform in `ℓ ≥ 13`; for a given `ℓ` and `m` it reduces sharpness to the
`ℓ`-adic valuation of a single integer determinant.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanTau.BWSharpAll
open PowerSeries BoylanWebb BLBound

noncomputable section

variable {ℓ : ℕ} [hℓ : Fact ℓ.Prime]

/-- If `2k+1` lies in the stable range, the next tail is no smaller. -/
theorem Lam_eq_of_mem_bSet (h13 : 13 ≤ ℓ) (m : ℕ) (hm : 1 ≤ m) (k : ℕ)
    (h : 2 * k + 1 ∈ bSet ℓ m) : Lam ℓ m (2 * k + 1) = Lam ℓ m (2 * (k + 1) + 1) := by
  by_cases hL : redm ℓ m (L ℓ (2 * k + 1)) ∈ Lam ℓ m (2 * (k + 1) + 1)
  · apply le_antisymm _ (Lam_anti m k)
    rw [Lam, Submodule.span_le]
    rintro _ ⟨j, hj, rfl⟩
    rcases Nat.eq_or_lt_of_le (show k ≤ j by omega) with rfl | hlt
    · exact hL
    · exact Submodule.subset_span ⟨j, by omega, rfl⟩
  · exact absurd h (not_mem_bSet h13 m hm k hL)

/-- One equality of consecutive tails propagates to every later tail. -/
theorem Lam_eq_of_eq (m k : ℕ) (h : Lam ℓ m (2 * k + 1) = Lam ℓ m (2 * (k + 1) + 1)) (j : ℕ) :
    Lam ℓ m (2 * k + 1) = Lam ℓ m (2 * (k + j) + 1) := by
  induction j with
  | zero => simp
  | succ j ih =>
    have hstep : ∀ i, Lam ℓ m (2 * (k + i) + 1) = Lam ℓ m (2 * (k + i + 1) + 1) := by
      intro i
      induction i with
      | zero => simpa using h
      | succ i ihi =>
        rw [show k + (i + 1) = k + i + 1 by ring, ← Xm_map (ℓ := ℓ) m (k + i), ihi, Xm_map]
    rw [ih, hstep j, show k + (j + 1) = k + j + 1 by ring]

/-- **Uniform lower-bound criterion.** A single `(R+1)`-minor of coefficients of odd-chain
series at or beyond `L(2k+1)`, nonzero modulo `ℓ^m`, forces `b_ℓ(m) > 2k+1`. -/
theorem lt_bEll_of_det (h13 : 13 ≤ ℓ) (m : ℕ) (hm : 1 ≤ m) (k : ℕ)
    (c : Fin ((ℓ + 12) / 24 + 1) → ℕ) (rows : Fin ((ℓ + 12) / 24 + 1) → ℕ)
    (hdet : Matrix.det (fun i j => coeff (rows i) (redm ℓ m (L ℓ (2 * (k + c j) + 1)))) ≠ 0) :
    2 * k + 1 < bEll ℓ m := by
  by_contra hle
  rw [not_lt] at hle
  have hne : (bSet ℓ m).Nonempty := ⟨_, mem_bSet h13 m hm (m - 1) (by omega)⟩
  have hmem := Nat.sInf_mem hne
  obtain ⟨⟨j, hj⟩, -⟩ := hmem
  have hjb : bEll ℓ m = 2 * j + 1 := by unfold bEll; omega
  have hjk : j ≤ k := by omega
  have hmemj : 2 * j + 1 ∈ bSet ℓ m := by rw [← hjb]; exact Nat.sInf_mem hne
  have hstab := Lam_eq_of_eq m j (Lam_eq_of_mem_bSet h13 m hm j hmemj)
  set K := max k (m - 1)
  obtain ⟨s, hs, hspan⟩ := rank_Lam_le (ℓ := ℓ) h13 m hm K (by omega)
  have hK : Lam ℓ m (2 * K + 1) = Lam ℓ m (2 * j + 1) := by
    rw [hstab (K - j), show j + (K - j) = K by omega]
  have hv : ∀ i, redm ℓ m (L ℓ (2 * (k + c i) + 1)) ∈ Submodule.span (Rm ℓ m) (s : Set _) := by
    intro i
    rw [hspan, hK, hstab (k + c i - j), show j + (k + c i - j) = k + c i by omega]
    exact Submodule.subset_span ⟨k + c i, le_rfl, rfl⟩
  have := FiniteArithmetic.card_le_of_coeff_det_ne_zero
    (fun i => redm ℓ m (L ℓ (2 * (k + c i) + 1))) rows s hv hdet
  omega

/-- **Exact sharpness at one precision from one determinant.** -/
theorem bEll_eq_of_det (h13 : 13 ≤ ℓ) (m : ℕ) (hm : 2 ≤ m)
    (c : Fin ((ℓ + 12) / 24 + 1) → ℕ) (rows : Fin ((ℓ + 12) / 24 + 1) → ℕ)
    (hdet : Matrix.det
      (fun i j => coeff (rows i) (redm ℓ m (L ℓ (2 * (m - 2 + c j) + 1)))) ≠ 0) :
    bEll ℓ m = 2 * m - 1 := by
  have h1 := lt_bEll_of_det h13 m (by omega) (m - 2) c rows hdet
  have h2 := bEll_le h13 m (by omega)
  have hne : (bSet ℓ m).Nonempty := ⟨_, mem_bSet h13 m (by omega) (m - 1) (by omega)⟩
  obtain ⟨⟨j, hj⟩, -⟩ := Nat.sInf_mem hne
  have : bEll ℓ m = 2 * j + 1 := by unfold bEll; omega
  omega

/-- Integer form: `ℓ^m` does not divide one integer minor of the actual series. -/
theorem bEll_eq_of_int_det (h13 : 13 ≤ ℓ) (m : ℕ) (hm : 2 ≤ m)
    (c : Fin ((ℓ + 12) / 24 + 1) → ℕ) (rows : Fin ((ℓ + 12) / 24 + 1) → ℕ)
    (hdet : ¬ ((ℓ : ℤ) ^ m ∣ Matrix.det
      (fun i j => coeff (rows i) (L ℓ (2 * (m - 2 + c j) + 1))))) :
    bEll ℓ m = 2 * m - 1 := by
  apply bEll_eq_of_det h13 m hm c rows
  have hmap : (fun i j => coeff (rows i) (redm ℓ m (L ℓ (2 * (m - 2 + c j) + 1)))) =
      (Int.castRingHom (Rm ℓ m)).mapMatrix
        (fun i j => coeff (rows i) (L ℓ (2 * (m - 2 + c j) + 1))) := by
    ext i j
    simp [PowerSeries.coeff_map]
  rw [hmap, ← RingHom.map_det]
  intro h0
  apply hdet
  have := (ZMod.intCast_zmod_eq_zero_iff_dvd _ (ℓ ^ m)).mp h0
  exact_mod_cast this

/-- Integer form of `lt_bEll_of_det`, at any tail `L(2k+1)`. -/
theorem lt_bEll_of_int_det (h13 : 13 ≤ ℓ) (m : ℕ) (hm : 1 ≤ m) (k : ℕ)
    (c : Fin ((ℓ + 12) / 24 + 1) → ℕ) (rows : Fin ((ℓ + 12) / 24 + 1) → ℕ)
    (hdet : ¬ ((ℓ : ℤ) ^ m ∣ Matrix.det
      (fun i j => coeff (rows i) (L ℓ (2 * (k + c j) + 1))))) :
    2 * k + 1 < bEll ℓ m := by
  apply lt_bEll_of_det h13 m hm k c rows
  have hmap : (fun i j => coeff (rows i) (redm ℓ m (L ℓ (2 * (k + c j) + 1)))) =
      (Int.castRingHom (Rm ℓ m)).mapMatrix
        (fun i j => coeff (rows i) (L ℓ (2 * (k + c j) + 1))) := by
    ext i j
    simp [PowerSeries.coeff_map]
  rw [hmap, ← RingHom.map_det]
  intro h0
  apply hdet
  have := (ZMod.intCast_zmod_eq_zero_iff_dvd _ (ℓ ^ m)).mp h0
  exact_mod_cast this

/-- The same criterion at every precision: `b_ℓ(m) = 2m − 1` for all `m ≥ 1` as soon as,
for each `m ≥ 2`, one integer `(R+1)`-minor at the tail `L(2m−3)` has valuation `< m`. -/
theorem bEll_eq_all_of_int_dets (h13 : 13 ≤ ℓ)
    (c : ℕ → Fin ((ℓ + 12) / 24 + 1) → ℕ) (rows : ℕ → Fin ((ℓ + 12) / 24 + 1) → ℕ)
    (hdet : ∀ m, 2 ≤ m → ¬ ((ℓ : ℤ) ^ m ∣ Matrix.det
      (fun i j => coeff (rows m i) (L ℓ (2 * (m - 2 + c m j) + 1)))))
    (m : ℕ) (hm : 1 ≤ m) : bEll ℓ m = 2 * m - 1 := by
  rcases Nat.eq_or_lt_of_le hm with rfl | hlt
  · have h2 := bEll_le h13 1 le_rfl
    have hne : (bSet ℓ 1).Nonempty := ⟨_, mem_bSet h13 1 le_rfl 0 (by omega)⟩
    obtain ⟨⟨j, hj⟩, -⟩ := Nat.sInf_mem hne
    have : bEll ℓ 1 = 2 * j + 1 := by unfold bEll; omega
    omega
  · exact bEll_eq_of_int_det h13 m hlt (c m) (rows m) (hdet m hlt)

end

end RamanujanTau.BWSharpAll

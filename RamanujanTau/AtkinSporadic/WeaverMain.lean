theorem ono_13_59 (H : EtaHeckeMod 13 59 (13 - 1) 13) (n : ℕ) (hn : ¬ 59 ∣ n)
    (h : 24 ∣ 13 * 205379 * n + 1) :
    13 ∣ Fintype.card (Nat.Partition ((13 * 205379 * n + 1) / 24)) := by
  obtain ⟨N, hN⟩ : ∃ N, 24 * N = 59 * n + 13 := ⟨(59 * n + 13) / 24, by omega⟩
  have key := weaver_index 13 59 (by norm_num) (by norm_num) (by norm_num) Cert13.h24
    (by decide +kernel) (by decide +kernel) Cert13.f Cert13.form_f
    (by rw [← coeff_zero_eq_constantCoeff_apply]; exact Cert13.coeff_zero_f)
    ((((11 : ℤ)) : ZMod 13)) (by decide) Cert13.eigen.1 20742 117 (by norm_num) (by norm_num)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) chk_13_59 H N
    (by omega) ⟨n, by push_cast; omega⟩
    (by
      rintro ⟨k, hk⟩
      apply hn
      have h1 : (59 : ℤ) * n = 59 ^ 2 * k := by push_cast at hk; linarith
      have h2 : (n : ℤ) = 59 * k := by nlinarith
      exact Int.natCast_dvd_natCast.mp ⟨k, h2⟩)
  have hs : hshift 59 13 = 1885 := by decide +kernel
  have hδ : δ 13 = 7 := by decide +kernel
  rw [hs, hδ] at key
  have e : (13 * 205379 * n + 1) / 24 = 13 * (59 ^ 2 * N - 1885) - 7 := by
    rw [show (59 : ℕ) ^ 2 = 3481 by norm_num]
    omega
  rw [e]
  exact key


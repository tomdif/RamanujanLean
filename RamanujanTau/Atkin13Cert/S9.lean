def R14 : List Poly := [ofPacked R14_b0, ofPacked R14_b1]
theorem pc14 : certifyR [(ofPacked H14, Wall.getD 20 [])] (R14).flatten = true := by
  decide +kernel
lemma pz14 : evalP ηPt (R14).flatten = 0 := by
  rw [certifyR_sound _ _ _ pc14, List.map_singleton, List.sum_singleton, W_zero_getD, mul_zero]
def Rs : List (List Poly) := [R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, R12, R13, R14]
theorem bc0 : eqRuns (Rs.map fun r => r.getD 0 []) (Ns.getD 0 []) = true := by
  decide +kernel
theorem bc1 : eqRuns (Rs.map fun r => r.getD 1 []) (Ns.getD 1 []) = true := by
  decide +kernel
theorem N_flat : (Ns).flatten = ofPacked N := by decide +kernel

theorem N_zero : evalP ηPt (ofPacked N) = 0 := by
  rw [← N_flat]
  have hlen : ∀ r ∈ Rs, r.length = 2 := by
    intro r hr
    simp only [Rs, List.mem_cons, List.mem_nil_iff, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  refine assemble ηPt 2 Ns Rs rfl hlen ?_ ?_
  · intro b hb
    have h : eqRuns (Rs.map fun r => r.getD b []) (Ns.getD b []) = true := by
      interval_cases b
      · exact bc0
      · exact bc1
    rw [eqRuns_sound _ _ _ h, List.map_map]
    rfl

/-
# Watson's congruences for powers of 7, part 1: the modular equation of degree 7

With `y = q²E(q⁴⁹)/E(q)` and `τ = qE(q⁷)⁴/E(q)⁴`:
  `y⁷ = τ(q⁷)(49y⁶ + 35y⁵ + 7y⁴) + τ(q⁷)²(343y⁶ + 343y⁵ + 147y⁴ + 49y³ + 21y² + 7y + 1)`,
and `U₇(yᵏ)` for `k ≤ 6`, all as polynomial identities modulo the relations among the 7-dissection components.
-/
import RamanujanTau.Ramanujan7Identity

set_option autoImplicit false

namespace MockTheta5.JTP
open PowerSeries Finset MockTheta5.Bailey

lemma dis7_sum {ι : Type*} (r : ℕ) (t : Finset ι) (f : ι → PowerSeries ℤ) :
    dis7 r (∑ i ∈ t, f i) = ∑ i ∈ t, dis7 r (f i) := by
  classical
  induction t using Finset.induction_on with
  | empty => ext n; simp [dis7]
  | insert a t ha ih => rw [sum_insert ha, sum_insert ha, dis7_add, ih]

lemma eq_dissection7' (f : PowerSeries ℤ) : f = ∑ r ∈ range 7, X ^ r * E7 (dis7 r f) := by
  conv_lhs => rw [eq_dissection7 f]
  simp [sum_range_succ]

/-- **the dissection of a product**: `dis7 t (F·G) = Σ_{r+s ≡ t} q^{⌊(r+s)/7⌋}·F_r·G_s`. -/
lemma dis7_mul (t : ℕ) (ht : t < 7) (F G : PowerSeries ℤ) :
    dis7 t (F * G) = ∑ r ∈ range 7, ∑ s ∈ range 7,
      if (r + s) % 7 = t then X ^ ((r + s) / 7) * dis7 r F * dis7 s G else 0 := by
  conv_lhs => rw [eq_dissection7' F, eq_dissection7' G]
  rw [sum_mul_sum, dis7_sum]
  refine sum_congr rfl fun r hr => ?_
  rw [dis7_sum]
  refine sum_congr rfl fun s hs => ?_
  simp only [mem_range] at hr hs
  rw [show X ^ r * E7 (dis7 r F) * (X ^ s * E7 (dis7 s G))
      = X ^ ((r + s) % 7) * E7 (X ^ ((r + s) / 7) * dis7 r F * dis7 s G) by
    rw [map_mul, map_mul, map_pow, E7_X, ← pow_mul]
    rw [show X ^ ((r + s) % 7) * ((X : PowerSeries ℤ) ^ (7 * ((r + s) / 7)) * E7 (dis7 r F) * E7 (dis7 s G))
        = X ^ ((r + s) % 7 + 7 * ((r + s) / 7)) * (E7 (dis7 r F) * E7 (dis7 s G)) by ring,
      Nat.mod_add_div]
    ring,
    dis7_X_pow_mul_E7 _ t (Nat.mod_lt _ (by norm_num)) ht]


lemma X2Q_nf : X ^ 2 * Qpoly7 = X ^ 0 * E7 (-7*X^3*xQ*zQ^3 + 7*X^2*yQ^3*zQ - 7*X^2 + 7*X*xQ^3*yQ) + X ^ 1 * E7 (2*X^4*zQ^5 - 14*X^2*xQ*zQ - 3*X^2*yQ^2*zQ + 10*X*xQ^3 + X*yQ^6) + X ^ 2 * E7 (10*X^3*zQ^3 + 14*X^2*yQ*zQ + 3*X*xQ^2*yQ - 2*X*yQ^5 + xQ^6) + X ^ 3 * E7 (-3*X^3*xQ*zQ^4 + X^2*zQ + 4*X*xQ^2 + 5*X*yQ^4 + xQ^5*yQ) + X ^ 4 * E7 (X^4*zQ^6 - 3*X^2*xQ*zQ^2 + 14*X*xQ*yQ - 10*X*yQ^3 + 2*xQ^5) + X ^ 5 * E7 (5*X^3*zQ^4 + X*xQ + X*yQ^5*zQ + 4*X*yQ^2 + 3*xQ^4*yQ) + X ^ 6 * E7 (-X^3*xQ*zQ^5 + 4*X^2*zQ^2 - 3*X*yQ^4*zQ - X*yQ + 5*xQ^4) := by
  rw [Qpoly7]; simp only [Fser, map_mul, map_add, map_sub, map_pow, map_ofNat, map_neg, E7_X]; ring



lemma cls1_eq0 (hg1 : X*yQ*zQ^2 - xQ + yQ^2 = 0) (hg2 : xQ*yQ*zQ - 1 = 0) (hg3 : X*zQ - xQ^2 + xQ*yQ^2 = 0)
    (hg4 : -X*zQ^2 + xQ^2*zQ - yQ = 0) :

/-- **`13 ∣ p(9164597 n + 39275)`** (`9164597 = 13·89³`; `m = 27768 n + 119`). -/
theorem atkin_13_89 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (9164597 * n + 39275)) := by
  refine atkin_13_89_class _ (27768 * n + 119) (by ring) ?_ ?_
  · rw [legendreSym.mod, show ((27768 * n + 119 : ℕ) : ℤ) % (89 : ℕ) = 30 by push_cast; omega,
      legendreSym_val 89 (by norm_num)]
    decide +kernel
  · rw [legendreSym.mod, show ((27768 * n + 119 : ℕ) : ℤ) % (13 : ℕ) = 2 by push_cast; omega,

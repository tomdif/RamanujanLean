instance fact103 : Fact (Nat.Prime 103) := ⟨by norm_num⟩

theorem sign103 : heckeSign 103 167 = 1 := by
  rw [heckeSign, legendreSym_val 103 (by norm_num), legendreSym_val 103 (by norm_num)]
  decide +kernel

theorem eigen103 : TT 103 = C 0 * Ψ 13 twPGF := eigen 103 (by norm_num) 0 (by decide)

/-- Ono type at `Q = 103` (`μ = 0`): `13 ∣ p(N)` whenever `24N − 1 = 103³n`, `103 ∤ n`,
`(103n/13) = −1`. -/
theorem ono_13_103_class (N n : ℕ) (hm : 24 * N = 103 ^ 3 * n + 1) (hQn : ¬ 103 ∣ n)
    (h13 : legendreSym 13 ((103 : ℕ) * (n : ℤ)) = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  vanish_ono 103 (by norm_num) (by decide) eigen103 N n hm hQn h13

/-- **`13 ∣ p(1463161453 n + 1866742)`** (`1463161453 = 13·103⁴`; `n' = 32136 n + 41`). -/
theorem ono_13_103 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (1463161453 * n + 1866742)) := by
  refine ono_13_103_class _ (32136 * n + 41) (by ring) (by omega) ?_
  rw [legendreSym.mod, show (((103 : ℕ) : ℤ) * ((32136 * n + 41 : ℕ) : ℤ)) % (13 : ℕ) = 11 by
      push_cast; omega, legendreSym_val 13 (by norm_num)]
  decide +kernel

end RamanujanTau.AtkinTwisted.G1

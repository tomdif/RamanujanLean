import RamanujanTau.AtkinTwisted.Core

/-!
# Atkin's twisted class modulo 13: primes `5 ≤ Q < 110` (generated by `scripts/atkintwisted/gen.py`)

One kernel-certified prefix of 166,335 partition numbers modulo 13 (`cert`) gives the 15 Sturm
coefficients of `T(Q²)F̄ − μF̄` for every prime `Q` of the list, so `F̄` is a `T(Q²)`-eigenform
with the listed `μ` (`eigen`). Atkin type (`μ = s ε Q¹⁶⁶`): `13 ∣ p(N)` when `24N − 1 = Q²m`,
`(m/Q) = ε`, `(m/13) = −1`. Ono type (`μ = 0`): `13 ∣ p(N)` when `24N − 1 = Q³n`, `Q ∤ n`,
`(Qn/13) = −1`.
-/

set_option autoImplicit false

namespace RamanujanTau.AtkinTwisted.G1
open PowerSeries BoylanWebb RamanujanTau.AtkinSporadic RamanujanTau.AtkinTwisted
open Twist13

/-- The pairs `(Q, μ)`: `T(Q²)F̄ = μF̄` modulo 13. -/
def pairs : List (ℕ × ZMod 13) := [(5, 6), (7, 7), (11, 3), (17, 7), (19, 11), (23, 7), (29, 1), (31, 6), (37, 3), (41, 9), (43, 7), (47, 4), (53, 11), (59, 6), (61, 12), (67, 9), (71, 2), (73, 4), (79, 11), (83, 7), (89, 10), (97, 2), (101, 6), (103, 0), (107, 12), (109, 7)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, every pair. -/
theorem cert : allOk 262132 166335 8 2 18 4 18 40 pairs = true := by
  decide +kernel

/-- `F̄` is a `T(Q²)`-eigenform for every `Q` of the list. -/
theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (μ : ZMod 13) (hmem : (Q, μ) ∈ pairs) :
    TT Q = C μ * Ψ 13 twPGF :=
  eigen_of_allOk (kN := 18) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by decide) cert Q hQ5 μ hmem

instance fact11 : Fact (Nat.Prime 11) := ⟨by norm_num⟩

theorem sign11 : heckeSign 11 167 = -1 := by
  rw [heckeSign, legendreSym_val 11 (by norm_num), legendreSym_val 11 (by norm_num)]
  decide +kernel

theorem eigen11 : TT 11 = C 3 * Ψ 13 twPGF := eigen 11 (by norm_num) 3 (by decide)

/-- Atkin type at `Q = 11` (`μ = 3`): `13 ∣ p(N)` whenever `24N − 1 = 11²m`, `(m/11) = 1`,
`(m/13) = −1`. -/
theorem atkin_13_11_class (N m : ℕ) (hm : 24 * N = 11 ^ 2 * m + 1) (hQ : legendreSym 11 m = 1)
    (h13 : legendreSym 13 m = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  Atkin13.vanish_of_eigen 11 (by norm_num) 3 (by decide) eigen11 (1) (by norm_num)
    (by rw [sign11]; decide +kernel) (by norm_num) N m hm hQ h13

/-- **`13 ∣ p(17303 n + 237)`** (`17303 = 13·11³`; `m = 3432 n + 47`). -/
theorem atkin_13_11 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (17303 * n + 237)) := by
  refine atkin_13_11_class _ (3432 * n + 47) (by ring) ?_ ?_
  · rw [legendreSym.mod, show ((3432 * n + 47 : ℕ) : ℤ) % (11 : ℕ) = 3 by push_cast; omega,
      legendreSym_val 11 (by norm_num)]
    decide +kernel
  · rw [legendreSym.mod, show ((3432 * n + 47 : ℕ) : ℤ) % (13 : ℕ) = 8 by push_cast; omega,
      legendreSym_val 13 (by norm_num)]
    decide +kernel

instance fact37 : Fact (Nat.Prime 37) := ⟨by norm_num⟩

theorem sign37 : heckeSign 37 167 = 1 := by
  rw [heckeSign, legendreSym_val 37 (by norm_num), legendreSym_val 37 (by norm_num)]
  decide +kernel

theorem eigen37 : TT 37 = C 3 * Ψ 13 twPGF := eigen 37 (by norm_num) 3 (by decide)

/-- Atkin type at `Q = 37` (`μ = 3`): `13 ∣ p(N)` whenever `24N − 1 = 37²m`, `(m/37) = -1`,
`(m/13) = −1`. -/
theorem atkin_13_37_class (N m : ℕ) (hm : 24 * N = 37 ^ 2 * m + 1) (hQ : legendreSym 37 m = -1)
    (h13 : legendreSym 13 m = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  Atkin13.vanish_of_eigen 37 (by norm_num) 3 (by decide) eigen37 (-1) (by norm_num)
    (by rw [sign37]; decide +kernel) (by norm_num) N m hm hQ h13

/-- **`13 ∣ p(658489 n + 6788)`** (`658489 = 13·37³`; `m = 11544 n + 119`). -/
theorem atkin_13_37 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (658489 * n + 6788)) := by
  refine atkin_13_37_class _ (11544 * n + 119) (by ring) ?_ ?_
  · rw [legendreSym.mod, show ((11544 * n + 119 : ℕ) : ℤ) % (37 : ℕ) = 8 by push_cast; omega,
      legendreSym_val 37 (by norm_num)]
    decide +kernel
  · rw [legendreSym.mod, show ((11544 * n + 119 : ℕ) : ℤ) % (13 : ℕ) = 2 by push_cast; omega,
      legendreSym_val 13 (by norm_num)]
    decide +kernel


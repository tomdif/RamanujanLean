import RamanujanTau.AtkinTwisted.Core

/-!
# Atkin's twisted class modulo 13: primes `250 ≤ Q < 360` (generated by `scripts/atkintwisted/gen.py`)

One kernel-certified prefix of 1,804,335 partition numbers modulo 13 (`cert`) gives the 15 Sturm
coefficients of `T(Q²)F̄ − μF̄` for every prime `Q` of the list, so `F̄` is a `T(Q²)`-eigenform
with the listed `μ` (`eigen`). Atkin type (`μ = s ε Q¹⁶⁶`): `13 ∣ p(N)` when `24N − 1 = Q²m`,
`(m/Q) = ε`, `(m/13) = −1`. Ono type (`μ = 0`): `13 ∣ p(N)` when `24N − 1 = Q³n`, `Q ∤ n`,
`(Qn/13) = −1`.
-/

set_option autoImplicit false

namespace RamanujanTau.AtkinTwisted.G3
open PowerSeries BoylanWebb RamanujanTau.AtkinSporadic RamanujanTau.AtkinTwisted
open Twist13

/-- The pairs `(Q, μ)`: `T(Q²)F̄ = μF̄` modulo 13. -/
def pairs : List (ℕ × ZMod 13) := [(251, 6), (257, 6), (263, 12), (269, 1), (271, 10), (277, 6), (281, 9), (283, 6), (293, 7), (307, 9), (311, 0), (313, 2), (317, 6), (331, 11), (337, 0), (347, 12), (349, 3), (353, 9), (359, 4)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, every pair. -/
theorem cert : allOk 262132 1804335 8 5 21 4 18 43 pairs = true := by
  decide +kernel

/-- `F̄` is a `T(Q²)`-eigenform for every `Q` of the list. -/
theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (μ : ZMod 13) (hmem : (Q, μ) ∈ pairs) :
    TT Q = C μ * Ψ 13 twPGF :=
  eigen_of_allOk (kN := 21) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by decide) cert Q hQ5 μ hmem

instance fact271 : Fact (Nat.Prime 271) := ⟨by norm_num⟩

theorem sign271 : heckeSign 271 167 = 1 := by
  rw [heckeSign, legendreSym_val 271 (by norm_num), legendreSym_val 271 (by norm_num)]
  decide +kernel

theorem eigen271 : TT 271 = C 10 * Ψ 13 twPGF := eigen 271 (by norm_num) 10 (by decide)

/-- Atkin type at `Q = 271` (`μ = 10`): `13 ∣ p(N)` whenever `24N − 1 = 271²m`, `(m/271) = 1`,
`(m/13) = −1`. -/
theorem atkin_13_271_class (N m : ℕ) (hm : 24 * N = 271 ^ 2 * m + 1) (hQ : legendreSym 271 m = 1)
    (h13 : legendreSym 13 m = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  Atkin13.vanish_of_eigen 271 (by norm_num) 10 (by decide) eigen271 (1) (by norm_num)
    (by rw [sign271]; decide +kernel) (by norm_num) N m hm hQ h13

/-- **`13 ∣ p(258732643 n + 364145)`** (`258732643 = 13·271³`; `m = 84552 n + 119`). -/
theorem atkin_13_271 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (258732643 * n + 364145)) := by
  refine atkin_13_271_class _ (84552 * n + 119) (by ring) ?_ ?_
  · rw [legendreSym.mod, show ((84552 * n + 119 : ℕ) : ℤ) % (271 : ℕ) = 119 by push_cast; omega,
      legendreSym_val 271 (by norm_num)]
    decide +kernel
  · rw [legendreSym.mod, show ((84552 * n + 119 : ℕ) : ℤ) % (13 : ℕ) = 2 by push_cast; omega,
      legendreSym_val 13 (by norm_num)]
    decide +kernel

instance fact311 : Fact (Nat.Prime 311) := ⟨by norm_num⟩

theorem sign311 : heckeSign 311 167 = -1 := by
  rw [heckeSign, legendreSym_val 311 (by norm_num), legendreSym_val 311 (by norm_num)]
  decide +kernel

theorem eigen311 : TT 311 = C 0 * Ψ 13 twPGF := eigen 311 (by norm_num) 0 (by decide)

/-- Ono type at `Q = 311` (`μ = 0`): `13 ∣ p(N)` whenever `24N − 1 = 311³n`, `311 ∤ n`,
`(311n/13) = −1`. -/
theorem ono_13_311_class (N n : ℕ) (hm : 24 * N = 311 ^ 3 * n + 1) (hQn : ¬ 311 ∣ n)
    (h13 : legendreSym 13 ((311 : ℕ) * (n : ℤ)) = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  vanish_ono 311 (by norm_num) (by decide) eigen311 N n hm hQn h13

/-- **`13 ∣ p(121614373933 n + 91494036)`** (`121614373933 = 13·311⁴`; `n' = 97032 n + 73`). -/
theorem ono_13_311 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (121614373933 * n + 91494036)) := by
  refine ono_13_311_class _ (97032 * n + 73) (by ring) (by omega) ?_
  rw [legendreSym.mod, show (((311 : ℕ) : ℤ) * ((97032 * n + 73 : ℕ) : ℤ)) % (13 : ℕ) = 5 by
      push_cast; omega, legendreSym_val 13 (by norm_num)]
  decide +kernel

instance fact337 : Fact (Nat.Prime 337) := ⟨by norm_num⟩

theorem sign337 : heckeSign 337 167 = 1 := by
  rw [heckeSign, legendreSym_val 337 (by norm_num), legendreSym_val 337 (by norm_num)]
  decide +kernel

theorem eigen337 : TT 337 = C 0 * Ψ 13 twPGF := eigen 337 (by norm_num) 0 (by decide)

/-- Ono type at `Q = 337` (`μ = 0`): `13 ∣ p(N)` whenever `24N − 1 = 337³n`, `337 ∤ n`,
`(337n/13) = −1`. -/
theorem ono_13_337_class (N n : ℕ) (hm : 24 * N = 337 ^ 3 * n + 1) (hQn : ¬ 337 ∣ n)
    (h13 : legendreSym 13 ((337 : ℕ) * (n : ℤ)) = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  vanish_ono 337 (by norm_num) (by decide) eigen337 N n hm hQn h13

/-- **`13 ∣ p(167672930893 n + 74950808)`** (`167672930893 = 13·337⁴`; `n' = 105144 n + 47`). -/
theorem ono_13_337 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (167672930893 * n + 74950808)) := by
  refine ono_13_337_class _ (105144 * n + 47) (by ring) (by omega) ?_
  rw [legendreSym.mod, show (((337 : ℕ) : ℤ) * ((105144 * n + 47 : ℕ) : ℤ)) % (13 : ℕ) = 5 by
      push_cast; omega, legendreSym_val 13 (by norm_num)]
  decide +kernel

instance fact349 : Fact (Nat.Prime 349) := ⟨by norm_num⟩

theorem sign349 : heckeSign 349 167 = 1 := by
  rw [heckeSign, legendreSym_val 349 (by norm_num), legendreSym_val 349 (by norm_num)]
  decide +kernel

theorem eigen349 : TT 349 = C 3 * Ψ 13 twPGF := eigen 349 (by norm_num) 3 (by decide)

/-- Atkin type at `Q = 349` (`μ = 3`): `13 ∣ p(N)` whenever `24N − 1 = 349²m`, `(m/349) = -1`,
`(m/13) = −1`. -/
theorem atkin_13_349_class (N m : ℕ) (hm : 24 * N = 349 ^ 2 * m + 1) (hQ : legendreSym 349 m = -1)
    (h13 : legendreSym 13 m = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  Atkin13.vanish_of_eigen 349 (by norm_num) 3 (by decide) eigen349 (-1) (by norm_num)
    (by rw [sign349]; decide +kernel) (by norm_num) N m hm hQ h13

/-- **`13 ∣ p(552611137 n + 238527)`** (`552611137 = 13·349³`; `m = 108888 n + 47`). -/
theorem atkin_13_349 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (552611137 * n + 238527)) := by
  refine atkin_13_349_class _ (108888 * n + 47) (by ring) ?_ ?_
  · rw [legendreSym.mod, show ((108888 * n + 47 : ℕ) : ℤ) % (349 : ℕ) = 47 by push_cast; omega,
      legendreSym_val 349 (by norm_num)]
    decide +kernel
  · rw [legendreSym.mod, show ((108888 * n + 47 : ℕ) : ℤ) % (13 : ℕ) = 8 by push_cast; omega,
      legendreSym_val 13 (by norm_num)]
    decide +kernel

end RamanujanTau.AtkinTwisted.G3

import RamanujanTau.AtkinTwisted.Core

/-!
# Atkin's twisted class modulo 13: primes `360 ≤ Q < 500` (generated by `scripts/atkintwisted/gen.py`)

One kernel-certified prefix of 3,486,015 partition numbers modulo 13 (`cert`) gives the 15 Sturm
coefficients of `T(Q²)F̄ − μF̄` for every prime `Q` of the list, so `F̄` is a `T(Q²)`-eigenform
with the listed `μ` (`eigen`). Atkin type (`μ = s ε Q¹⁶⁶`): `13 ∣ p(N)` when `24N − 1 = Q²m`,
`(m/Q) = ε`, `(m/13) = −1`. Ono type (`μ = 0`): `13 ∣ p(N)` when `24N − 1 = Q³n`, `Q ∤ n`,
`(Qn/13) = −1`.
-/

set_option autoImplicit false

namespace RamanujanTau.AtkinTwisted.G4
open PowerSeries BoylanWebb RamanujanTau.AtkinSporadic RamanujanTau.AtkinTwisted
open Twist13

/-- The pairs `(Q, μ)`: `T(Q²)F̄ = μF̄` modulo 13. -/
def pairs : List (ℕ × ZMod 13) := [(367, 1), (373, 12), (379, 9), (383, 2), (389, 0), (397, 6), (401, 10), (409, 2), (419, 12), (421, 7), (431, 4), (433, 6), (439, 6), (443, 2), (449, 7), (457, 4), (461, 11), (463, 9), (467, 0), (479, 3), (487, 11), (491, 7), (499, 6)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, every pair. -/
theorem cert : allOk 262132 3486015 8 6 22 4 18 44 pairs = true := by
  decide +kernel

/-- `F̄` is a `T(Q²)`-eigenform for every `Q` of the list. -/
theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (μ : ZMod 13) (hmem : (Q, μ) ∈ pairs) :
    TT Q = C μ * Ψ 13 twPGF :=
  eigen_of_allOk (kN := 22) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by decide) cert Q hQ5 μ hmem

instance fact389 : Fact (Nat.Prime 389) := ⟨by norm_num⟩

theorem sign389 : heckeSign 389 167 = -1 := by
  rw [heckeSign, legendreSym_val 389 (by norm_num), legendreSym_val 389 (by norm_num)]
  decide +kernel

theorem eigen389 : TT 389 = C 0 * Ψ 13 twPGF := eigen 389 (by norm_num) 0 (by decide)

/-- Ono type at `Q = 389` (`μ = 0`): `13 ∣ p(N)` whenever `24N − 1 = 389³n`, `389 ∤ n`,
`(389n/13) = −1`. -/
theorem ono_13_389_class (N n : ℕ) (hm : 24 * N = 389 ^ 3 * n + 1) (hQn : ¬ 389 ∣ n)
    (h13 : legendreSym 13 ((389 : ℕ) * (n : ℤ)) = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  vanish_ono 389 (by norm_num) (by decide) eigen389 N n hm hQn h13

/-- **`13 ∣ p(297674585533 n + 46600563)`** (`297674585533 = 13·389⁴`; `n' = 121368 n + 19`). -/
theorem ono_13_389 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (297674585533 * n + 46600563)) := by
  refine ono_13_389_class _ (121368 * n + 19) (by ring) (by omega) ?_
  rw [legendreSym.mod, show (((389 : ℕ) : ℤ) * ((121368 * n + 19 : ℕ) : ℤ)) % (13 : ℕ) = 7 by
      push_cast; omega, legendreSym_val 13 (by norm_num)]
  decide +kernel

instance fact401 : Fact (Nat.Prime 401) := ⟨by norm_num⟩

theorem sign401 : heckeSign 401 167 = -1 := by
  rw [heckeSign, legendreSym_val 401 (by norm_num), legendreSym_val 401 (by norm_num)]
  decide +kernel

theorem eigen401 : TT 401 = C 10 * Ψ 13 twPGF := eigen 401 (by norm_num) 10 (by decide)

/-- Atkin type at `Q = 401` (`μ = 10`): `13 ∣ p(N)` whenever `24N − 1 = 401²m`, `(m/401) = -1`,
`(m/13) = −1`. -/
theorem atkin_13_401_class (N m : ℕ) (hm : 24 * N = 401 ^ 2 * m + 1) (hQ : legendreSym 401 m = -1)
    (h13 : legendreSym 13 m = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  Atkin13.vanish_of_eigen 401 (by norm_num) 10 (by decide) eigen401 (-1) (by norm_num)
    (by rw [sign401]; decide +kernel) (by norm_num) N m hm hQ h13

/-- **`13 ∣ p(838255613 n + 475703)`** (`838255613 = 13·401³`; `m = 125112 n + 71`). -/
theorem atkin_13_401 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (838255613 * n + 475703)) := by
  refine atkin_13_401_class _ (125112 * n + 71) (by ring) ?_ ?_
  · rw [legendreSym.mod, show ((125112 * n + 71 : ℕ) : ℤ) % (401 : ℕ) = 71 by push_cast; omega,
      legendreSym_val 401 (by norm_num)]
    decide +kernel
  · rw [legendreSym.mod, show ((125112 * n + 71 : ℕ) : ℤ) % (13 : ℕ) = 6 by push_cast; omega,
      legendreSym_val 13 (by norm_num)]
    decide +kernel

instance fact467 : Fact (Nat.Prime 467) := ⟨by norm_num⟩

theorem sign467 : heckeSign 467 167 = -1 := by
  rw [heckeSign, legendreSym_val 467 (by norm_num), legendreSym_val 467 (by norm_num)]

theorem eigen467 : TT 467 = C 0 * Ψ 13 twPGF := eigen 467 (by norm_num) 0 (by decide)

/-- Ono type at `Q = 467` (`μ = 0`): `13 ∣ p(N)` whenever `24N − 1 = 467³n`, `467 ∤ n`,
`(467n/13) = −1`. -/
theorem ono_13_467_class (N n : ℕ) (hm : 24 * N = 467 ^ 3 * n + 1) (hQn : ¬ 467 ∣ n)
    (h13 : legendreSym 13 ((467 : ℕ) * (n : ℤ)) = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  vanish_ono 467 (by norm_num) (by decide) eigen467 N n hm hQn h13

/-- **`13 ∣ p(618316554973 n + 157014993)`** (`618316554973 = 13·467⁴`; `n' = 145704 n + 37`). -/
theorem ono_13_467 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (618316554973 * n + 157014993)) := by
  refine ono_13_467_class _ (145704 * n + 37) (by ring) (by omega) ?_
  rw [legendreSym.mod, show (((467 : ℕ) : ℤ) * ((145704 * n + 37 : ℕ) : ℤ)) % (13 : ℕ) = 2 by
      push_cast; omega, legendreSym_val 13 (by norm_num)]
  decide +kernel

instance fact479 : Fact (Nat.Prime 479) := ⟨by norm_num⟩

theorem sign479 : heckeSign 479 167 = -1 := by
  rw [heckeSign, legendreSym_val 479 (by norm_num), legendreSym_val 479 (by norm_num)]
  decide +kernel

theorem eigen479 : TT 479 = C 3 * Ψ 13 twPGF := eigen 479 (by norm_num) 3 (by decide)

/-- Atkin type at `Q = 479` (`μ = 3`): `13 ∣ p(N)` whenever `24N − 1 = 479²m`, `(m/479) = 1`,
`(m/13) = −1`. -/
theorem atkin_13_479_class (N m : ℕ) (hm : 24 * N = 479 ^ 2 * m + 1) (hQ : legendreSym 479 m = 1)
    (h13 : legendreSym 13 m = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  Atkin13.vanish_of_eigen 479 (by norm_num) 3 (by decide) eigen479 (1) (by norm_num)
    (by rw [sign479]; decide +kernel) (by norm_num) N m hm hQ h13

/-- **`13 ∣ p(1428729107 n + 678763)`** (`1428729107 = 13·479³`; `m = 149448 n + 71`). -/
theorem atkin_13_479 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (1428729107 * n + 678763)) := by
  refine atkin_13_479_class _ (149448 * n + 71) (by ring) ?_ ?_
  · rw [legendreSym.mod, show ((149448 * n + 71 : ℕ) : ℤ) % (479 : ℕ) = 71 by push_cast; omega,
      legendreSym_val 479 (by norm_num)]
    decide +kernel
  · rw [legendreSym.mod, show ((149448 * n + 71 : ℕ) : ℤ) % (13 : ℕ) = 6 by push_cast; omega,
      legendreSym_val 13 (by norm_num)]
    decide +kernel

end RamanujanTau.AtkinTwisted.G4

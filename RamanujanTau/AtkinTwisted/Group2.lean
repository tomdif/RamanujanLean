import RamanujanTau.AtkinTwisted.Core

/-!
# Atkin's twisted class modulo 13: primes `110 ≤ Q < 250` (generated by `scripts/atkintwisted/gen.py`)

One kernel-certified prefix of 813,135 partition numbers modulo 13 (`cert`) gives the 15 Sturm
coefficients of `T(Q²)F̄ − μF̄` for every prime `Q` of the list, so `F̄` is a `T(Q²)`-eigenform
with the listed `μ` (`eigen`). Atkin type (`μ = s ε Q¹⁶⁶`): `13 ∣ p(N)` when `24N − 1 = Q²m`,
`(m/Q) = ε`, `(m/13) = −1`. Ono type (`μ = 0`): `13 ∣ p(N)` when `24N − 1 = Q³n`, `Q ∤ n`,
`(Qn/13) = −1`.
-/

set_option autoImplicit false

namespace RamanujanTau.AtkinTwisted.G2
open PowerSeries BoylanWebb RamanujanTau.AtkinSporadic RamanujanTau.AtkinTwisted
open Twist13

/-- The pairs `(Q, μ)`: `T(Q²)F̄ = μF̄` modulo 13. -/
def pairs : List (ℕ × ZMod 13) := [(113, 1), (127, 6), (131, 2), (137, 7), (139, 1), (149, 11), (151, 9), (157, 2), (163, 7), (167, 3), (173, 7), (179, 7), (181, 0), (191, 12), (193, 3), (197, 9), (199, 7), (211, 1), (223, 9), (227, 2), (229, 4), (233, 0), (239, 7), (241, 6)]

set_option maxRecDepth 100000 in
/-- **The kernel certificate**: one partition prefix, every pair. -/
theorem cert : allOk 262132 813135 8 3 20 4 18 42 pairs = true := by
  decide +kernel

/-- `F̄` is a `T(Q²)`-eigenform for every `Q` of the list. -/
theorem eigen (Q : ℕ) [Fact Q.Prime] (hQ5 : 5 ≤ Q) (μ : ZMod 13) (hmem : (Q, μ) ∈ pairs) :
    TT Q = C μ * Ψ 13 twPGF :=
  eigen_of_allOk (kN := 20) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by decide) cert Q hQ5 μ hmem

instance fact167 : Fact (Nat.Prime 167) := ⟨by norm_num⟩

theorem sign167 : heckeSign 167 167 = -1 := by
  rw [heckeSign, legendreSym_val 167 (by norm_num), legendreSym_val 167 (by norm_num)]
  decide +kernel

theorem eigen167 : TT 167 = C 3 * Ψ 13 twPGF := eigen 167 (by norm_num) 3 (by decide)

/-- Atkin type at `Q = 167` (`μ = 3`): `13 ∣ p(N)` whenever `24N − 1 = 167²m`, `(m/167) = 1`,
`(m/13) = −1`. -/
theorem atkin_13_167_class (N m : ℕ) (hm : 24 * N = 167 ^ 2 * m + 1) (hQ : legendreSym 167 m = 1)
    (h13 : legendreSym 13 m = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  Atkin13.vanish_of_eigen 167 (by norm_num) 3 (by decide) eigen167 (1) (by norm_num)
    (by rw [sign167]; decide +kernel) (by norm_num) N m hm hQ h13

/-- **`13 ∣ p(60547019 n + 54616)`** (`60547019 = 13·167³`; `m = 52104 n + 47`). -/
theorem atkin_13_167 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (60547019 * n + 54616)) := by
  refine atkin_13_167_class _ (52104 * n + 47) (by ring) ?_ ?_
  · rw [legendreSym.mod, show ((52104 * n + 47 : ℕ) : ℤ) % (167 : ℕ) = 47 by push_cast; omega,
      legendreSym_val 167 (by norm_num)]
    decide +kernel
  · rw [legendreSym.mod, show ((52104 * n + 47 : ℕ) : ℤ) % (13 : ℕ) = 8 by push_cast; omega,
      legendreSym_val 13 (by norm_num)]
    decide +kernel

instance fact181 : Fact (Nat.Prime 181) := ⟨by norm_num⟩

theorem sign181 : heckeSign 181 167 = 1 := by
  rw [heckeSign, legendreSym_val 181 (by norm_num), legendreSym_val 181 (by norm_num)]
  decide +kernel

theorem eigen181 : TT 181 = C 0 * Ψ 13 twPGF := eigen 181 (by norm_num) 0 (by decide)

/-- Ono type at `Q = 181` (`μ = 0`): `13 ∣ p(N)` whenever `24N − 1 = 181³n`, `181 ∤ n`,
`(181n/13) = −1`. -/
theorem ono_13_181_class (N n : ℕ) (hm : 24 * N = 181 ^ 3 * n + 1) (hQn : ¬ 181 ∣ n)
    (h13 : legendreSym 13 ((181 : ℕ) * (n : ℤ)) = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  vanish_ono 181 (by norm_num) (by decide) eigen181 N n hm hQn h13

/-- **`13 ∣ p(13952680573 n + 2717798)`** (`13952680573 = 13·181⁴`; `n' = 56472 n + 11`). -/
theorem ono_13_181 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (13952680573 * n + 2717798)) := by
  refine ono_13_181_class _ (56472 * n + 11) (by ring) (by omega) ?_
  rw [legendreSym.mod, show (((181 : ℕ) : ℤ) * ((56472 * n + 11 : ℕ) : ℤ)) % (13 : ℕ) = 2 by
      push_cast; omega, legendreSym_val 13 (by norm_num)]
  decide +kernel

instance fact193 : Fact (Nat.Prime 193) := ⟨by norm_num⟩

theorem sign193 : heckeSign 193 167 = 1 := by
  rw [heckeSign, legendreSym_val 193 (by norm_num), legendreSym_val 193 (by norm_num)]
  decide +kernel

theorem eigen193 : TT 193 = C 3 * Ψ 13 twPGF := eigen 193 (by norm_num) 3 (by decide)

/-- Atkin type at `Q = 193` (`μ = 3`): `13 ∣ p(N)` whenever `24N − 1 = 193²m`, `(m/193) = -1`,
`(m/13) = −1`. -/
theorem atkin_13_193_class (N m : ℕ) (hm : 24 * N = 193 ^ 2 * m + 1) (hQ : legendreSym 193 m = -1)
    (h13 : legendreSym 13 m = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  Atkin13.vanish_of_eigen 193 (by norm_num) 3 (by decide) eigen193 (-1) (by norm_num)
    (by rw [sign193]; decide +kernel) (by norm_num) N m hm hQ h13

/-- **`13 ∣ p(93457741 n + 72946)`** (`93457741 = 13·193³`; `m = 60216 n + 47`). -/
theorem atkin_13_193 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (93457741 * n + 72946)) := by
  refine atkin_13_193_class _ (60216 * n + 47) (by ring) ?_ ?_
  · rw [legendreSym.mod, show ((60216 * n + 47 : ℕ) : ℤ) % (193 : ℕ) = 47 by push_cast; omega,
      legendreSym_val 193 (by norm_num)]
    decide +kernel
  · rw [legendreSym.mod, show ((60216 * n + 47 : ℕ) : ℤ) % (13 : ℕ) = 8 by push_cast; omega,
      legendreSym_val 13 (by norm_num)]
    decide +kernel

instance fact233 : Fact (Nat.Prime 233) := ⟨by norm_num⟩

theorem sign233 : heckeSign 233 167 = -1 := by
  rw [heckeSign, legendreSym_val 233 (by norm_num), legendreSym_val 233 (by norm_num)]
  decide +kernel

theorem eigen233 : TT 233 = C 0 * Ψ 13 twPGF := eigen 233 (by norm_num) 0 (by decide)

/-- Ono type at `Q = 233` (`μ = 0`): `13 ∣ p(N)` whenever `24N − 1 = 233³n`, `233 ∤ n`,
`(233n/13) = −1`. -/
theorem ono_13_233_class (N n : ℕ) (hm : 24 * N = 233 ^ 3 * n + 1) (hQn : ¬ 233 ∣ n)
    (h13 : legendreSym 13 ((233 : ℕ) * (n : ℤ)) = -1) : 13 ∣ Fintype.card (Nat.Partition N) :=
  vanish_ono 233 (by norm_num) (by decide) eigen233 N n hm hQn h13

/-- **`13 ∣ p(38314841773 n + 3689390)`** (`38314841773 = 13·233⁴`; `n' = 72696 n + 7`). -/
theorem ono_13_233 (n : ℕ) : 13 ∣ Fintype.card (Nat.Partition (38314841773 * n + 3689390)) := by
  refine ono_13_233_class _ (72696 * n + 7) (by ring) (by omega) ?_
  rw [legendreSym.mod, show (((233 : ℕ) : ℤ) * ((72696 * n + 7 : ℕ) : ℤ)) % (13 : ℕ) = 6 by
      push_cast; omega, legendreSym_val 13 (by norm_num)]
  decide +kernel

end RamanujanTau.AtkinTwisted.G2

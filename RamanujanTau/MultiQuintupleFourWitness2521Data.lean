/-- Fuelled merge. It is structural, so the kernel can evaluate it; core `List.merge` and
`List.mergeSort` are not usable under `decide +kernel`. Only the permutation is used below. -/
def witness2521Merge : ℕ → List ℤ → List ℤ → List ℤ
  | 0, xs, ys => xs ++ ys
  | _+1, [], ys => ys
  | _+1, x::xs, [] => x::xs
  | f+1, x::xs, y::ys =>
    if x ≤ y then x :: witness2521Merge f xs (y::ys) else y :: witness2521Merge f (x::xs) ys

theorem witness2521Merge_perm (f : ℕ) (xs ys : List ℤ) :
    (witness2521Merge f xs ys).Perm (xs ++ ys) := by
  induction f generalizing xs ys with
  | zero => simp [witness2521Merge]
  | succ f ih =>
    cases xs with
    | nil => simp [witness2521Merge]
    | cons x xs =>
      cases ys with
      | nil => simp [witness2521Merge]
      | cons y ys =>
        simp only [witness2521Merge]
        split_ifs
        · exact (ih xs (y::ys)).cons x
        · exact ((ih (x::xs) ys).cons y).trans List.perm_middle.symm

def witness2521Sort : ℕ → List ℤ → List ℤ
  | 0, l => l
  | d+1, l => witness2521Merge l.length (witness2521Sort d (l.take (l.length/2)))
      (witness2521Sort d (l.drop (l.length/2)))

theorem witness2521Sort_perm (d : ℕ) (l : List ℤ) : (witness2521Sort d l).Perm l := by
  induction d generalizing l with
  | zero => exact List.Perm.refl l
  | succ d ih =>
    have h := (witness2521Merge_perm l.length (witness2521Sort d (l.take (l.length/2)))
      (witness2521Sort d (l.drop (l.length/2)))).trans ((ih _).append (ih _))
    rwa [List.take_append_drop] at h


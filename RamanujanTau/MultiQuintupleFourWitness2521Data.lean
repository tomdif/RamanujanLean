  decide +kernel

/-- All positive terms match negative terms, except one term of doubled degree 3191090. -/
theorem witness2521_signed_balance :
    witness2521Positive.Perm (3191090 :: witness2521Negative) := by
  have h1 := witness2521Sort_perm 13 witness2521Positive
  have h2 := witness2521Sort_perm 13 (3191090 :: witness2521Negative)
  rw [← witness2521_sorted_balance] at h2
  exact h1.symm.trans h2


theorem short_generation_normalized_block1
    {p : ℕ} [Fact p.Prime] (hblock : p ∈ [11, 41, 73, 109, 157, 197, 241, 283, 347, 389, 439, 487, 547, 599, 643, 691, 751, 811, 859, 919, 977, 1031, 1087, 1129, 1201]) (hp13 : p ≠ 13)
    (j k : ℕ) (hj : 1 < j) (hjk : j < k) (hkp : 2*k < p)
    (hiso : (1 : ZMod p)+(j : ZMod p)^2+(k : ZMod p)^2 = 0) :
    Submodule.span ℤ (shortSupportedDualSet p ((1,(j : ℤ)),(k : ℤ))) =
      projectiveDualLattice p ((1,(j : ℤ)),(k : ℤ)) := by
  simp only [List.mem_cons,List.not_mem_nil,or_false] at hblock
  rcases hblock with h11 | h41 | h73 | h109 | h157 | h197 | h241 | h283 | h347 | h389 | h439 | h487 | h547 | h599 | h643 | h691 | h751 | h811 | h859 | h919 | h977 | h1031 | h1087 | h1129 | h1201
